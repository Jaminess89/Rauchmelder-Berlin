---
import Container from '@/components/Container.astro';
---

<section class="bg-white py-4 border-y border-black/5" data-ps="src/components/home/TrustBanner.astro:trust-sec">
  <Container class="flex flex-wrap items-center justify-between gap-6">
    <div class="flex items-center gap-4" data-ps="src/components/home/TrustBanner.astro:seal-col">
      <a href="#bewertungen" class="flex items-center gap-3 md:justify-center justify-center md:mt-0 md:pt-0 md:pb-0 md:mb-0.5 md:pr-0 md:mr-0 rounded-none md:pl-0 md:ml-[60px] cursor-pointer hover:opacity-85 transition-opacity no-underline text-inherit" data-ps="src/components/home/TrustBanner.astro:rating-container">
        <div class="w-10 h-auto md:w-[66px]" data-ps="src/components/home/TrustBanner.astro:google-logo">
          <svg viewBox="0 0 768 755" xmlns="http://www.w3.org/2000/svg" aria-label="Google Verifizierte Bewertungen" class="w-full h-full">
            <defs>
              <filter id="s" x="-20%" y="-20%" width="140%" height="140%">
                <feDropShadow dx="2" dy="3" stdDeviation="2" flood-opacity=".32"/>
              </filter>
              <symbol id="star" viewBox="0 0 100 100">
                <polygon points="50,4 61,36 95,37 68,57 77,90 50,71 23,90 32,57 5,37 39,36"/>
              </symbol>
            </defs>
            <g fill="none" stroke-width="40">
              <path d="M384 28A356 356 0 0 0 28 384" stroke="#ff2d25"/>
              <path d="M384 28A356 356 0 0 1 740 384" stroke="#fbbc05"/>
              <path d="M740 384A356 356 0 0 1 384 740" stroke="#34a853"/>
              <path d="M384 740A356 356 0 0 1 28 384" stroke="#4285f4"/>
            </g>
            <g class="font-sans font-extrabold" font-size="118" filter="url(#s)">
              <text x="160" y="285" fill="#4285f4">G</text>
              <text x="246" y="285" fill="#ea4335">o</text>
              <text x="314" y="285" fill="#fbbc05">o</text>
              <text x="383" y="285" fill="#4285f4">g</text>
              <text x="462" y="285" fill="#34a853">l</text>
              <text x="500" y="285" fill="#ea4335">e</text>
            </g>
            <g class="font-sans font-extrabold" fill="#343434" text-anchor="middle" filter="url(#s)">
              <text x="384" y="385" font-size="75">Verifizierte</text>
              <text x="384" y="466" font-size="75">Bewertungen</text>
            </g>
            <g fill="#f8b400" filter="url(#s)">
              <use href="#star" x="165" y="505" width="72" height="72"/>
              <use href="#star" x="255" y="505" width="72" height="72"/>
              <use href="#star" x="345" y="505" width="72" height="72"/>
              <use href="#star" x="435" y="505" width="72" height="72"/>
              <use href="#star" x="525" y="505" width="72" height="72"/>
            </g>
          </svg>
        </div>
        <div class="text-black flex flex-col items-start" data-ps="src/components/home/TrustBanner.astro:rating-box">
          <span class="text-[14px] font-black uppercase tracking-wider leading-none md:text-[13px]" data-ps="src/components/home/TrustBanner.astro:label-top">AUSGEZEICHNET</span>
          <div class="flex gap-0.5 text-[#FFB400] py-1 md:pt-1" data-ps="src/components/home/TrustBanner.astro:stars-row">
            {[1, 2, 3, 4, 5].map(() => (
              <svg class="w-4 h-4 md:w-5 md:h-5 fill-current" viewBox="0 0 24 24">
                <path d="M12 2l2.4 7.2h7.6l-6 4.8 2.4 7.2-6-4.8-6 4.8 2.4-7.2-6-4.8h7.6z" />
              </svg>
            ))}
          </div>
          <span class="text-[12px] font-medium opacity-70 leading-none md:text-xs" data-ps="src/components/home/TrustBanner.astro:label-bottom">0,0 aus 0 Bewertungen</span>
        </div>
      </a>
    </div>

    <ul class="flex flex-col md:flex-row gap-4 md:gap-12 list-none p-0 m-0 text-black text-[14px] md:text-[16px] font-bold md:ml-auto" data-ps="src/components/home/TrustBanner.astro:list">
      <li class="flex items-center gap-3 tracking-tight" data-ps="src/components/home/TrustBanner.astro:item-1">
        <div class="bg-[#1AAAE6] rounded-full p-1" data-ps="src/components/home/TrustBanner.astro:icon-1">
          <svg class="w-3 h-3 text-white" fill="none" stroke="currentColor" stroke-width="3" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
        </div>
        Feste Preise
      </li>
      <li class="flex items-center gap-3 tracking-tight" data-ps="src/components/home/TrustBanner.astro:item-2">
        <div class="bg-[#1AAAE6] rounded-full p-1" data-ps="src/components/home/TrustBanner.astro:icon-2">
          <svg class="w-3 h-3 text-white" fill="none" stroke="currentColor" stroke-width="3" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
        </div>
        Saubere Installation
      </li>
      <li class="flex items-center gap-3 tracking-tight" data-ps="src/components/home/TrustBanner.astro:item-3">
        <div class="bg-[#1AAAE6] rounded-full p-1" data-ps="src/components/home/TrustBanner.astro:icon-3">
          <svg class="w-3 h-3 text-white" fill="none" stroke="currentColor" stroke-width="3" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
        </div>
        Zertifizierte Fachkräfte
      </li>
      <li class="flex items-center gap-3 tracking-tight" data-ps="src/components/home/TrustBanner.astro:item-4">
        <div class="bg-[#1AAAE6] rounded-full p-1" data-ps="src/components/home/TrustBanner.astro:icon-4">
          <svg class="w-3 h-3 text-white" fill="none" stroke="currentColor" stroke-width="3" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
        </div>
        Schnelle Reaktion
      </li>
    </ul>
  </Container>
</section>
