---
import Container from '@/components/Container.astro';
import { SITE } from '@/config/site';
---

<style>
  /* Versteckt die Scrollbar, erhält aber die Scrollfunktion */
  .no-scrollbar::-webkit-scrollbar {
    display: none;
  }
  .no-scrollbar {
    -ms-overflow-style: none;
    scrollbar-width: none;
  }

  /* MESSKLAR Logo Styles – v26 enger Rand */
  .nav-logo {
    --navy: #032b66;
    --green: #63c62f;
    --text: #1c2740;
    position: relative;
    aspect-ratio: 991 / 279;
    background: #FFFFFF;
    overflow: hidden;
  }
  .stage {
    position: absolute;
    /* enger Zuschnitt: nur ca. 10–15 px optischer Rand rund um das Logo */
    left: -5.046%;
    top: -53.047%;
    width: 100%;
    aspect-ratio: 1202 / 601;
    transform: scale(1.21292);
    transform-origin: 0 0;
    container-type: inline-size;
    background: #FFFFFF;
  }
  .detector {
    position: absolute;
    left: 5.0%;
    top: 26.3%;
    width: 21.7%;
    background: #FFFFFF;
    filter: none;
  }
  .detector svg {
    display: block;
    width: 100%;
    height: auto;
    filter: brightness(0.95);
  }
  .check {
    position: absolute;
    left: 16.8%;
    top: 34.1%;
    width: 12.8%;
    overflow: visible;
    filter: drop-shadow(0 1px 1px rgba(0, 0, 0, 0.03));
  }
  .check .mark {
    fill: url(#logo-checkGreen);
    stroke: #fff;
    stroke-width: 10;
    stroke-linejoin: round;
    paint-order: stroke fill;
  }
  .brand {
    position: absolute;
    left: 30.35%;
    top: 30.0%;
    width: max-content;
    font-family: Arial, Helvetica, sans-serif;
    text-rendering: geometricPrecision;
  }
  .wordmark {
    display: flex;
    align-items: baseline;
    width: max-content;
    white-space: nowrap;
    font-size: 10.77cqw;
    font-weight: 800;
    line-height: 1;
    letter-spacing: -0.06em;
    transform: scaleY(0.94);
    transform-origin: left top;
  }
  .wordmark .mess {
    color: var(--navy);
  }
  .wordmark .klar {
    color: var(--green);
  }

  .slogan {
    position: absolute;
    left: 0;
    top: 94.12%;
    width: 100%;
    color: #243040;
  }
  .slogan .headline {
    width: 100%;
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    column-gap: 1.35cqw;
    white-space: nowrap;
  }
  .slogan .line {
    width: 100%;
    border-top: max(1px, 0.23cqw) solid #63c62f;
  }
  .slogan .title {
    text-align: center;
    font-size: 4.17cqw;
    font-weight: 700;
    line-height: 1;
    letter-spacing: -0.02em;
    color: #253242;
  }
  .slogan .subline {
    width: 100%;
    margin-top: 0.73cqw;
    text-align: center;
    white-space: nowrap;
    font-size: 2.03cqw;
    font-weight: 400;
    line-height: 1;
    letter-spacing: 0.34em;
    color: #243040;
  }
</style>

<header id="navbar" class="sticky top-0 z-50 bg-white border-b border-border shadow-xs" data-ps="src/components/Navigation.astro:dt8k87">
  <nav class="h-[68px] flex items-center" data-ps="src/components/Navigation.astro:m59h3b">
    <Container class="flex justify-between items-center w-full !pl-2 sm:!pl-3 md:!pl-4">
      
      {/* Logo */}
      <a href="/" class="flex items-center no-underline shrink-0 mr-2 sm:mr-4 md:mr-6 py-2" aria-label="MESSKLAR Startseite" data-ps="src/components/Navigation.astro:logo-link">
        <div class="nav-logo h-[48px] sm:h-[50px] md:h-[52px] w-auto" role="img" aria-label="MESSKLAR Logo mit Rauchmelder, grünem Haken und Slogan Rauchmelderservice Installation und Wartung" data-ps="src/components/Navigation.astro:logo-container">
          <div class="stage" data-ps="src/components/Navigation.astro:logo-stage">
            <div class="detector" aria-hidden="true" data-ps="src/components/Navigation.astro:logo-detector">
              <svg viewBox="0 0 800 800">
                <defs>
                  <radialGradient id="logo-a" cx="38%" cy="13%" r="91%"><stop stop-color="#f2f2f2"/><stop offset=".43" stop-color="#eeeeee"/><stop offset=".73" stop-color="#e2e2e2"/><stop offset=".94" stop-color="#cecece"/><stop offset="1" stop-color="#bebebe"/></radialGradient>
                  <radialGradient id="logo-b" cx="45%" cy="24%" r="80%"><stop stop-color="#f2f2f2"/><stop offset=".52" stop-color="#eeeeee"/><stop offset=".82" stop-color="#dddddd"/><stop offset="1" stop-color="#c4c4c4"/></radialGradient>
                  <radialGradient id="logo-c" cx="43%" cy="22%" r="80%"><stop stop-color="#f2f2f2"/><stop offset=".67" stop-color="#eaeaea"/><stop offset="1" stop-color="#cdcdcd"/></radialGradient>
                  <linearGradient id="logo-v" x2="0" y2="1"><stop stop-color="#050505"/><stop offset=".5" stop-color="#161616"/><stop offset="1" stop-color="#020202"/></linearGradient>
                  <radialGradient id="logo-l" cx="50%" cy="40%"><stop stop-color="#f7ffaf"/><stop offset=".2" stop-color="#baff32"/><stop offset=".56" stop-color="#59cf00"/><stop offset="1" stop-color="#163f08"/></radialGradient>
                  <filter id="logo-s"><feGaussianBlur stdDeviation="10"/></filter>
                </defs>
                <path d="M82 245C82 141 221 69 400 69s318 72 318 176v171c0 137-145 241-318 241S82 553 82 416z" fill="url(#logo-a)"/>
                <path d="M99 312c59-73 169-113 301-113s242 40 301 113" fill="none" stroke="#888" stroke-width="4" opacity=".42"/>
                <path d="M103 319c63-69 170-104 297-104s234 35 297 104" fill="none" stroke="#fff" stroke-width="6" opacity=".92"/>
                <ellipse cx="400" cy="466" rx="312" ry="191" fill="url(#logo-b)"/>
                <ellipse cx="400" cy="469" rx="267" ry="145" fill="none" stroke="#bdbdbd" stroke-width="4" opacity=".27"/>
                <ellipse cx="400" cy="470" rx="250" ry="132" fill="none" stroke="url(#logo-v)" stroke-width="33"/>
                <g fill="#f1f1f1">
                  <path d="M392 329h16l4 89h-24z"/><path d="M203 383l14-10 52 65-18 13z"/><path d="M597 383l-14-10-52 65 18 13z"/><path d="M154 458l3-17 85 20-4 21z"/><path d="M646 458l-3-17-85 20 4 21z"/><path d="M222 552l-12-12 67-49 15 16z"/><path d="M578 552l12-12-67-49-15 16z"/>
                </g>
                <ellipse cx="400" cy="487" rx="215" ry="113" fill="#e4e4e4"/>
                <ellipse cx="400" cy="493" rx="169" ry="78" fill="none" stroke="url(#logo-v)" stroke-width="26"/>
                <g fill="#efefef">
                  <path d="M394 405h12l3 56h-18z"/><path d="M286 436l11-8 38 40-14 11z"/><path d="M514 436l-11-8-38 40 14 11z"/><path d="M252 493l2-13 55 11-3 16z"/><path d="M548 493l-2-13-55 11 3 16z"/>
                </g>
                <ellipse cx="400" cy="520" rx="147" ry="87" fill="url(#logo-c)" stroke="#f8f8f8" stroke-width="9"/>
                <ellipse cx="400" cy="543" rx="89" ry="54" fill="url(#logo-c)" stroke="#aaa" stroke-width="2.2"/>
                <ellipse cx="400" cy="541" rx="76" ry="44" fill="none" stroke="#fff" stroke-width="2" opacity=".74"/>
                <rect x="357" y="323" width="86" height="31" rx="16" fill="#ededed" stroke="#777" stroke-width="3"/>
                <rect x="363" y="329" width="74" height="19" rx="10" fill="url(#logo-l)"/>
                <ellipse cx="400" cy="333" rx="24" ry="4.3" fill="#fff" opacity=".66"/>
                <path d="M119 409c40-84 142-139 281-139s241 55 281 139" fill="none" stroke="#fff" stroke-width="15" opacity=".13"/>
              </svg>
            </div>

            <svg class="check" viewBox="0 0 300 320" aria-hidden="true" data-ps="src/components/Navigation.astro:logo-check">
              <defs>
                <linearGradient id="logo-checkGreen" x1="0" y1="1" x2="1" y2="0">
                  <stop offset="0" stop-color="#58bd27"/>
                  <stop offset=".56" stop-color="#5fc52a"/>
                  <stop offset="1" stop-color="#4eb820"/>
                </linearGradient>
              </defs>
              <path class="mark" d="M23 208C18 204 12 206 9 211C6 217 8 224 13 229L89 299C94 304 101 307 108 306C114 305 119 301 123 295L291 25C296 17 295 10 289 7C284 4 278 6 273 12L101 244C98 249 94 252 89 253C84 254 79 252 74 248Z"/>
            </svg>

            <div class="brand" aria-hidden="true" data-ps="src/components/Navigation.astro:logo-brand">
              <div class="wordmark" data-ps="src/components/Navigation.astro:logo-wordmark">
                <span class="mess" data-ps="src/components/Navigation.astro:i2om6e">MESS</span><span class="klar" data-ps="src/components/Navigation.astro:i2om6f">KLAR</span>
              </div>

              <div class="slogan" data-ps="src/components/Navigation.astro:logo-slogan">
                <div class="headline" data-ps="src/components/Navigation.astro:logo-headline">
                  <span class="line" data-ps="src/components/Navigation.astro:i2om6g"></span>
                  <span class="title" data-ps="src/components/Navigation.astro:i2om6h">Rauchmelderservice</span>
                  <span class="line" data-ps="src/components/Navigation.astro:i2om6i"></span>
                </div>
                <div class="subline" data-ps="src/components/Navigation.astro:logo-subline">INSTALLATION &amp; WARTUNG</div>
              </div>
            </div>
          </div>
        </div>
      </a>

      {/* Menu items: Single row, swipeable on mobile */}
      <div class="flex items-center overflow-x-auto no-scrollbar scroll-smooth whitespace-nowrap py-1 px-1 shrink min-w-0 w-full md:w-auto justify-between sm:justify-around md:justify-start" data-ps="src/components/Navigation.astro:gqvsdc">
        <div class="flex flex-nowrap gap-1.5 sm:gap-3 md:gap-5 lg:gap-7 items-center text-[12px] sm:text-[13px] lg:text-[14px]" data-ps="src/components/Navigation.astro:gqvsde">
          <a href="/#service" class="px-2.5 py-1 font-bold text-secondary uppercase no-underline hover:text-[#1AAAE6] transition-colors shrink-0 whitespace-nowrap" data-ps="src/components/Navigation.astro:nav-link-services">Leistungen</a>
          <a href="/#nachweis" class="px-2.5 py-1 font-bold text-secondary uppercase no-underline hover:text-[#1AAAE6] transition-colors shrink-0 whitespace-nowrap" data-ps="src/components/Navigation.astro:nav-link-duties">Melder-Nachweis</a>
          <a href="/#koordination" class="px-2.5 py-1 font-bold text-secondary uppercase no-underline hover:text-[#1AAAE6] transition-colors shrink-0 whitespace-nowrap" data-ps="src/components/Navigation.astro:nav-link-appointments">Mietertermine</a>
          <a href="/#einsatzgebiet" class="px-2.5 py-1 font-bold text-secondary uppercase no-underline hover:text-[#1AAAE6] transition-colors shrink-0 whitespace-nowrap" data-ps="src/components/Navigation.astro:nav-link-districts">Bezirke</a>
        </div>
      </div>

      {/* Buttons: Hidden on mobile (md breakpoint = tablet and up) */}
      <div class="hidden md:flex items-center gap-2 lg:gap-4 shrink-0 pl-3 lg:pl-6" data-ps="src/components/Navigation.astro:cta-container">
        <a 
          href="/#ersteinschaetzung" 
          class="bg-[#25b94b] hover:bg-[#20a340] text-white text-[14px] md:text-[15px] font-bold px-4 py-2.5 rounded-[9px] no-underline transition-all shadow-sm"
          data-ps="src/components/Navigation.astro:green-btn">Kosten-Check</a>
        <a 
          href="tel:+493092105026" 
          class="flex items-center gap-2 bg-[#1AAAE6] hover:bg-[#1AAAE6]/90 text-white text-[14px] md:text-[15px] font-bold px-3 py-2 md:px-4 md:py-2.5 rounded-[9px] no-underline transition-all shadow-sm"
          data-ps="src/components/Navigation.astro:phone-cta"
        >
          <span class="whitespace-nowrap" data-ps="src/components/Navigation.astro:i2om6i">030 9210 5026</span>
        </a>
      </div>

    </Container>
  </nav>
</header>
