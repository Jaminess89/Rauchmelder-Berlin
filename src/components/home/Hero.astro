---
import Container from '@/components/Container.astro';
---

<section class="relative bg-[#ECF0F1] overflow-hidden" data-ps="src/components/home/Hero.astro:hero-sec">
  <Container class="relative z-10 pt-8 pb-10 sm:pt-12 sm:pb-14 md:pt-[55px] md:pb-[75px]">
    <div class="w-full md:w-1/2 text-left md:pr-12 md:pl-0" data-ps="src/components/home/Hero.astro:text-col">
      <h1 class="text-[26px] sm:text-[32px] md:text-[34px] lg:text-[40px] font-black text-secondary leading-[1.15] mb-5 tracking-tight" data-ps="src/components/home/Hero.astro:h1">Rauchmelder Service für Berlin & Brandenburg</h1>
      <div class="flex flex-col gap-3.5 mb-8 w-full max-w-lg" data-ps="src/components/home/Hero.astro:usp-list">
        <div class="flex items-start gap-3 text-[16px] sm:text-[18px] font-bold text-secondary text-left" data-ps="src/components/home/Hero.astro:time">
          <svg class="w-5 h-5 sm:w-6 sm:h-6 text-[#1AAAE6] shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"></path>
          </svg>
          <span data-ps="src/components/home/Hero.astro:3f6ipf">Installation & Wartung nach DIN 14676</span>
        </div>
        <div class="flex items-start gap-3 text-[16px] sm:text-[18px] font-bold text-secondary text-left" data-ps="src/components/home/Hero.astro:usp-2">
          <svg class="w-5 h-5 sm:w-6 sm:h-6 text-[#1AAAE6] shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"></path>
          </svg>
          <span data-ps="src/components/home/Hero.astro:3f6ipe">Lückenlose digitale Dokumentation</span>
        </div>
        <div class="flex items-start gap-3 text-[16px] sm:text-[18px] font-bold text-secondary text-left" data-ps="src/components/home/Hero.astro:usp-3">
          <svg class="w-5 h-5 sm:w-6 sm:h-6 text-[#1AAAE6] shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"></path>
          </svg>
          <span data-ps="src/components/home/Hero.astro:3f6ipd">Austausch nur, wenn wirklich nötig</span>
        </div>
        <div class="flex items-start gap-3 text-[16px] sm:text-[18px] font-bold text-secondary text-left" data-ps="src/components/home/Hero.astro:usp-4">
          <svg class="w-5 h-5 sm:w-6 sm:h-6 text-[#1AAAE6] shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"></path>
          </svg>
          <span data-ps="src/components/home/Hero.astro:3f6ipc">Haftungsrisiken reduzieren</span>
        </div>
        <div class="flex items-start gap-3 text-[16px] sm:text-[18px] font-bold text-secondary text-left" data-ps="src/components/home/Hero.astro:usp-5">
          <svg class="w-5 h-5 sm:w-6 sm:h-6 text-[#1AAAE6] shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"></path>
          </svg>
          <span data-ps="src/components/home/Hero.astro:3f6ipc">Kostenumlage möglich <a href="#kosten" class="text-[#1AAAE6] hover:text-[#1288b8] font-bold underline transition-colors text-[14px] sm:text-[15px] ml-1" data-ps="src/components/home/Hero.astro:cost-details-link">Details ansehen</a></span>
        </div>
      </div>

      <div class="mb-7" data-ps="src/components/home/Hero.astro:cta-wrap">
        <a 
          href="#ersteinschaetzung" 
          class="inline-flex items-center justify-center gap-3 bg-[#81CD35] hover:bg-[#81CD35]/90 text-white text-[17px] sm:text-[18px] font-bold px-[20px] py-[14px] rounded-[10px] no-underline transition-all shadow-lg hover:shadow-xl w-full sm:w-auto"
          data-ps="src/components/home/Hero.astro:cta"
        >
          <span class="text-[18px] sm:text-[20px]" data-ps="src/components/home/Hero.astro:3f6ipg">Kosten-Check starten →</span>
        </a>
        <div class="mt-2.5 text-xs sm:text-sm text-[#53627D] font-medium" data-ps="src/components/home/Hero.astro:trust-line">
          60 Sekunden · kostenlos · unverbindlich
        </div>
        <div class="mt-1.5 text-xs sm:text-sm text-[#53627D] font-medium" data-ps="src/components/home/Hero.astro:phone-alt">
          Oder direkt anrufen: <a href="tel:+493092105026" class="text-[#133A6B] hover:text-[#25b94b] font-bold transition-colors" data-ps="src/components/home/Hero.astro:iblyyh">030 9210 5026</a>
        </div>
      </div>
    </div>
  </Container>

  <div class="w-full md:w-1/2 md:absolute md:inset-y-0 md:right-0" data-ps="src/components/home/Hero.astro:img-col">
    <div class="relative h-full w-full [mask-image:linear-gradient(to_bottom,transparent,#3F789E_15%)] md:[mask-image:linear-gradient(to_right,transparent,#3F789E_20%)]" data-ps="src/components/home/Hero.astro:img-frame">
      <img 
        src="https://pagesmith-cdn.com/2be62e80/images/Rauchmelder-Service-Wartung-&-Installation-Bild-1536-1536.webp" 
        srcset="https://pagesmith-cdn.com/2be62e80/images/Rauchmelder-Service-Wartung-&-Installation-Bild-1536-640.webp 640w, https://pagesmith-cdn.com/2be62e80/images/Rauchmelder-Service-Wartung-&-Installation-Bild-1536-768.webp 768w, https://pagesmith-cdn.com/2be62e80/images/Rauchmelder-Service-Wartung-&-Installation-Bild-1536-1024.webp 1024w, https://pagesmith-cdn.com/2be62e80/images/Rauchmelder-Service-Wartung-&-Installation-Bild-1536-1536.webp 1536w"
        sizes="(max-width: 768px) 100vw, 50vw"
        alt="Rauchmelderservice Berlin & Brandenburg – Installation & Wartung" 
        class="w-full h-full object-cover object-top min-h-[320px] sm:min-h-[380px] md:min-h-0"
        loading="eager"
        fetchpriority="high" data-ps="src/components/home/Hero.astro:fibi7x" />
    </div>
  </div>
</section>
