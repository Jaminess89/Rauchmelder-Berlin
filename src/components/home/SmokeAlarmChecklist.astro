---
import Container from '@/components/Container.astro';
---

<section class="py-16 md:py-24 bg-[#FFFFFF] relative overflow-hidden md:pt-[45px] md:pb-[45px]" data-ps="src/components/home/SmokeAlarmChecklist.astro:section">
  <!-- Sichtbares Hintergrundbild im milchig-weißen Look -->
  <div class="absolute inset-0 pointer-events-none overflow-hidden z-0" aria-hidden="true" data-ps="src/components/home/SmokeAlarmChecklist.astro:klshq9">
    <img 
      src="https://pagesmith-cdn.com/2be62e80/images/Zusatz-Services-point3d-commercial-imaging-ltd-0BTn_jX0roU-unsplash-Kopie-2-768-768-320-320.webp"
      alt=""
      class="w-full h-full object-cover object-center scale-105 filter blur-[0.5px]"
      loading="lazy" data-ps="src/components/home/SmokeAlarmChecklist.astro:99ggx0" />
    <!-- Semi-transparenter Milchglas- / Weißfilter -->
    <div class="absolute inset-0 bg-white/75 backdrop-blur-[1.5px]" data-ps="src/components/home/SmokeAlarmChecklist.astro:klshqa"></div>
    <!-- Verlauf nach Vollweiß am unteren Ende -->
    <div class="absolute inset-x-0 bottom-0 h-44 bg-gradient-to-t from-white via-white/80 to-transparent" data-ps="src/components/home/SmokeAlarmChecklist.astro:bottom-fade"></div>
  </div>

  <Container class="relative z-10">
    <div class="mb-12 md:mb-16" data-ps="src/components/home/SmokeAlarmChecklist.astro:header-wrap">
      <div class="max-w-3xl" data-ps="src/components/home/SmokeAlarmChecklist.astro:header">
        <div class="inline-flex items-center gap-2.5 mb-6 px-4 py-1.5 bg-red-50 rounded-full border border-red-100/50" data-ps="src/components/home/SmokeAlarmChecklist.astro:badge">
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="text-red-600 shrink-0"><path d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3Z"/><path d="M12 9v4"/><path d="M12 17h.01"/></svg>
          <span class="text-red-600 font-extrabold text-[13px] tracking-[0.05em] uppercase" data-ps="src/components/home/SmokeAlarmChecklist.astro:badge-text">häufigeR Irrtum von Vermietern</span>
        </div>
        <h2 class="text-2xl sm:text-3xl font-black text-[#111827] leading-[1.1] mb-6 md:text-[35px]" data-ps="src/components/home/SmokeAlarmChecklist.astro:title">Sind Ihre Rauchmelder wirklich in Ordnung?</h2>
        <p class="text-lg md:text-xl text-gray-600 leading-relaxed" data-ps="src/components/home/SmokeAlarmChecklist.astro:intro">Wir prüfen 4 entscheidende Punkte:
<br/>vollständig, richtig montiert, funktionsfähig und Austauschfrist gültig.</p>
      </div>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-2 gap-5 sm:gap-6 lg:gap-8 md:mt-0" data-ps="src/components/home/SmokeAlarmChecklist.astro:grid">
      
      <!-- Card 1: Räume -->
      <div class="bg-white rounded-2xl sm:rounded-3xl lg:rounded-[2rem] p-3.5 xs:p-4 sm:p-6 lg:p-7 border border-gray-100 shadow-sm hover:shadow-md transition-shadow flex flex-row items-center gap-3.5 sm:gap-5 lg:gap-6 relative overflow-hidden" data-ps="src/components/home/SmokeAlarmChecklist.astro:card1">
        <div class="relative w-24 xs:w-28 sm:w-40 md:w-48 lg:w-44 xl:w-48 shrink-0 aspect-square rounded-xl sm:rounded-2xl overflow-hidden border border-gray-100 bg-[#f8fafb] flex items-center justify-center p-1 sm:p-2 shadow-inner" data-ps="src/components/home/SmokeAlarmChecklist.astro:img-box1">
          <div class="absolute top-1.5 left-1.5 sm:top-2.5 sm:left-2.5 w-6 h-6 sm:w-8 sm:h-8 rounded-full bg-[#111827] flex items-center justify-center text-white font-black text-xs sm:text-base z-10 shadow-xs" data-ps="src/components/home/SmokeAlarmChecklist.astro:num1">1</div>
          <svg 
            viewBox="0 0 1000 1030" 
            xmlns="http://www.w3.org/2000/svg" 
            class="w-full h-full object-contain select-none" 
            aria-label="Wohnungsgrundriss"
            data-ps="src/components/home/SmokeAlarmChecklist.astro:img1"
          >
            <defs>
              <linearGradient id="badGradient" x1="0" y1="0" x2="1" y2="1">
                <stop offset="0" stop-color="#fffafb"/>
                <stop offset=".5" stop-color="#fff0f2"/>
                <stop offset="1" stop-color="#ffdfe2"/>
              </linearGradient>
              <radialGradient id="xGradient" cx="35%" cy="28%" r="80%">
                <stop offset="0" stop-color="#ff2028"/>
                <stop offset=".6" stop-color="#ef060f"/>
                <stop offset="1" stop-color="#d90009"/>
              </radialGradient>
              <pattern id="badPattern" width="18" height="18" patternUnits="userSpaceOnUse" patternTransform="rotate(45)">
                <line x1="0" y1="0" x2="0" y2="18" stroke="#e51f2a" stroke-opacity=".07" stroke-width="3"/>
              </pattern>
            </defs>

            <!-- Background -->
            <rect width="1000" height="1030" fill="#ffffff" rx="16" />

            <!-- Bad / markierter Raum unten links -->
            <rect x="45" y="530" width="345" height="455" fill="url(#badGradient)"/>
            <rect x="45" y="530" width="345" height="455" fill="url(#badPattern)"/>
            <rect x="45" y="530" width="345" height="455" fill="none" stroke="#e51f2a" stroke-width="4"/>

            <!-- Außenwände -->
            <path stroke="#454a4f" stroke-width="10" stroke-linecap="square" fill="none" d="M35 35H965 M35 35V995 M965 35V995 M35 995H500 M580 995H965"/>

            <!-- Wand zwischen Schlafen und Wohnen oben geschlossen -->
            <path stroke="#454a4f" stroke-width="10" stroke-linecap="square" fill="none" d="M400 35V520"/>

            <!-- Wohnen oben / Kind -->
            <path stroke="#454a4f" stroke-width="10" stroke-linecap="square" fill="none" d="M690 35V400 M690 480V520"/>

            <!-- Unterkanten obere Räume -->
            <path stroke="#454a4f" stroke-width="10" stroke-linecap="square" fill="none" d="M35 520H255 M330 520H400"/>
            <path stroke="#454a4f" stroke-width="10" stroke-linecap="square" fill="none" d="M400 520H500 M575 520H690"/>
            <path stroke="#454a4f" stroke-width="10" stroke-linecap="square" fill="none" d="M690 520H770 M850 520H965"/>

            <!-- Wand unteres Wohnen / Flur -->
            <path stroke="#454a4f" stroke-width="10" stroke-linecap="square" fill="none" d="M400 520V610 M400 690V995"/>

            <!-- Bad -->
            <path stroke="#454a4f" stroke-width="10" stroke-linecap="square" fill="none" d="M690 650H720 M800 650H965"/>
            <path stroke="#454a4f" stroke-width="10" stroke-linecap="square" fill="none" d="M690 650V995"/>

            <!-- Fenster -->
            <path stroke="#a8adb2" stroke-width="10" stroke-linecap="butt" fill="none" d="M160 35H300 M480 35H620 M790 35H910"/>
            <path stroke="#a8adb2" stroke-width="10" stroke-linecap="butt" fill="none" d="M35 210V350 M35 735V865"/>
            <path stroke="#a8adb2" stroke-width="10" stroke-linecap="butt" fill="none" d="M965 210V350 M965 735V865"/>
            <path stroke="#a8adb2" stroke-width="10" stroke-linecap="butt" fill="none" d="M160 995H295 M805 995H915"/>

            <!-- dezente Glasdetails -->
            <path stroke="#d9dde0" stroke-width="2" fill="none" d="M160 31H300 M480 31H620 M790 31H910"/>
            <path stroke="#d9dde0" stroke-width="2" fill="none" d="M31 210V350 M31 735V865"/>
            <path stroke="#d9dde0" stroke-width="2" fill="none" d="M969 210V350 M969 735V865"/>
            <path stroke="#d9dde0" stroke-width="2" fill="none" d="M160 999H295 M805 999H915"/>

            <!-- Türen -->
            <path stroke="#4f555a" stroke-width="3.2" fill="none" stroke-linecap="round" d="M255 520V445"/>
            <path stroke="#8d9398" stroke-width="2.25" fill="none" d="M330 520 A75 75 0 0 0 255 445"/>

            <path stroke="#4f555a" stroke-width="3.2" fill="none" stroke-linecap="round" d="M500 520V445"/>
            <path stroke="#8d9398" stroke-width="2.25" fill="none" d="M575 520 A75 75 0 0 0 500 445"/>

            <path stroke="#4f555a" stroke-width="3.2" fill="none" stroke-linecap="round" d="M690 480H765"/>
            <path stroke="#8d9398" stroke-width="2.25" fill="none" d="M690 405 A75 75 0 0 1 765 480"/>

            <path stroke="#4f555a" stroke-width="3.2" fill="none" stroke-linecap="round" d="M400 610H325"/>
            <path stroke="#8d9398" stroke-width="2.25" fill="none" d="M400 685 A75 75 0 0 1 325 610"/>

            <path stroke="#4f555a" stroke-width="3.2" fill="none" stroke-linecap="round" d="M720 650V725"/>
            <path stroke="#8d9398" stroke-width="2.25" fill="none" d="M795 650 A75 75 0 0 1 720 725"/>

            <path stroke="#4f555a" stroke-width="3.2" fill="none" stroke-linecap="round" d="M500 995V920"/>
            <path stroke="#8d9398" stroke-width="2.25" fill="none" d="M575 995 A75 75 0 0 0 500 920"/>

            <!-- Beschriftungen -->
            <text x="215" y="290" font-family="system-ui, -apple-system, sans-serif" font-weight="700" font-size="42" fill="#111111" text-anchor="middle" dominant-baseline="middle" letter-spacing="-1.35px">Schlafen</text>
            <text x="545" y="290" font-family="system-ui, -apple-system, sans-serif" font-weight="700" font-size="42" fill="#111111" text-anchor="middle" dominant-baseline="middle" letter-spacing="-1.35px">Wohnen</text>
            <text x="835" y="290" font-family="system-ui, -apple-system, sans-serif" font-weight="700" font-size="42" fill="#111111" text-anchor="middle" dominant-baseline="middle" letter-spacing="-1.35px">Kind</text>
            <text x="220" y="770" font-family="system-ui, -apple-system, sans-serif" font-weight="800" font-size="40" fill="#b90f18" text-anchor="middle" dominant-baseline="middle" letter-spacing="-1px">Wohnen</text>
            <text x="545" y="730" font-family="system-ui, -apple-system, sans-serif" font-weight="700" font-size="42" fill="#111111" text-anchor="middle" dominant-baseline="middle" letter-spacing="-1.35px">Flur</text>
            <text x="835" y="825" font-family="system-ui, -apple-system, sans-serif" font-weight="700" font-size="42" fill="#111111" text-anchor="middle" dominant-baseline="middle" letter-spacing="-1.35px">Bad</text>

            <!-- rotes X -->
            <g transform="translate(875, 620)">
              <circle r="78" fill="url(#xGradient)" stroke="#c40009" stroke-width="2.4" style="filter: drop-shadow(0 10px 15px rgba(181,0,8,0.24));" />
              <ellipse cx="-20" cy="-27" rx="38" ry="20" fill="rgba(255,255,255,0.14)" transform="rotate(-26)" />
              <path d="M-27 -27 L27 27 M27 -27 L-27 27" stroke="#ffffff" stroke-width="14" stroke-linecap="square" />
            </g>
          </svg>
        </div>
        <div class="flex flex-col justify-center flex-1 min-w-0" data-ps="src/components/home/SmokeAlarmChecklist.astro:content1">
          <div data-ps="src/components/home/SmokeAlarmChecklist.astro:klshq7">
            <h3 class="text-sm xs:text-base sm:text-lg md:text-xl font-black text-[#111827] mb-1.5 sm:mb-2.5 leading-snug" data-ps="src/components/home/SmokeAlarmChecklist.astro:h3-1">Sind alle Räume ausgestattet?</h3>
            <ul class="space-y-1 sm:space-y-1.5 text-xs xs:text-sm md:text-base text-gray-600 leading-snug">
              <li class="flex items-center gap-1.5 sm:gap-2" data-ps="src/components/home/SmokeAlarmChecklist.astro:m6f318">
                <span class="w-1.5 h-1.5 rounded-full bg-[#5BA81B] shrink-0" data-ps="src/components/home/SmokeAlarmChecklist.astro:enuckl"></span>
                <span data-ps="src/components/home/SmokeAlarmChecklist.astro:enuckm">Aufenthaltsräume prüfen</span>
              </li>
              <li class="flex items-center gap-1.5 sm:gap-2" data-ps="src/components/home/SmokeAlarmChecklist.astro:m6f317">
                <span class="w-1.5 h-1.5 rounded-full bg-[#5BA81B] shrink-0" data-ps="src/components/home/SmokeAlarmChecklist.astro:enuckn"></span>
                <span data-ps="src/components/home/SmokeAlarmChecklist.astro:enucko">Rettungswege berücksichtigen</span>
              </li>
              <li class="flex items-center gap-1.5 sm:gap-2" data-ps="src/components/home/SmokeAlarmChecklist.astro:m6f316">
                <span class="w-1.5 h-1.5 rounded-full bg-[#5BA81B] shrink-0" data-ps="src/components/home/SmokeAlarmChecklist.astro:enucla"></span>
                <span data-ps="src/components/home/SmokeAlarmChecklist.astro:enuclb">Fehlende Melder erkennen</span>
              </li>
            </ul>
          </div>
        </div>
      </div>

      <!-- Card 2: Montage -->
      <div class="bg-white rounded-2xl sm:rounded-3xl lg:rounded-[2rem] p-3.5 xs:p-4 sm:p-6 lg:p-7 border border-gray-100 shadow-sm hover:shadow-md transition-shadow flex flex-row items-center gap-3.5 sm:gap-5 lg:gap-6 relative overflow-hidden" data-ps="src/components/home/SmokeAlarmChecklist.astro:card2">
        <div class="relative w-24 xs:w-28 sm:w-40 md:w-48 lg:w-44 xl:w-48 shrink-0 aspect-square rounded-xl sm:rounded-2xl overflow-hidden border border-gray-100 bg-gray-50/80 flex items-center justify-center p-1.5 sm:p-2.5" data-ps="src/components/home/SmokeAlarmChecklist.astro:img-box2">
          <div class="absolute top-1.5 left-1.5 sm:top-2.5 sm:left-2.5 w-6 h-6 sm:w-8 sm:h-8 rounded-full bg-[#111827] flex items-center justify-center text-white font-black text-xs sm:text-base z-10 shadow-xs" data-ps="src/components/home/SmokeAlarmChecklist.astro:num2">2</div>
          <svg viewBox="0 0 1024 900" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="Rauchmelder mit mindestens 50 Zentimeter Abstand zu Leuchten und Hindernissen" class="w-full h-full object-contain select-none" data-ps="src/components/home/SmokeAlarmChecklist.astro:img2">
            <defs>
              <linearGradient id="card-cl" x1="0" y1="0" x2="0" y2="1"><stop stop-color="#f7f6f3"/><stop offset="1" stop-color="#ecebe8"/></linearGradient>
              <linearGradient id="metal-cl" x1="0" x2="1"><stop stop-color="#6a6a68"/><stop offset=".16" stop-color="#c6c6c4"/><stop offset=".42" stop-color="#979794"/><stop offset=".68" stop-color="#c4c4c2"/><stop offset="1" stop-color="#646462"/></linearGradient>
              <radialGradient id="white-cl" cx="38%" cy="20%" r="90%"><stop stop-color="#cccccc"/><stop offset=".58" stop-color="#c5c5c3"/><stop offset="1" stop-color="#adadaa"/></radialGradient>
              <linearGradient id="side-cl" x1="0" y1="0" x2="0" y2="1"><stop stop-color="#c6c6c5"/><stop offset=".34" stop-color="#ababab"/><stop offset=".58" stop-color="#cccccc"/><stop offset="1" stop-color="#ababab"/></linearGradient>
              <radialGradient id="shade-cl" cx="50%" cy="18%" r="90%"><stop stop-color="#cccccc"/><stop offset=".67" stop-color="#bebebc"/><stop offset="1" stop-color="#a5a5a1"/></radialGradient>
              <linearGradient id="red-cl" x1="0" y1="0" x2="0" y2="1"><stop stop-color="#ff3d31"/><stop offset="1" stop-color="#ef241b"/></linearGradient>
              <linearGradient id="green-cl" x1="0" y1="0" x2="0" y2="1"><stop stop-color="#69ad4c"/><stop offset="1" stop-color="#489a35"/></linearGradient>
              <filter id="shadow-cl" x="-50%" y="-50%" width="200%" height="200%"><feDropShadow dx="0" dy="10" stdDeviation="12" flood-opacity=".18"/></filter>
              <filter id="soft-cl" x="-50%" y="-50%" width="200%" height="200%"><feGaussianBlur stdDeviation="11"/></filter>
              <filter id="icon-cl" x="-40%" y="-40%" width="180%" height="180%"><feDropShadow dx="0" dy="4" stdDeviation="4" flood-opacity=".20"/></filter>

              <linearGradient id="beamFront-cl" x1="0" y1="0" x2="1" y2="1"><stop stop-color="#a7a5a2"/><stop offset=".45" stop-color="#9d9a97"/><stop offset="1" stop-color="#b0aeab"/></linearGradient>
              <linearGradient id="beamUnder-cl" x1="0" y1="0" x2="1" y2="1"><stop stop-color="#7e7a76"/><stop offset=".55" stop-color="#6d6965"/><stop offset="1" stop-color="#8b8884"/></linearGradient>
              <linearGradient id="cornerSoft-cl" x1="0" y1="0" x2="1" y2="0"><stop stop-color="#d3d3d0"/><stop offset=".55" stop-color="#dfdfdc"/><stop offset="1" stop-color="#e9e9e7" stop-opacity="0"/></linearGradient>
            </defs>
            <!-- cards -->
            <rect x="18" y="18" width="488" height="864" rx="28" fill="url(#card-cl)"/>
            <rect x="518" y="18" width="488" height="864" rx="28" fill="url(#card-cl)"/>
            <!-- LEFT ROOM: beam reaches the left wall; no hard vertical seam below it -->
            <clipPath id="leftClip-cl"><rect x="18" y="18" width="488" height="864" rx="28"/></clipPath>
            <g clip-path="url(#leftClip-cl)">
              <!-- ceiling above the beam -->
              <rect x="18" y="18" width="488" height="370" fill="#f2f1ee"/>

              <!-- wall below the beam; no hard vertical seam -->
              <path d="M18 347L52 388H506V882H18Z" fill="#e9e9e7"/>
              <!-- broad soft shading suggests the wall corner without drawing a line -->
              <rect x="18" y="388" width="82" height="494" fill="url(#cornerSoft-cl)" opacity=".62"/>

              <!-- projecting beam / soffit, now visible all the way to the left wall -->
              <g>
                <!-- large grey front face -->
                <path d="M18 228L148 309L148 388L18 323Z" fill="url(#beamFront-cl)"/>

                <!-- dark underside -->
                <path d="M18 323L148 388L52 388L18 367Z" fill="url(#beamUnder-cl)"/>

                <!-- narrow right end face -->
                <path d="M148 309L148 388L153 384L153 313Z" fill="#989591"/>

                <!-- material edges only on the beam itself -->
                <path d="M18 228L148 309" fill="none" stroke="#e2e0dd" stroke-width="1.7" opacity=".94"/>
                <path d="M18 323L148 388" fill="none" stroke="#bdbab7" stroke-width="1.15" opacity=".74"/>
                <path d="M52 388H148" fill="none" stroke="#66625f" stroke-width="1.05" opacity=".26"/>
              </g>

              <!-- soft contact shadow; no vertical line continues downward -->
              <path d="M52 389H157V424H52Z" fill="#595654" opacity=".055" filter="url(#soft-cl)"/>
            </g>
            <ellipse cx="239" cy="178" rx="95" ry="24" fill="#000" opacity=".12" filter="url(#soft-cl)"/>
            <!-- left detector -->
            <g filter="url(#shadow-cl)">
              <ellipse cx="239" cy="146" rx="80" ry="29" fill="url(#white-cl)" stroke="#b9b9b6" stroke-width="1.3"/>
              <path d="M159 147c0-12 36-21 80-21s80 9 80 21v42c0 19-36 33-80 33s-80-14-80-33z" fill="url(#side-cl)"/>
              <path d="M163 159c33-15 119-15 152 0v19c-33-14-119-14-152 0z" fill="#bfbfbd" stroke="#a0a09d"/>
              <g stroke="#272727" stroke-width="4.2" stroke-linecap="round"><path d="M174 160v15M185 156v16M197 153v17M210 151v17M224 149v17M239 148v17M254 148v17M269 149v17M283 151v17M296 154v17M307 158v16"/></g>
              <ellipse cx="239" cy="191" rx="25" ry="10.5" fill="#c6c6c4" stroke="#6c6c69" stroke-width="2"/>
              <ellipse cx="239" cy="190" rx="18" ry="7" fill="url(#white-cl)"/>
              <circle cx="281" cy="184" r="3.1" fill="#ef2d25"/>
              <path d="M183 206c20 8 39 11 56 11s37-3 57-11" fill="none" stroke="#d5d5d5" opacity=".7" stroke-width="2"/>
            </g>
            <!-- lamp -->
            <g filter="url(#shadow-cl)">
              <ellipse cx="344" cy="143" rx="32" ry="14" fill="url(#metal-cl)"/>
              <path d="M312 143q32 16 64 0v20q-32 17-64 0z" fill="url(#metal-cl)"/>
              <rect x="338" y="160" width="12" height="143" rx="5" fill="url(#metal-cl)"/>
              <path d="M314 302c5-24 13-32 30-32s25 8 30 32l4 24c34 34 66 88 84 149 4 14-3 23-15 28-27 10-62 16-103 16s-77-6-104-16c-12-5-19-14-15-28 18-61 50-115 84-149z" fill="url(#shade-cl)" stroke="#a0a09d" stroke-width="1.2"/>
              <ellipse cx="344" cy="493" rx="119" ry="29" fill="#c8c8c6" stroke="#a5a5a2"/>
              <ellipse cx="344" cy="491" rx="110" ry="21" fill="#d2d2d0"/>
            </g>
            <!-- wrong icon -->
            <g filter="url(#icon-cl)">
              <circle cx="257" cy="747" r="75" fill="url(#red-cl)" stroke="#fff" stroke-width="4"/>
              <path d="m225 715 64 64m0-64-64 64" stroke="#fff" stroke-width="17" stroke-linecap="round"/>
            </g>
            <!-- RIGHT -->
            <ellipse cx="763" cy="360" rx="108" ry="27" fill="#000" opacity=".10" filter="url(#soft-cl)"/>
            <g filter="url(#shadow-cl)">
              <ellipse cx="763" cy="314" rx="92" ry="33" fill="url(#white-cl)" stroke="#b9b9b6" stroke-width="1.3"/>
              <path d="M671 315c0-14 41-27 92-27s92 13 92 27v47c0 21-41 37-92 37s-92-16-92-37z" fill="url(#side-cl)"/>
              <path d="M677 331c41-17 131-17 172 0v20c-40-17-132-17-172 0z" fill="#bebebc" stroke="#9f9f9c"/>
              <g stroke="#222" stroke-width="4.4" stroke-linecap="round"><path d="M688 329v18M701 325v19M715 322v19M730 319v20M746 317v20M762 316v20M779 316v20M796 318v20M812 320v20M827 323v20M840 327v19"/></g>
              <ellipse cx="763" cy="364" rx="28" ry="11.5" fill="#c8c8c6" stroke="#6a6a67" stroke-width="2"/>
              <ellipse cx="763" cy="363" rx="20" ry="8" fill="url(#white-cl)"/>
              <circle cx="811" cy="358" r="3.7" fill="#57a942"/>
              <path d="M704 382c22 8 42 11 59 11 19 0 40-4 61-11" fill="none" stroke="#d5d5d5" opacity=".65" stroke-width="2"/>
            </g>
            <!-- ARROWS -->
            <g fill="#2f8a2f">
              <rect x="757" y="166" width="12" height="101" rx="2"/><path d="m763 145-20 33h40z"/>
              <rect x="757" y="411" width="12" height="91" rx="2"/><path d="m763 525-20-34h40z"/>
              <rect x="583" y="344" width="87" height="12" rx="2"/><path d="m552 350 34-21v42z"/>
              <rect x="856" y="344" width="87" height="12" rx="2"/><path d="m975 350-34-21v42z"/>
