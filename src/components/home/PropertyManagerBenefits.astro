---
import Container from '@/components/Container.astro';
import Testimonials from '@/components/home/Testimonials.astro';

const facts = [
  {
    title: 'Fester Ansprechpartner',
    text: 'Eine direkte Kontaktperson für Ihr Objekt.',
    icon: '<circle cx="12" cy="12" r="10"/><circle cx="12" cy="10" r="3"/><path d="M7 20.662V19a2 2 0 0 1 2-2h6a2 2 0 0 1 2 2v1.662"/>'
  },
  {
    title: 'Digitale Dokumentation',
    text: 'Geräte, Mängel und Maßnahmen übersichtlich erfasst.',
    icon: '<rect width="18" height="18" x="3" y="3" rx="3"/><path d="m7 8 2 2 3-3"/><line x1="14" x2="17" y1="8" y2="8"/><path d="m7 14 2 2 3-3"/><line x1="14" x2="17" y1="14" y2="14"/>'
  },
  {
    title: 'Transparente Angebote',
    text: 'Klare Positionen statt unübersichtlicher Pauschalen.',
    icon: '<path d="M20.59 13.41l-7.17 7.17a2 2 0 0 1-2.83 0L2 12V2h10l8.59 8.59a2 2 0 0 1 0 2.82z"/><circle cx="7" cy="7" r="1.5"/>'
  },
  {
    title: 'Regional vor Ort',
    text: 'In Berlin und Umland persönlich erreichbar.',
    icon: '<path d="M12 2a8 8 0 0 0-8 8c0 5.25 8 12 8 12s8-6.75 8-12a8 8 0 0 0-8-8z"/><circle cx="12" cy="10" r="3"/>'
  }
];

const features = [
  { text: 'Saubere Montage', icon: '<path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"/>' },
  { text: 'Altbau & Stuck berücksichtigt', icon: '<path d="M12 2L2 7l10 5 10-5-10-5Z"/><path d="M2 17l10 5 10-5"/><path d="M2 12l10 5 10-5"/>' },
  { text: 'Offene Einheiten dokumentiert', icon: '<path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" x2="8" y1="13" y2="13"/><line x1="16" x2="8" y1="17" y2="17"/><polyline points="10 9 9 9 8 9"/>' },
  { text: 'Ferninspektion auf Anfrage', icon: '<rect width="20" height="14" x="2" y="3" rx="2"/><line x1="8" x2="16" y1="21" y2="21"/><line x1="12" x2="12" y1="17" y2="21"/>' }
];
---

<section 
  id="ansprechpartner" 
  class="relative py-16 md:py-24 lg:py-32 px-4 overflow-hidden bg-[#06254d] md:pb-[55px] md:pt-[75px] scroll-mt-24"
  style="background: linear-gradient(180deg, #03162f 0%, #06254d 50%, #082c5c 100%);"
  data-ps="src/components/home/PropertyManagerBenefits.astro:section"
>
  {/* Light effects */}
  <div class="absolute top-0 left-1/2 -translate-x-1/2 w-full max-w-[800px] h-[500px] bg-[#4897db] opacity-10 blur-[100px] pointer-events-none" aria-hidden="true" data-ps="src/components/home/PropertyManagerBenefits.astro:glow-1"></div>
  
  <Container class="relative z-10">
    {/* Header */}
    <div class="text-center mb-6 md:mb-10" data-ps="src/components/home/PropertyManagerBenefits.astro:header">
      <div class="relative inline-block mb-4 md:mb-6" data-ps="src/components/home/PropertyManagerBenefits.astro:main-title-container">
        <h2 class="text-[54px] md:text-[80px] lg:text-[110px] font-black text-white tracking-tight leading-none flex items-center justify-center gap-2 md:gap-4" data-ps="src/components/home/PropertyManagerBenefits.astro:title">
          <span class="drop-shadow-[0_0_30px_rgba(255,255,255,0.1)] md:text-[62px]" data-ps="src/components/home/PropertyManagerBenefits.astro:q8ijl4">Warum wir</span>
          <span class="text-[#78d934] drop-shadow-[0_0_20px_rgba(120,217,52,0.3)] md:text-[83px]" data-ps="src/components/home/PropertyManagerBenefits.astro:q8ijl2">?</span>
        </h2>
        <div class="absolute -bottom-4 md:-bottom-6 left-1/2 -translate-x-1/2 w-[90%] md:w-[120%] h-[4px] bg-gradient-to-r from-transparent via-[#1d5c9c] to-transparent opacity-60 blur-[1px]" data-ps="src/components/home/PropertyManagerBenefits.astro:title-line"></div>
        <div class="absolute -bottom-4 md:-bottom-6 left-1/2 -translate-x-1/2 w-[70%] md:w-[100%] h-[8px] bg-[#1d5c9c] opacity-20 blur-[10px]" data-ps="src/components/home/PropertyManagerBenefits.astro:title-glow"></div>
      </div>

      <div class="my-3 md:my-5" data-ps="src/components/home/PropertyManagerBenefits.astro:sgay5u">
        <Testimonials />
      </div>

      <h3 class="text-2xl md:text-3xl lg:text-4xl font-bold text-white leading-tight mt-4 mb-2 md:mt-6 md:mb-3" data-ps="src/components/home/PropertyManagerBenefits.astro:subtitle">
        Wir schützen Vermieter, <br class="hidden md:block"/>
        Eigentümer & Hausverwaltungen.
      </h3>
      <p class="text-base md:text-lg text-[#c3cfdd] font-medium max-w-2xl mx-auto m-0" data-ps="src/components/home/PropertyManagerBenefits.astro:sub-desc">
        Weniger Haftungsrisiko. Weniger Aufwand. Klare Nachweise.
      </p>
    </div>

    {/* 2-Col Main Area */}
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 lg:gap-8 mb-6 lg:mb-8" data-ps="src/components/home/PropertyManagerBenefits.astro:main-area">
      {/* Left Image */}
      <div class="relative w-full aspect-[4/3] lg:aspect-auto rounded-3xl overflow-hidden shadow-2xl shadow-black/20" data-ps="src/components/home/PropertyManagerBenefits.astro:image-col">
        <img 
          src="https://pagesmith-cdn.com/2be62e80/images/Unser-Techniker-mit-dem-Firmenfahrzeug-1536.webp" 
          alt="Normcheck Techniker mit Rauchwarnmelder"
          class="absolute inset-0 w-full h-full object-cover object-center"
          loading="lazy" data-ps="src/components/home/PropertyManagerBenefits.astro:1ey0hg" />
      </div>

      {/* Right Card */}
      <div class="bg-white rounded-3xl p-6 md:p-8 lg:p-10 shadow-xl flex flex-col justify-between" data-ps="src/components/home/PropertyManagerBenefits.astro:facts-card">
        <div data-ps="src/components/home/PropertyManagerBenefits.astro:sgay5u">
          {/* Header */}
          <h3 class="text-3xl font-black text-[#06254d] tracking-tight leading-none mb-6 md:text-[26px]" data-ps="src/components/home/PropertyManagerBenefits.astro:facts-title">Ihr persönlicher Rauchmelder-Service</h3>

          {/* Top Badges */}
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 mb-6" data-ps="src/components/home/PropertyManagerBenefits.astro:badges-row">
            <div class="flex items-center justify-center sm:justify-start gap-2.5 px-4 py-3 rounded-xl border border-[#e2e8f0] bg-white text-xs sm:text-[13px] md:text-sm font-semibold text-[#06254d] shadow-2xs" data-ps="src/components/home/PropertyManagerBenefits.astro:badge-reviews">
              <svg class="w-5 h-5 text-[#25b94b] shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/>
              </svg>
              <span data-ps="src/components/home/PropertyManagerBenefits.astro:q8ijl6">0,0 ★ aus 0 Bewertungen</span>
            </div>
            <div class="flex items-center justify-center sm:justify-start gap-2.5 px-4 py-3 rounded-xl border border-[#e2e8f0] bg-white text-xs sm:text-[13px] md:text-sm font-semibold text-[#06254d] shadow-2xs" data-ps="src/components/home/PropertyManagerBenefits.astro:badge-din">
              <svg class="w-5 h-5 text-[#25b94b] shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/>
                <polyline points="14 2 14 8 20 8"/>
                <circle cx="12" cy="14" r="3"/>
                <path d="m14 16 2 2"/>
              </svg>
              <span data-ps="src/components/home/PropertyManagerBenefits.astro:q8ijl5">DIN-zertifizierte Fachkraft</span>
            </div>
          </div>

          {/* 4 Feature Items */}
          <div class="flex flex-col divide-y divide-[#edf2f7] mb-6" data-ps="src/components/home/PropertyManagerBenefits.astro:facts-list">
            {facts.map((fact, idx) => (
              <div class="flex items-start gap-4 py-4 first:pt-2" data-ps={`src/components/home/PropertyManagerBenefits.astro:fact-${idx}`}>
                <div class="w-10 h-10 rounded-full flex items-center justify-center shrink-0 mt-0.5" data-ps={`src/components/home/PropertyManagerBenefits.astro:fact-icon-${idx}`}>
                  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="#25b94b" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-8 h-8" set:html={fact.icon} />
                </div>
                <div data-ps={`src/components/home/PropertyManagerBenefits.astro:fact-text-${idx}`}>
                  <h4 class="font-bold text-[#06254d] text-base sm:text-lg leading-tight mb-1" data-ps={`src/components/home/PropertyManagerBenefits.astro:musnan-${idx}`}>{fact.title}</h4>
                  <p class="text-[#566176] text-sm sm:text-[15px] leading-snug" data-ps={`src/components/home/PropertyManagerBenefits.astro:musnao-${idx}`}>{fact.text}</p>
                </div>
              </div>
            ))}
          </div>
        </div>

        {/* Bottom Checks */}
        <div class="pt-4 border-t border-[#edf2f7] flex flex-col sm:flex-row sm:items-center justify-between gap-3 text-xs sm:text-[13px] font-medium text-[#06254d]" data-ps="src/components/home/PropertyManagerBenefits.astro:bottom-checks">
          <div class="flex items-center gap-2" data-ps="src/components/home/PropertyManagerBenefits.astro:check-hotline">
            <svg class="w-4 h-4 text-[#25b94b] shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="12" cy="12" r="10"/>
              <path d="m9 12 2 2 4-4"/>
            </svg>
            <span data-ps="src/components/home/PropertyManagerBenefits.astro:q8ijl4">Persönlich statt anonymer Hotline</span>
          </div>
          <div class="flex items-center gap-2" data-ps="src/components/home/PropertyManagerBenefits.astro:check-devices">
            <svg class="w-4 h-4 text-[#25b94b] shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="12" cy="12" r="10"/>
              <path d="m9 12 2 2 4-4"/>
            </svg>
            <span data-ps="src/components/home/PropertyManagerBenefits.astro:q8ijl3">Vorhandene Geräte werden zuerst geprüft</span>
          </div>
        </div>
      </div>
    </div>

    {/* Compact Feature Bar */}
    <div class="bg-[#0a3054] rounded-2xl border border-[#1a4066] p-6 mb-8 md:mb-12" data-ps="src/components/home/PropertyManagerBenefits.astro:feature-bar">
      <div class="grid grid-cols-2 lg:grid-cols-4 gap-4 md:gap-6" data-ps="src/components/home/PropertyManagerBenefits.astro:feature-grid">
        {features.map((feat, idx) => (
          <div class="flex items-center gap-3" data-ps={`src/components/home/PropertyManagerBenefits.astro:feat-${idx}`}>
            <div class="flex-shrink-0 w-8 h-8 rounded-full bg-[#1267b1]/20 flex items-center justify-center" data-ps={`src/components/home/PropertyManagerBenefits.astro:sgay5u-${idx}`}>
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="#78d934" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-4 h-4" set:html={feat.icon} />
            </div>
            <span class="text-white text-sm font-semibold leading-tight" data-ps={`src/components/home/PropertyManagerBenefits.astro:q8ijl9-${idx}`}>{feat.text}</span>
          </div>
        ))}
      </div>
    </div>



    {/* CTA Box (Ihr Kostenrahmen in kurzer Zeit) */}
    <div class="w-full rounded-[22px] border border-[#06264A] bg-gradient-to-r from-[#031526] via-[#061E38] to-[#031526] p-[32px] md:p-[48px] xl:py-[40px] xl:px-[56px] flex flex-col xl:flex-row items-center gap-10 xl:gap-[56px] relative overflow-hidden text-white shadow-2xl" data-ps="src/components/home/PropertyManagerBenefits.astro:cta-area">
      
      <!-- Decorative Glows -->
      <div class="absolute inset-0 pointer-events-none rounded-[22px] overflow-hidden" data-ps="src/components/home/PropertyManagerBenefits.astro:cta-glows">
        <div class="absolute -left-[10%] -top-[30%] w-[50%] h-[160%] bg-[#1878B9] opacity-20 blur-[100px]" data-ps="src/components/home/PropertyManagerBenefits.astro:glow-left"></div>
        <div class="absolute -right-[10%] -bottom-[20%] w-[40%] h-[140%] bg-[#36A90B] opacity-10 blur-[90px]" data-ps="src/components/home/PropertyManagerBenefits.astro:glow-right"></div>
        <div class="absolute left-[30%] top-[0] w-full h-[1px] bg-gradient-to-r from-transparent via-[#1878B9]/40 to-transparent" data-ps="src/components/home/PropertyManagerBenefits.astro:glow-line"></div>
      </div>

      <div class="flex flex-col md:flex-row items-center text-center md:text-left gap-8 xl:gap-[40px] flex-1 relative z-10" data-ps="src/components/home/PropertyManagerBenefits.astro:cta-content">
        <!-- Giant Custom Icon imitating 3D doc -->
        <div class="w-[140px] h-[140px] md:w-[160px] md:h-[160px] rounded-full bg-gradient-to-b from-[#1878B9]/20 to-transparent flex items-center justify-center shrink-0 border border-[#1878B9]/30 relative shadow-[0_0_40px_rgba(24,120,185,0.25)]" data-ps="src/components/home/PropertyManagerBenefits.astro:cta-icon-bg">
          <div class="absolute inset-0 bg-[#1878B9] blur-[25px] opacity-25 rounded-full" data-ps="src/components/home/PropertyManagerBenefits.astro:icon-glow"></div>
          
          <svg class="w-16 h-16 md:w-20 md:h-20 text-[#EEF6FD] relative z-10 drop-shadow-[0_0_15px_rgba(238,246,253,0.5)]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/>
            <path d="M14 2v6h6"/>
            <path d="M16 13H8"/>
            <path d="M16 17H8"/>
            <path d="M10 9H8"/>
          </svg>
          
          <!-- Euro badge overlay -->
          <div class="absolute -bottom-1 -right-1 md:-bottom-2 md:-right-2 w-[60px] h-[60px] md:w-[70px] md:h-[70px] bg-gradient-to-br from-[#1878B9] to-[#083E66] rounded-full flex items-center justify-center border-[3px] border-[#031526] shadow-[0_5px_15px_rgba(0,0,0,0.6)] z-20" data-ps="src/components/home/PropertyManagerBenefits.astro:euro-badge">
            <svg class="w-7 h-7 md:w-8 md:h-8 text-white drop-shadow-[0_0_8px_rgba(255,255,255,0.6)]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M4 10h12"/><path d="M4 14h9"/><path d="M19 6a7.7 7.7 0 0 0-5.2-2A7.9 7.9 0 0 0 6 12c0 4.4 3.5 8 7.8 8 2 0 3.8-.8 5.2-2"/></svg>
          </div>
        </div>

        <div data-ps="src/components/home/PropertyManagerBenefits.astro:cta-text">
          <h3 class="text-[26px] md:text-[34px] font-[800] text-white leading-[1.2] mb-4 max-w-[530px] mx-auto md:mx-0" data-ps="src/components/home/PropertyManagerBenefits.astro:cta-heading">Sie möchten uns beauftragen?</h3>
          <p class="text-[17px] md:text-[19px] text-[#A6BCD6] leading-[1.6] max-w-[600px] mx-auto md:mx-0 font-medium" data-ps="src/components/home/PropertyManagerBenefits.astro:cta-sub">Dann machen Sieden kostenlosen Kosten-Check.
<br/>In 60 Sekunden erfassen wir die wichtigsten Angaben zu Ihrem Objekt.</p>
        </div>
      </div>

      <div class="w-full xl:w-[420px] shrink-0 relative z-10 flex flex-col items-center xl:items-end" data-ps="src/components/home/PropertyManagerBenefits.astro:cta-action">
        <a href="#ersteinschaetzung" class="w-full h-[72px] bg-gradient-to-r from-[#49B90C] to-[#2E9E08] rounded-[18px] flex items-center justify-center gap-3 text-white text-[19px] sm:text-[21px] md:text-[22px] font-[800] shadow-[0_8px_20px_rgba(50,150,10,0.3)] hover:-translate-y-[2px] hover:shadow-[0_12px_25px_rgba(50,150,10,0.4)] transition-all duration-300 ring-offset-2 hover:ring-2 ring-[#49B90C] ring-offset-[#031526] text-center px-4" data-ps="src/components/home/PropertyManagerBenefits.astro:cta-button">
          Kosten-Check starten &rarr;
        </a>
        <div class="mt-2.5 text-xs text-[#A6BCD6] font-medium text-center xl:text-right" data-ps="src/components/home/PropertyManagerBenefits.astro:phone-alt">
          <span class="text-white/80" data-ps="src/components/home/PropertyManagerBenefits.astro:phone-label">Oder direkt anrufen:</span> <a href="tel:+493092105026" class="text-white hover:text-[#8CC63F] font-bold underline transition-colors" data-ps="src/components/home/PropertyManagerBenefits.astro:phone-alt-link">030 9210 5026</a>
        </div>
        <div class="flex items-center flex-wrap justify-center xl:justify-end gap-5 mt-4 text-[14px] md:text-[15px] text-[#A6BCD6] font-medium" data-ps="src/components/home/PropertyManagerBenefits.astro:cta-features">
          <div class="flex items-center gap-1.5" data-ps="src/components/home/PropertyManagerBenefits.astro:feat-unverbindlich">
            <svg class="w-4 h-4 text-white" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><rect width="18" height="11" x="3" y="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
            Unverbindlich
          </div>
          <div class="flex items-center gap-1.5" data-ps="src/components/home/PropertyManagerBenefits.astro:feat-geprueft">
            <svg class="w-4 h-4 text-white" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><polyline points="16 11 18 13 22 9"/></svg>
            Persönlich geprüft
          </div>
          <div class="flex items-center gap-1.5" data-ps="src/components/home/PropertyManagerBenefits.astro:feat-schnell">
            <svg class="w-4 h-4 text-white" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/></svg>
            Schnelle Rückmeldung
          </div>
        </div>
      </div>

    </div>

  </Container>
</section>
