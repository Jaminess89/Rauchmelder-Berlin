---
import Container from '@/components/Container.astro';
---

<section id="koordination" class="py-14 md:py-20 bg-[#EDF3F8] md:pt-[55px] md:pb-[55px]" data-ps="src/components/home/ResidentCoordination.astro:section">
  <Container>
    <h2 class="text-2xl md:text-4xl font-extrabold text-secondary text-center mb-3 tracking-tight" data-ps="src/components/home/ResidentCoordination.astro:title">Auf Wunsch koordinieren wir direkt mit Ihren Bewohnern</h2>
    <p class="text-gray-500 text-center text-base md:text-lg mb-10 md:mb-14" data-ps="src/components/home/ResidentCoordination.astro:subtitle">Wir reduzieren Ihren organisatorischen Aufwand auf ein Minimum.</p>

    <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 lg:gap-12 items-stretch" data-ps="src/components/home/ResidentCoordination.astro:grid">
      <div class="rounded-3xl overflow-hidden shadow-md min-h-[280px]" data-ps="src/components/home/ResidentCoordination.astro:img-wrap">
        <img src="https://pagesmith-cdn.com/2be62e80/images/Kunden-koordianation-Handshake-pexels-thirdman-7653971-1536-768.webp"
          alt="Normcheck-Mitarbeiter mit Tablet im Gespräch mit einer Bewohnerin"
          class="w-full h-full object-cover"
          loading="lazy" data-ps="src/components/home/ResidentCoordination.astro:g6rqvj" />
      </div>
      <div class="bg-white rounded-3xl border border-gray-100 shadow-sm p-6 sm:p-8 flex flex-col justify-between divide-y divide-gray-100" data-ps="src/components/home/ResidentCoordination.astro:steps">
        {/* Schritt 1 */}
        <div class="flex items-center gap-4 sm:gap-6 py-5 first:pt-0 last:pb-0" data-ps="src/components/home/ResidentCoordination.astro:step-1">
          <div class="relative w-16 h-16 sm:w-20 sm:h-20 rounded-full bg-[#f0f6fa] border-4 border-white shadow-[0_4px_12px_rgba(0,0,0,0.06),inset_0_2px_4px_rgba(0,0,0,0.03)] flex items-center justify-center shrink-0" data-ps="src/components/home/ResidentCoordination.astro:doh7rj">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="#133A6B" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-7 h-7 sm:w-9 sm:h-9">
              <rect width="18" height="18" x="3" y="4" rx="2" />
              <path d="M16 2v4" />
              <path d="M8 2v4" />
              <path d="M3 10h18" />
              <path d="M8 14h.01" />
              <path d="M12 14h.01" />
              <path d="M16 14h.01" />
              <path d="M8 18h.01" />
              <path d="M12 18h.01" />
            </svg>
            <div class="absolute -bottom-0.5 -right-0.5 w-5 h-5 sm:w-6 sm:h-6 rounded-full bg-[#1AAAE6] text-white flex items-center justify-center border-2 border-white shadow-xs" data-ps="src/components/home/ResidentCoordination.astro:doh7rk">
              <svg class="w-3 h-3 sm:w-3.5 sm:h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="20 6 9 17 4 12"></polyline>
              </svg>
            </div>
          </div>
          <div class="flex-1" data-ps="src/components/home/ResidentCoordination.astro:doh7rl">
            <h3 class="text-base sm:text-lg md:text-xl font-extrabold text-[#133A6B] mb-1" data-ps="src/components/home/ResidentCoordination.astro:uws2k1">Termine abstimmen</h3>
            <p class="text-sm sm:text-base text-gray-500 leading-relaxed" data-ps="src/components/home/ResidentCoordination.astro:xpcmr8">Wir koordinieren passende Termine direkt mit Ihren Mietern.</p>
          </div>
        </div>

        {/* Schritt 2 */}
        <div class="flex items-center gap-4 sm:gap-6 py-5 first:pt-0 last:pb-0" data-ps="src/components/home/ResidentCoordination.astro:step-2">
          <div class="relative w-16 h-16 sm:w-20 sm:h-20 rounded-full bg-[#f0f6fa] border-4 border-white shadow-[0_4px_12px_rgba(0,0,0,0.06),inset_0_2px_4px_rgba(0,0,0,0.03)] flex items-center justify-center shrink-0" data-ps="src/components/home/ResidentCoordination.astro:doh7rm">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="#133A6B" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-7 h-7 sm:w-9 sm:h-9">
              <path d="M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2" />
              <rect width="8" height="4" x="8" y="2" rx="1" />
              <path d="m9 12 2 2 4-4" />
              <path d="m9 16 2 2 4-4" />
            </svg>
            <div class="absolute -bottom-0.5 -right-0.5 w-5 h-5 sm:w-6 sm:h-6 rounded-full bg-[#1AAAE6] text-white flex items-center justify-center border-2 border-white shadow-xs" data-ps="src/components/home/ResidentCoordination.astro:doh7rn">
              <svg class="w-3 h-3 sm:w-3.5 sm:h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="20 6 9 17 4 12"></polyline>
              </svg>
            </div>
          </div>
          <div class="flex-1" data-ps="src/components/home/ResidentCoordination.astro:doh7ro">
            <h3 class="text-base sm:text-lg md:text-xl font-extrabold text-[#133A6B] mb-1" data-ps="src/components/home/ResidentCoordination.astro:uws2k2">Offene Wohnungen nachhalten</h3>
            <p class="text-sm sm:text-base text-gray-500 leading-relaxed" data-ps="src/components/home/ResidentCoordination.astro:xpcmr9">Absagen und noch offene Termine behalten wir im Blick.</p>
          </div>
        </div>

        {/* Schritt 3 */}
        <div class="flex items-center gap-4 sm:gap-6 py-5 first:pt-0 last:pb-0" data-ps="src/components/home/ResidentCoordination.astro:step-3">
          <div class="relative w-16 h-16 sm:w-20 sm:h-20 rounded-full bg-[#f0f6fa] border-4 border-white shadow-[0_4px_12px_rgba(0,0,0,0.06),inset_0_2px_4px_rgba(0,0,0,0.03)] flex items-center justify-center shrink-0" data-ps="src/components/home/ResidentCoordination.astro:doh7rp">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="#133A6B" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-7 h-7 sm:w-9 sm:h-9">
              <path d="M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7Z" />
              <path d="M14 2v4a2 2 0 0 0 2 2h4" />
              <path d="M10 18v-4" />
              <path d="M14 18v-7" />
              <path d="M6 18v-2" />
            </svg>
            <div class="absolute -bottom-0.5 -right-0.5 w-5 h-5 sm:w-6 sm:h-6 rounded-full bg-[#1AAAE6] text-white flex items-center justify-center border-2 border-white shadow-xs" data-ps="src/components/home/ResidentCoordination.astro:doh7rq">
              <svg class="w-3 h-3 sm:w-3.5 sm:h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="20 6 9 17 4 12"></polyline>
              </svg>
            </div>
          </div>
          <div class="flex-1" data-ps="src/components/home/ResidentCoordination.astro:doh7rr">
            <h3 class="text-base sm:text-lg md:text-xl font-extrabold text-[#133A6B] mb-1" data-ps="src/components/home/ResidentCoordination.astro:nwrrfa">Übersicht erhalten</h3>
            <p class="text-sm sm:text-base text-gray-500 leading-relaxed" data-ps="src/components/home/ResidentCoordination.astro:xpcmra">Sie erhalten eine klare Rückmeldung zum aktuellen Stand.</p>
          </div>
        </div>
      </div>
    </div>

    <p class="text-center text-[#4B9511] font-bold text-base md:text-lg mt-10" data-ps="src/components/home/ResidentCoordination.astro:benefit">Weniger Verwaltungsaufwand für Sie, mehr Komfort für Ihre Bewohner.</p>
  </Container>
</section>
