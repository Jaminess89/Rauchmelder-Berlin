---
import Container from '@/components/Container.astro';

const points = [
  { title: 'Objekt', text: 'Alle Objektdaten auf einen Blick.' },
  { title: 'Wohnung / Bereich', text: 'Jede Einheit klar zugeordnet.' },
  { title: 'Geräte erfasst', text: 'Typ und Position nachvollziehbar dokumentiert.' },
  { title: 'Mängel dokumentiert', text: 'Auffälligkeiten verständlich festgehalten.' },
  { title: 'Maßnahmen festgehalten', text: 'Erledigt, geplant oder empfohlen.' },
  { title: 'Nächster Schritt', text: 'Empfehlung und Austauschzeitpunkt.' },
];

const protocolRows = [
  ['Objekt', 'Musterstraße 12, Berlin'],
  ['Wohnung / Bereich', 'WE 05, 2. OG links'],
  ['Geprüfte Geräte', '5 Rauchwarnmelder'],
  ['Festgestellte Mängel', '1 Melder verschmutzt'],
  ['Durchgeführte Maßnahmen', 'Funktionstest, Reinigung'],
  ['Nächster Schritt', 'Austausch WE 12 empfohlen'],
];
---

<section class="py-14 md:py-20 bg-[#EDF3F8]" data-ps="src/components/home/DigitalReportPreview.astro:section">
  <Container>
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-10 lg:gap-14 items-center" data-ps="src/components/home/DigitalReportPreview.astro:grid">
      <!-- Laptop Mockup -->
      <div class="flex justify-center" data-ps="src/components/home/DigitalReportPreview.astro:mockup-wrap">
        <div class="w-full max-w-[520px]">
          <div class="rounded-t-xl bg-[#1F2937] px-3 pt-3 pb-0 shadow-2xl">
            <div class="rounded-t-lg bg-white overflow-hidden">
              <div class="bg-[#133A6B] px-4 py-2.5 flex items-center justify-between">
                <span class="text-white text-[13px] font-extrabold tracking-widest">PRÜFPROTOKOLL</span>
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="#8CC63F" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-5 h-5" aria-hidden="true"><path d="M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z"/><path d="m9 12 2 2 4-4"/></svg>
              </div>
              <div class="divide-y divide-gray-100 text-[12px] sm:text-[13px]">
                {protocolRows.map(([label, value]) => (
                  <div class="flex items-start gap-2 px-4 py-2.5">
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="#4B9511" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="w-4 h-4 shrink-0 mt-0.5" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg>
                    <div>
                      <span class="font-bold text-[#133A6B]">{label}: </span>
                      <span class="text-gray-500">{value}</span>
                    </div>
                  </div>
                ))}
              </div>
            </div>
          </div>
          <div class="h-3.5 rounded-b-xl rounded-t-sm bg-gradient-to-b from-[#374151] to-[#1F2937] shadow-2xl" aria-hidden="true"></div>
        </div>
      </div>

      <!-- Content -->
      <div data-ps="src/components/home/DigitalReportPreview.astro:content">
        <h2 class="text-2xl md:text-4xl font-extrabold text-secondary mb-8 tracking-tight" data-ps="src/components/home/DigitalReportPreview.astro:title">So sieht Ihr digitaler Nachweis aus</h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-x-8 gap-y-5 mb-9" data-ps="src/components/home/DigitalReportPreview.astro:points">
          {points.map((p) => (
            <div class="flex items-start gap-3">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="#4B9511" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="w-5 h-5 shrink-0 mt-0.5" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg>
              <div>
                <p class="font-bold text-[#133A6B] text-[15px] leading-snug">{p.title}</p>
                <p class="text-[13px] text-gray-500 leading-relaxed">{p.text}</p>
              </div>
            </div>
          ))}
        </div>
        <a href="#anfrage" class="inline-flex items-center gap-3 bg-[#81CD35] hover:bg-[#6fb52a] text-white text-base font-bold px-6 py-3.5 rounded-[10px] no-underline transition-all shadow-lg focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#133A6B]" data-ps="src/components/home/DigitalReportPreview.astro:cta">
          Beispielprotokoll ansehen
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="w-5 h-5" aria-hidden="true"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
        </a>
        {/* TODO: Button mit echtem Musterprotokoll (PDF-Download oder Detailseite) verbinden, sobald vorhanden. */}
      </div>
    </div>
  </Container>
</section>
