---
import Container from '@/components/Container.astro';

// TODO: Platzhalter – nur durch echte, freigegebene Kundenstimmen ersetzen.
const reviews = [
  { text: 'Kundenstimme ergänzen', author: 'Kundenstimme ergänzen' },
  { text: 'Kundenstimme ergänzen', author: 'Kundenstimme ergänzen' },
  { text: 'Kundenstimme ergänzen', author: 'Kundenstimme ergänzen' },
];

const trust = ['Zuverlässig', 'Pünktlich', 'Kompetent', 'Transparent'];
---

<section class="py-14 md:py-20 bg-[#EDF3F8]" data-ps="src/components/home/Testimonials.astro:section">
  <Container>
    <h2 class="text-2xl md:text-4xl font-extrabold text-secondary text-center mb-10 md:mb-14 tracking-tight" data-ps="src/components/home/Testimonials.astro:title">Das sagen unsere Kunden</h2>

    <div class="grid grid-cols-1 md:grid-cols-4 gap-6 mb-10" data-ps="src/components/home/Testimonials.astro:grid">
      <!-- Bewertungsübersicht (Platzhalter, bis echte Bewertungsquelle vorhanden ist) -->
      <div class="bg-white rounded-2xl border border-dashed border-gray-300 shadow-sm p-7 flex flex-col items-center justify-center text-center" data-ps="src/components/home/Testimonials.astro:summary">
        {/* TODO: Echte Bewertungszahl aus verifizierter Quelle (z. B. Google-Unternehmensprofil) ergänzen. */}
        <p class="text-5xl font-black text-[#133A6B] mb-2">–</p>
        <p class="text-[13px] text-gray-400 leading-relaxed">Bewertungsübersicht ergänzen,<br />sobald echte Daten vorliegen</p>
      </div>

      {reviews.map((r) => (
        <div class="bg-white rounded-2xl border border-dashed border-gray-300 shadow-sm p-7 flex flex-col gap-3">
          <p class="text-sm text-gray-500 leading-relaxed italic flex-1">„{r.text}"</p>
          <p class="text-[13px] font-bold text-[#133A6B]">— {r.author}</p>
        </div>
      ))}
    </div>

    <div class="flex flex-wrap justify-center gap-x-10 gap-y-4" data-ps="src/components/home/Testimonials.astro:trust">
      {trust.map((t) => (
        <span class="flex items-center gap-2 text-sm font-semibold text-gray-600">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="#4B9511" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="w-5 h-5" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg>
          {t}
        </span>
      ))}
    </div>
  </Container>
</section>
