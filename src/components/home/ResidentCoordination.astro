---
import Container from '@/components/Container.astro';

const steps = [
  {
    title: 'Termine abstimmen',
    text: 'Wir finden passende Termine vor Ort und stimmen diese ab.',
    icon: '<rect x="3" y="4" width="18" height="18" rx="2"/><path d="M16 2v4M8 2v4M3 10h18"/>',
  },
  {
    title: 'Rückmeldungen erfassen',
    text: 'Wir halten Rückmeldungen, Absagen und Hinweise verständlich fest.',
    icon: '<path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/>',
  },
  {
    title: 'Offene Wohnungen nachhalten',
    text: 'Wir behalten offene Einheiten im Blick und erinnern bei Bedarf.',
    icon: '<path d="M13 4h3a2 2 0 0 1 2 2v14"/><path d="M2 20h3"/><path d="M13 20h9"/><path d="M10 12v.01"/><path d="M13 4.562v16.157a1 1 0 0 1-1.242.97L5 20V5.562a2 2 0 0 1 1.515-1.94l4-1A2 2 0 0 1 13 4.561Z"/>',
  },
  {
    title: 'Übersicht erhalten',
    text: 'Sie erhalten regelmäßige Updates und eine abschließende Übersicht.',
    icon: '<rect x="2" y="3" width="20" height="14" rx="2"/><path d="M8 21h8M12 17v4"/><path d="m7 12 3-3 2 2 4-4"/>',
  },
];
---

<section class="py-14 md:py-20 bg-[#EDF3F8]" data-ps="src/components/home/ResidentCoordination.astro:section">
  <Container>
    <h2 class="text-2xl md:text-4xl font-extrabold text-secondary text-center mb-3 tracking-tight" data-ps="src/components/home/ResidentCoordination.astro:title">Auf Wunsch koordinieren wir direkt mit Ihren Bewohnern</h2>
    <p class="text-gray-500 text-center text-base md:text-lg mb-10 md:mb-14" data-ps="src/components/home/ResidentCoordination.astro:subtitle">Wir reduzieren Ihren organisatorischen Aufwand auf ein Minimum.</p>

    <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 lg:gap-12 items-stretch" data-ps="src/components/home/ResidentCoordination.astro:grid">
      <div class="rounded-3xl overflow-hidden shadow-md min-h-[280px]" data-ps="src/components/home/ResidentCoordination.astro:img-wrap">
        <img
          src="https://images.unsplash.com/photo-1600880292203-757bb62b4baf?w=900&q=80&auto=format&fit=crop"
          alt="Normcheck-Mitarbeiter mit Tablet im Gespräch mit einer Bewohnerin"
          class="w-full h-full object-cover"
          loading="lazy"
        />
      </div>
      <div class="flex flex-col gap-4" data-ps="src/components/home/ResidentCoordination.astro:steps">
        {steps.map((s, i) => (
          <div class="bg-white rounded-2xl border border-gray-100 shadow-sm p-5 md:p-6 flex items-start gap-4">
            <span class="shrink-0 w-9 h-9 rounded-full bg-[#133A6B] text-white font-extrabold text-base flex items-center justify-center">{i + 1}</span>
            <div class="flex-1">
              <h3 class="text-base md:text-lg font-bold text-[#133A6B] mb-1">{s.title}</h3>
              <p class="text-sm text-gray-500 leading-relaxed">{s.text}</p>
            </div>
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="#3F789E" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" class="w-8 h-8 shrink-0 hidden sm:block" aria-hidden="true" set:html={s.icon} />
          </div>
        ))}
      </div>
    </div>

    <p class="text-center text-[#4B9511] font-bold text-base md:text-lg mt-10" data-ps="src/components/home/ResidentCoordination.astro:benefit">Weniger Verwaltungsaufwand für Sie – mehr Komfort für Ihre Bewohner.</p>
  </Container>
</section>
