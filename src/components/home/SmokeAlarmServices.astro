---
import Container from '@/components/Container.astro';

const services = [
  {
    title: "Planung und Montage",
    description: `✓ Räume prüfen
✓ Melder auswählen
✓ Montagepunkte festlegen
✓ Fachgerecht montieren`,
    image: "https://images.pexels.com/photos/8005397/pexels-photo-8005397.jpeg?auto=compress&cs=tinysrgb&w=800"
  },
  {
    title: "Wartung und Prüfung",
    description: `✓ Montageposition prüfen
✓ Funktionstest durchführen
✓ Batteriestatus kontrollieren
✓ Zustand bewerten`,
    image: "https://images.pexels.com/photos/8292837/pexels-photo-8292837.jpeg?auto=compress&cs=tinysrgb&w=800"
  },
  {
    title: "Austausch und Nachrüstung",
    description: `✓ Bedarf ermitteln
✓ Geeignete Melder auswählen
✓ Defekte Geräte austauschen
✓ Positionierung optimieren`,
    image: "https://images.pexels.com/photos/4792521/pexels-photo-4792521.jpeg?auto=compress&cs=tinysrgb&w=800"
  }
];
---

<section class="pt-4 pb-12 sm:py-16 md:py-24 md:pt-[33px] md:pb-[55px]" style="background-color: #3F789E;" data-ps="src/components/home/SmokeAlarmServices.astro:8glkdm">
  <Container>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 sm:gap-8" data-ps="src/components/home/SmokeAlarmServices.astro:truz0h">
        <div 
          id="wartung"
          class="flex flex-row md:flex-col items-center md:items-stretch gap-4 sm:gap-6 md:gap-0 group h-full bg-white/5 md:bg-transparent p-3.5 sm:p-5 md:p-0 rounded-2xl md:rounded-none border border-white/10 md:border-none shadow-sm md:shadow-none scroll-mt-24"
          data-aos="fade-up"
          data-aos-delay="0"
         data-ps="src/components/home/SmokeAlarmServices.astro:truz0g-0">
          <div class="relative overflow-hidden rounded-xl sm:rounded-2xl w-28 h-28 xs:w-36 xs:h-36 sm:w-44 sm:h-44 md:w-full md:h-auto md:aspect-[4/3] shrink-0 md:mb-6 lg:mb-8 shadow-md md:shadow-xl" data-ps="src/components/home/SmokeAlarmServices.astro:truz0f-0">
            <img 
              src="https://pagesmith-cdn.com/2be62e80/images/Inspektion-vor-der-Wartung-Bild-640.webp" 
              alt="Wartung und Prüfung"
              class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
              loading="lazy" data-ps="src/components/home/SmokeAlarmServices.astro:be04bd-0" />
          </div>
          
          <div class="flex flex-col flex-grow min-w-0 justify-center md:justify-start" data-ps="src/components/home/SmokeAlarmServices.astro:truz0e-0">
            <h3 class="text-white/90 leading-snug md:leading-relaxed font-bold mb-1.5 md:mb-2 md:mt-[-12px] text-base xs:text-lg sm:text-[22px]" data-ps="src/components/home/SmokeAlarmServices.astro:1m7sas-0">Wartung & Prüfung</h3>
            <div class="flex flex-col gap-1 sm:gap-1.5 text-white/90 leading-snug md:leading-relaxed font-medium" data-ps="src/components/home/SmokeAlarmServices.astro:ljxcg3-0-wrapper">
              <p class="text-xs xs:text-sm sm:text-base md:text-lg" data-ps="src/components/home/SmokeAlarmServices.astro:ljxcg3-0-1">✓ Funktion testen</p>
              <p class="text-xs xs:text-sm sm:text-base md:text-lg" data-ps="src/components/home/SmokeAlarmServices.astro:ljxcg3-0-2">✓ Batterie prüfen</p>
              <p class="text-xs xs:text-sm sm:text-base md:text-lg" data-ps="src/components/home/SmokeAlarmServices.astro:ljxcg3-0-3">✓ Mängel erkennen</p>
              <p class="text-xs xs:text-sm sm:text-base md:text-lg" data-ps="src/components/home/SmokeAlarmServices.astro:ljxcg3-0-4">✓ Geräte austauschen</p>
            </div>
          </div>
        </div>

        <div 
          id="installation"
          class="flex flex-row md:flex-col items-center md:items-stretch gap-4 sm:gap-6 md:gap-0 group h-full bg-white/5 md:bg-transparent p-3.5 sm:p-5 md:p-0 rounded-2xl md:rounded-none border border-white/10 md:border-none shadow-sm md:shadow-none scroll-mt-24"
          data-aos="fade-up"
          data-aos-delay="100"
         data-ps="src/components/home/SmokeAlarmServices.astro:truz0g-1">
          <div class="relative overflow-hidden rounded-xl sm:rounded-2xl w-28 h-28 xs:w-36 xs:h-36 sm:w-44 sm:h-44 md:w-full md:h-auto md:aspect-[4/3] shrink-0 md:mb-6 lg:mb-8 shadow-md md:shadow-xl" data-ps="src/components/home/SmokeAlarmServices.astro:truz0f-1">
            <img 
              src="https://pagesmith-cdn.com/2be62e80/images/Rauchmelder-Installation-Bild-640.webp" 
              alt="Planung und Montage"
              class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
              loading="lazy" data-ps="src/components/home/SmokeAlarmServices.astro:be04bd-1" />
          </div>
          
          <div class="flex flex-col flex-grow min-w-0 justify-center md:justify-start" data-ps="src/components/home/SmokeAlarmServices.astro:truz0e-1">
            <h3 class="text-white/90 leading-snug md:leading-relaxed font-bold mb-1.5 md:mb-2 md:mt-[-12px] text-base xs:text-lg sm:text-[22px]" data-ps="src/components/home/SmokeAlarmServices.astro:1m7sas-1">Planung & Montage</h3>
            <div class="flex flex-col gap-1 sm:gap-1.5 text-white/90 leading-snug md:leading-relaxed font-medium" data-ps="src/components/home/SmokeAlarmServices.astro:ljxcg3-1-wrapper">
              <p class="text-xs xs:text-sm sm:text-base md:text-lg" data-ps="src/components/home/SmokeAlarmServices.astro:ljxcg3-1-1">✓ Bedarf ermitteln</p>
              <p class="text-xs xs:text-sm sm:text-base md:text-lg" data-ps="src/components/home/SmokeAlarmServices.astro:ljxcg3-1-2">✓ Melder auswählen</p>
              <p class="text-xs xs:text-sm sm:text-base md:text-lg" data-ps="src/components/home/SmokeAlarmServices.astro:ljxcg3-1-3">✓ Position festlegen</p>
              <p class="text-xs xs:text-sm sm:text-base md:text-lg" data-ps="src/components/home/SmokeAlarmServices.astro:ljxcg3-1-4">✓ Fachgerecht montieren</p>
            </div>
          </div>
        </div>

        <div 
          class="flex flex-row md:flex-col items-center md:items-stretch gap-4 sm:gap-6 md:gap-0 group h-full bg-white/5 md:bg-transparent p-3.5 sm:p-5 md:p-0 rounded-2xl md:rounded-none border border-white/10 md:border-none shadow-sm md:shadow-none"
          data-aos="fade-up"
          data-aos-delay="200"
         data-ps="src/components/home/SmokeAlarmServices.astro:truz0g-2">
          <div class="relative overflow-hidden rounded-xl sm:rounded-2xl w-28 h-28 xs:w-36 xs:h-36 sm:w-44 sm:h-44 md:w-full md:h-auto md:aspect-[4/3] shrink-0 md:mb-6 lg:mb-8 shadow-md md:shadow-xl" data-ps="src/components/home/SmokeAlarmServices.astro:truz0f-2">
            <img 
              src="https://pagesmith-cdn.com/2be62e80/images/Protokoll-ubergabe-Bild-640.webp" 
              alt="Austausch und Nachrüstung"
              class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
              loading="lazy" data-ps="src/components/home/SmokeAlarmServices.astro:be04bd-2" />
          </div>
          
          <div class="flex flex-col flex-grow min-w-0 justify-center md:justify-start" data-ps="src/components/home/SmokeAlarmServices.astro:truz0e-2">
            <h3 class="text-white/90 leading-snug md:leading-relaxed font-bold mb-1.5 md:mb-2 md:mt-[-12px] text-base xs:text-lg sm:text-[22px]" data-ps="src/components/home/SmokeAlarmServices.astro:1m7sas-2">Dokumentation & Sicherheit</h3>
            <div class="flex flex-col gap-1 sm:gap-1.5 text-white/90 leading-snug md:leading-relaxed font-medium" data-ps="src/components/home/SmokeAlarmServices.astro:ljxcg3-2-wrapper">
              <p class="text-xs xs:text-sm sm:text-base md:text-lg" data-ps="src/components/home/SmokeAlarmServices.astro:ljxcg3-2-1">✓ Prüfung dokumentieren</p>
              <p class="text-xs xs:text-sm sm:text-base md:text-lg" data-ps="src/components/home/SmokeAlarmServices.astro:ljxcg3-2-2">✓ Protokoll erstellen</p>
              <p class="text-xs xs:text-sm sm:text-base md:text-lg" data-ps="src/components/home/SmokeAlarmServices.astro:ljxcg3-2-3">✓ Nachweise sichern</p>
              <p class="text-xs xs:text-sm sm:text-base md:text-lg" data-ps="src/components/home/SmokeAlarmServices.astro:ljxcg3-2-4">✓ Risiken reduzieren</p>
            </div>
          </div>
        </div>
    </div>
  </Container>
</section>

<style>
  /* Optional: Add a subtle glow to cards on hover */
  .group:hover img {
    filter: brightness(1.1);
  }
</style>
