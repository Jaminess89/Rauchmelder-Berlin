---
import Container from '@/components/Container.astro';
---

<section id="ablauf" class="py-16 md:py-24 bg-white md:pb-[45px] md:pt-[55px] scroll-mt-24" data-ps="src/components/home/StepProcess.astro:section">
  <Container>
    <!-- Header -->
    <div class="text-center mb-12 md:mb-[15px]" data-ps="src/components/home/StepProcess.astro:header">
      <div class="flex items-center justify-center gap-4 mb-3" data-ps="src/components/home/StepProcess.astro:badge">
        <div class="h-[1px] w-8 md:w-12 bg-[#8AC161]" data-ps="src/components/home/StepProcess.astro:line1"></div>
        <span class="text-[#8AC161] font-bold text-sm tracking-widest uppercase" data-ps="src/components/home/StepProcess.astro:label">Einfacher Ablauf</span>
        <div class="h-[1px] w-8 md:w-12 bg-[#8AC161]" data-ps="src/components/home/StepProcess.astro:line2"></div>
      </div>
      <h2 class="text-3xl md:text-4xl font-black text-secondary mb-3 leading-tight" data-ps="src/components/home/StepProcess.astro:title">Ihr Nachweis in 3 Schritten</h2>
      <p class="text-base md:text-lg text-muted-foreground max-w-2xl mx-auto" data-ps="src/components/home/StepProcess.astro:subtitle">In drei Schritten von der Kosteneinschätzung zum digitalen Prüfprotokoll.</p>
    </div>

    <!-- Steps Grid -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 lg:gap-8 mb-12 md:mb-[22px]" data-ps="src/components/home/StepProcess.astro:grid">
      
      <!-- Step 1 -->
      <div class="relative flex flex-col group" data-ps="src/components/home/StepProcess.astro:step1">
        <div class="absolute left-0 top-0 bottom-0 w-1 bg-[#F15A24] z-10" data-ps="src/components/home/StepProcess.astro:border1"></div>
        <div class="bg-white border border-gray-200 rounded-2xl overflow-hidden shadow-sm hover:shadow-xl transition-all duration-300 flex flex-col h-full" data-ps="src/components/home/StepProcess.astro:card1">
          <div class="relative w-full aspect-[16/10] overflow-hidden bg-gray-50" data-ps="src/components/home/StepProcess.astro:img-wrap1">
            <div class="absolute left-0 bottom-0 bg-[#F15A24] text-white font-black text-3xl sm:text-4xl md:text-2xl lg:text-3xl leading-none px-3.5 pt-2 pb-1.5 sm:px-5 sm:pt-3 sm:pb-2 md:px-3 md:pt-2 md:pb-1.5 lg:px-4 lg:pt-2.5 lg:pb-2 rounded-tr-xl z-20" data-ps="src/components/home/StepProcess.astro:num1">1</div>
            <img 
              src="https://pagesmith-cdn.com/2be62e80/images/1.-Schritt-kosten-Check-768.webp" 
              alt="Kosten-Check starten" 
              class="w-full h-full object-cover object-top transition-transform duration-500 group-hover:scale-105"
              data-ps="src/components/home/StepProcess.astro:img1"
            />
          </div>
          <div class="p-5 sm:p-6 md:p-4 lg:p-6 flex flex-col flex-grow justify-start" data-ps="src/components/home/StepProcess.astro:content1">
            <h3 class="text-xl md:text-xl lg:text-2xl font-black text-secondary mb-2.5 leading-tight" data-ps="src/components/home/StepProcess.astro:h3-1">
              <a href="/#ersteinschaetzung" class="text-inherit no-underline hover:text-secondary focus:outline-none" data-ps="src/components/home/StepProcess.astro:h3-link1">1. Kosten-Check starten</a>
            </h3>
            <p class="text-muted-foreground text-sm md:text-xs lg:text-base leading-relaxed" data-ps="src/components/home/StepProcess.astro:p1">
              Beantworten Sie <a href="/#ersteinschaetzung" class="text-[#25b94b] hover:text-[#20a340] font-semibold underline decoration-[#25b94b]/40 hover:decoration-[#20a340] transition-colors" data-ps="src/components/home/StepProcess.astro:text-link1">5 kurze Fragen zu Ihrem Objekt</a>. Grobe Angaben reichen völlig aus.
            </p>
          </div>
          <!-- Corner Accent -->
          <div class="absolute bottom-0 right-0 w-10 h-10 bg-[#F15A24]/5 rounded-tl-[80px]" data-ps="src/components/home/StepProcess.astro:accent1"></div>
        </div>
        <!-- Arrow Visual -->
        <div class="hidden lg:block absolute -right-3.5 top-1/2 -translate-y-1/2 z-30 pointer-events-none" data-ps="src/components/home/StepProcess.astro:arrow1">
          <svg width="20" height="40" viewBox="0 0 24 48" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M2 2L22 24L2 46" stroke="#F15A24" stroke-width="4" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </div>
      </div>

      <!-- Step 2 -->
      <div class="relative flex flex-col group" data-ps="src/components/home/StepProcess.astro:step2">
        <div class="absolute left-0 top-0 bottom-0 w-1 bg-[#1AAAE6] z-10" data-ps="src/components/home/StepProcess.astro:border2"></div>
        <div class="bg-white border border-gray-200 rounded-2xl overflow-hidden shadow-sm hover:shadow-xl transition-all duration-300 flex flex-col h-full" data-ps="src/components/home/StepProcess.astro:card2">
          <div class="relative w-full aspect-[16/10] overflow-hidden bg-gray-50" data-ps="src/components/home/StepProcess.astro:img-wrap2">
            <div class="absolute left-0 bottom-0 bg-[#1AAAE6] text-white font-black text-3xl sm:text-4xl md:text-2xl lg:text-3xl leading-none px-3.5 pt-2 pb-1.5 sm:px-5 sm:pt-3 sm:pb-2 md:px-3 md:pt-2 md:pb-1.5 lg:px-4 lg:pt-2.5 lg:pb-2 rounded-tr-xl z-20" data-ps="src/components/home/StepProcess.astro:num2">2</div>
            <img 
              src="https://pagesmith-cdn.com/2be62e80/images/Rauchmelder-Installation-Bild-640.webp" 
              alt="Termin abstimmen &amp; prüfen lassen" 
              class="w-full h-full object-cover object-center transition-transform duration-500 group-hover:scale-105"
              data-ps="src/components/home/StepProcess.astro:img2"
            />
          </div>
          <div class="p-5 sm:p-6 md:p-4 lg:p-6 flex flex-col flex-grow justify-start" data-ps="src/components/home/StepProcess.astro:content2">
            <h3 class="text-xl md:text-xl lg:text-2xl font-black text-secondary mb-2.5 leading-tight" data-ps="src/components/home/StepProcess.astro:h3-2">2. Termin abstimmen & prüfen lassen</h3>
            <p class="text-muted-foreground text-sm md:text-xs lg:text-base leading-relaxed" data-ps="src/components/home/StepProcess.astro:p2">
              Wir vereinbaren den Termin und prüfen, warten oder montieren Ihre Rauchwarnmelder fachgerecht.
            </p>
          </div>
          <div class="absolute bottom-0 right-0 w-10 h-10 bg-[#1AAAE6]/5 rounded-tl-[80px]" data-ps="src/components/home/StepProcess.astro:accent2"></div>
        </div>
        <div class="hidden lg:block absolute -right-3.5 top-1/2 -translate-y-1/2 z-30 pointer-events-none" data-ps="src/components/home/StepProcess.astro:arrow2">
          <svg width="20" height="40" viewBox="0 0 24 48" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M2 2L22 24L2 46" stroke="#1AAAE6" stroke-width="4" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </div>
      </div>

      <!-- Step 3 -->
      <div class="relative flex flex-col group" data-ps="src/components/home/StepProcess.astro:step3">
        <div class="absolute left-0 top-0 bottom-0 w-1 bg-[#8AC161] z-10" data-ps="src/components/home/StepProcess.astro:border3"></div>
        <div class="bg-white border border-gray-200 rounded-2xl overflow-hidden shadow-sm hover:shadow-xl transition-all duration-300 flex flex-col h-full" data-ps="src/components/home/StepProcess.astro:card3">
          <div class="relative w-full aspect-[16/10] overflow-hidden bg-gray-50 flex items-center justify-center p-2" data-ps="src/components/home/StepProcess.astro:img-wrap3">
            <div class="absolute left-0 bottom-0 bg-[#8AC161] text-white font-black text-3xl sm:text-4xl md:text-2xl lg:text-3xl leading-none px-3.5 pt-2 pb-1.5 sm:px-5 sm:pt-3 sm:pb-2 md:px-3 md:pt-2 md:pb-1.5 lg:px-4 lg:pt-2.5 lg:pb-2 rounded-tr-xl z-20" data-ps="src/components/home/StepProcess.astro:num3">3</div>
            <div class="relative w-full aspect-[1024/633] flex items-center justify-center transition-transform duration-500 group-hover:scale-105" data-ps="src/components/home/StepProcess.astro:laptop-wrapper">
              <!-- Screen content (SVG inside transparent screen) -->
              <div class="absolute left-[12.6%] top-[9.8%] w-[74.8%] h-[77.4%] overflow-hidden bg-white z-0" data-ps="src/components/home/StepProcess.astro:screen-content">
                <svg viewBox="100 25 824 500" class="w-full h-full block" xmlns="http://www.w3.org/2000/svg">
                  <rect x="100" y="25" width="824" height="500" fill="#fff"/>
                  <!-- SCREEN UI -->
                  <g transform="translate(151 50)">
                    <g>
                      <path d="M35 2c8 7 15 8 26 9v20c0 17-11 27-26 34C20 58 10 48 10 31V11c11-1 18-2 25-9Z" fill="none" stroke="#153653" stroke-width="2.5"/>
                      <path d="m22 31 8 8 16-18" fill="none" stroke="#153653" stroke-width="3.2"/>
                      <text x="88" y="30" font-size="29" font-weight="700" fill="#13243a">Prüfprotokoll</text>
                      <text x="88" y="56" font-size="20" fill="#626974">Rauchwarnmelder</text>
                    </g>
                    <g transform="translate(520 10)">
                      <circle cx="26" cy="26" r="22.5" fill="none" stroke="#11ba20" stroke-width="3"/>
                      <path d="m15 26 8 8 15-18" fill="none" stroke="#11ba20" stroke-width="3"/>
                      <text x="66" y="19" font-size="16" fill="#13243a">Prüfung bestanden</text>
                      <text x="66" y="45" font-size="16" fill="#13243a">01.06.2025</text>
                    </g>

                    <g transform="translate(1 80)">
                      <rect width="725" height="300" rx="13" fill="#fff" stroke="#dfe2e5"/>
                      <path d="M0 77H725M0 150H725M0 223H725" stroke="#e5e8ea"/>
                      <g transform="translate(20 13)">
                        <rect width="66" height="53" rx="10" fill="#f4fbf5"/>
                        <g transform="translate(15 8)" stroke="#12b921" fill="none" stroke-width="2.1">
                          <path d="M5 34V4h18v30M0 34h33M10 10h4m5 0h-1m-8 7h4m5 0h-1m-8 7h4m5 0h-1m-8 10v-6h8v6M25 14h5v20"/>
                        </g>
                        <text x="96" y="21" font-size="18" font-weight="700" fill="#13243a">Objekt</text>
                        <text x="96" y="46" font-size="17" fill="#626974">Musterstraße 12, 10115 Berlin</text>
                      </g>
                      <g transform="translate(20 86)">
                        <rect width="66" height="53" rx="10" fill="#f4fbf5"/>
                        <g transform="translate(15 8)" stroke="#12b921" fill="none" stroke-width="2.1">
                          <rect x="1" y="5" width="31" height="29" rx="2"/>
                          <path d="M1 13h31M8 1v9m17-9v9M8 19h3m6 0h3m6 0h1m-19 7h3m6 0h3"/>
                        </g>
                        <text x="96" y="21" font-size="18" font-weight="700" fill="#13243a">Prüfdaten</text>
                        <text x="96" y="46" font-size="17" fill="#626974">01.06.2025  ·  Nächste Prüfung: 01.06.2026</text>
                      </g>
                      <g transform="translate(20 159)">
                        <rect width="66" height="53" rx="10" fill="#f4fbf5"/>
                        <g transform="translate(15 7)" stroke="#12b921" fill="none" stroke-width="2.1">
                          <ellipse cx="17" cy="17" rx="15" ry="12"/>
                          <circle cx="17" cy="17" r="5"/>
                          <path d="M8 34h18M11 30h12"/>
                        </g>
                        <text x="96" y="21" font-size="18" font-weight="700" fill="#13243a">Geräte</text>
                        <text x="96" y="46" font-size="17" fill="#626974">34 geprüfte Rauchwarnmelder</text>
                      </g>
                      <g transform="translate(20 232)">
                        <rect width="66" height="53" rx="10" fill="#f4fbf5"/>
                        <g transform="translate(15 8)" stroke="#12b921" fill="none" stroke-width="2.1">
                          <circle cx="17" cy="17" r="15"/>
                          <path d="m10 18 5 5 10-12"/>
                        </g>
                        <text x="96" y="21" font-size="18" font-weight="700" fill="#13243a">Status</text>
                        <text x="96" y="46" font-size="17" fill="#626974">Alle Geräte in Ordnung</text>
                      </g>
                    </g>

                    <g transform="translate(34 399)">
                      <text x="0" y="21" font-size="17" font-weight="700" fill="#13243a">Geprüft von</text>
                      <text x="0" y="46" font-size="17" fill="#626974">Max Mustermann</text>
                      <path d="M269 32c35-47 53-52 45-23-5 18-25 40-3 20 18-17 32-31 27-13-5 15-19 28-4 17 15-12 29-25 26-11-3 10-11 19-2 14 9-5 15-10 18-6 5 7 18 3 31 2 10 0 24 4 44 1" fill="none" stroke="#07508d" stroke-width="3" stroke-linecap="round"/>
                      <g transform="translate(578 -52) rotate(-7 51 51)">
                        <circle cx="51" cy="51" r="47" fill="#fff" stroke="#29465f" stroke-width="2.5"/>
                        <circle cx="51" cy="51" r="40" fill="none" stroke="#9eabb7" stroke-width="1.1"/>
                        <text x="51" y="24" font-size="10.4" text-anchor="middle" font-weight="800" fill="#29465f" letter-spacing="1.35">GEPRÜFT</text>
                        <path d="M24 31H78" stroke="#c2cad1" stroke-width="1"/>
                        <circle cx="18" cy="51" r="2" fill="#29465f"/>
                        <circle cx="84" cy="51" r="2" fill="#29465f"/>
                        <circle cx="51" cy="51" r="18.5" fill="#f8fafc" stroke="#29465f" stroke-width="1.9"/>
                        <path d="m40.5 51 7.5 7.5 14.5-18" fill="none" stroke="#123f66" stroke-width="5.2" stroke-linecap="round" stroke-linejoin="round"/>
                        <path d="M20 70H82" stroke="#c2cad1" stroke-width="1"/>
                        <text x="51" y="83" font-size="8.2" text-anchor="middle" font-weight="800" fill="#29465f" letter-spacing=".7">FACHBETRIEB</text>
                      </g>
                    </g>
                  </g>
                </svg>
              </div>
              <img 
                src="https://pagesmith-cdn.com/2be62e80/images/Digitales-Prufprotokoll-auf-Laptop-Rahmen-1024.webp" 
                alt="Digitales Prüfprotokoll erhalten" 
                class="relative z-10 w-full h-full object-contain pointer-events-none"
                data-ps="src/components/home/StepProcess.astro:img3"
              />
            </div>
          </div>
          <div class="p-5 sm:p-6 md:p-4 lg:p-6 flex flex-col flex-grow justify-start" data-ps="src/components/home/StepProcess.astro:content3">
            <h3 class="text-xl md:text-xl lg:text-2xl font-black text-secondary mb-2.5 leading-tight" data-ps="src/components/home/StepProcess.astro:h3-3">3. Digitales Prüfprotokoll erhalten</h3>
            <p class="text-muted-foreground text-sm md:text-xs lg:text-base leading-relaxed" data-ps="src/components/home/StepProcess.astro:p3">
              Sie erhalten die Ergebnisse übersichtlich dokumentiert und können nachvollziehen, was wann geprüft wurde.
            </p>
          </div>
          <div class="absolute bottom-0 right-0 w-10 h-10 bg-[#8AC161]/5 rounded-tl-[80px]" data-ps="src/components/home/StepProcess.astro:accent3"></div>
        </div>
      </div>
    </div>


  </Container>
</section>
