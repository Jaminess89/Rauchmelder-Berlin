---
import Container from '@/components/Container.astro';

const points = [
  'Persönlicher Ansprechpartner',
  'Fester Ansprechpartner',
  'Saubere und termingerechte Durchführung',
  'Berlin und Umland',
];
---

<section class="py-14 md:py-20 bg-white" data-ps="src/components/home/ContactPerson.astro:section">
  <Container>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8 lg:gap-12 items-center" data-ps="src/components/home/ContactPerson.astro:grid">
      <div class="rounded-3xl overflow-hidden shadow-md min-h-[260px]" data-ps="src/components/home/ContactPerson.astro:img-wrap">
        <img
          src="https://images.unsplash.com/photo-1560250097-0b93528c311a?w=700&q=80&auto=format&fit=crop"
          alt="Ihr Ansprechpartner für Rauchmelderservice in Berlin"
          class="w-full h-full object-cover"
          loading="lazy"
        />
      </div>

      <div data-ps="src/components/home/ContactPerson.astro:content">
        <h2 class="text-2xl md:text-3xl font-extrabold text-secondary mb-6 tracking-tight" data-ps="src/components/home/ContactPerson.astro:title">Ihr Ansprechpartner für Rauchmelderservice in Berlin</h2>
        <ul class="flex flex-col gap-3">
          {points.map((p) => (
            <li class="flex items-start gap-3 text-[15px] font-semibold text-gray-700">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="#4B9511" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="w-5 h-5 shrink-0 mt-0.5" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg>
              {p}
            </li>
          ))}
        </ul>
      </div>

      <div class="bg-[#EDF3F8] rounded-2xl p-7 flex flex-col items-center text-center gap-4 shadow-sm" data-ps="src/components/home/ContactPerson.astro:card">
        <p class="text-sm text-gray-500 font-semibold">Direkt anrufen</p>
        <a href="tel:+4915735981964" class="text-xl md:text-2xl font-extrabold text-[#133A6B] no-underline hover:text-[#4B9511] transition-colors" data-ps="src/components/home/ContactPerson.astro:phone">0157 359 819 64</a>
        <a href="#anfrage" class="inline-flex items-center gap-3 bg-[#81CD35] hover:bg-[#6fb52a] text-white text-base font-bold px-6 py-3.5 rounded-[10px] no-underline transition-all shadow-lg focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#133A6B]" data-ps="src/components/home/ContactPerson.astro:cta">
          Persönlich anfragen
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="w-5 h-5" aria-hidden="true"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
        </a>
      </div>
    </div>
  </Container>
</section>
