---
import Container from '@/components/Container.astro';
---

<section id="qualitaet" class="py-[90px] md:py-[110px] bg-white overflow-hidden md:pt-[55px] md:pb-2.5 scroll-mt-24" data-ps="src/components/home/SmokeDetectorQuality.astro:section">
  <Container>
    <div class="max-w-[1280px] mx-auto" data-ps="src/components/home/SmokeDetectorQuality.astro:inner-container">
      {/* Badge */}
      <div 
        class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-[#EDF9F0] border border-[#EDF9F0] mb-6"
        data-ps="src/components/home/SmokeDetectorQuality.astro:badge"
      >
        <div class="w-5 h-5 rounded-full bg-[#1D9E3F] flex items-center justify-center" data-ps="src/components/home/SmokeDetectorQuality.astro:badge-icon">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" class="w-3 h-3"><path d="M20 6 9 17l-5-5"/></svg>
        </div>
        <span class="text-[#1D9E3F] text-[13px] font-bold uppercase tracking-wider" data-ps="src/components/home/SmokeDetectorQuality.astro:rne90g">Qualität, der man vertraut</span>
      </div>

      <h2 
        class="text-[34px] font-[900] text-[#06254D] leading-[1.1] mb-6 tracking-tight md:text-[54px]"
        data-ps="src/components/home/SmokeDetectorQuality.astro:title"
      >Diese Rauchwarnmelder setzen wir ein:</h2>

      <p 
        class="text-[17px] md:text-[19px] text-[#394B67] leading-relaxed max-w-[800px] mb-16"
        data-ps="src/components/home/SmokeDetectorQuality.astro:intro"
      >Wir setzen auf geprüfte Geräte mit hoher Zuverlässigkeit und langer Lebensdauer, passend zu Ihrem Objekt und Wartungskonzept.</p>

      {/* Grid */}
      <div 
        class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 sm:gap-6 md:gap-8"
        data-ps="src/components/home/SmokeDetectorQuality.astro:grid"
      >
        <!-- Card 1 -->
        <article 
          class="group bg-white rounded-2xl sm:rounded-[20px] border border-[#DCE5EF] p-4 sm:p-6 lg:p-8 shadow-[0_4px_20px_rgba(0,0,0,0.03)] hover:-translate-y-1 hover:border-[#3F789E]/30 hover:shadow-[0_12px_30px_rgba(0,0,0,0.08)] transition-all duration-300 flex flex-row sm:flex-col items-center sm:items-start text-left gap-3.5 sm:gap-0 relative overflow-hidden h-full"
          data-ps="src/components/home/SmokeDetectorQuality.astro:card-0"
        >
          <div class="relative w-24 xs:w-28 sm:w-full h-24 xs:h-28 sm:h-[220px] md:h-[250px] mb-0 sm:mb-6 md:mb-8 shrink-0 flex items-center justify-center bg-white rounded-xl sm:rounded-none" data-ps="src/components/home/SmokeDetectorQuality.astro:img-wrap-0">
            <div class="w-20 h-20 sm:w-36 sm:h-36 md:w-44 md:h-44 flex items-center justify-center transition-transform duration-500 group-hover:scale-105" data-ps="src/components/home/SmokeDetectorQuality.astro:img-0">
              <svg viewBox="0 0 1000 1000" class="w-full h-full object-contain drop-shadow-[0_8px_14px_rgba(0,0,0,0.18)]" role="img" aria-label="Geprüfte Qualität">
                <defs>
                  <radialGradient id="face" cx="44%" cy="34%" r="74%">
                    <stop offset="0%" stop-color="#ffffff"/>
                    <stop offset="75%" stop-color="#fbfbfa"/>
                    <stop offset="100%" stop-color="#f2f2f0"/>
                  </radialGradient>
                  <linearGradient id="metal" x1="0" y1="0" x2="1" y2="1">
                    <stop offset="0%" stop-color="#ffffff"/>
                    <stop offset="23%" stop-color="#d7d9dc"/>
                    <stop offset="42%" stop-color="#ffffff"/>
                    <stop offset="63%" stop-color="#9ea4ab"/>
                    <stop offset="82%" stop-color="#fdfdfd"/>
                    <stop offset="100%" stop-color="#bfc3c7"/>
                  </linearGradient>
                  <linearGradient id="qgrad" x1="0" y1="0" x2="1" y2="1">
                    <stop offset="0%" stop-color="#173d70"/>
                    <stop offset="46%" stop-color="#10325f"/>
                    <stop offset="100%" stop-color="#061d49"/>
                  </linearGradient>
                  <filter id="seal_soft" x="-20%" y="-20%" width="140%" height="140%">
                    <feGaussianBlur stdDeviation="3.2"/>
                  </filter>
                  <filter id="seal_innerShadow" x="-20%" y="-20%" width="140%" height="140%">
                    <feOffset dx="0" dy="5"/>
                    <feGaussianBlur stdDeviation="5" result="blur"/>
                    <feComposite in="SourceGraphic" in2="blur" operator="out" result="inverse"/>
                    <feFlood flood-color="#001027" flood-opacity=".38"/>
                    <feComposite in2="inverse" operator="in"/>
                    <feComposite in="SourceGraphic"/>
                  </filter>

                  <path id="topArc" d="M 210 360 A 350 350 0 0 1 790 360"/>
                  <path id="bottomArc" d="M 210 712 A 350 350 0 0 0 790 712"/>
                </defs>

                <!-- outer subtle blur/shadow -->
                <circle cx="500" cy="500" r="465" fill="none" stroke="#bfc2c6" stroke-width="18" opacity=".28" filter="url(#seal_soft)"/>

                <!-- metallic outer rim -->
                <circle cx="500" cy="500" r="455" fill="url(#face)" stroke="url(#metal)" stroke-width="26"/>
                <circle cx="500" cy="500" r="447" fill="none" stroke="#f8f8f8" stroke-width="5"/>
                <circle cx="500" cy="500" r="428" fill="none" stroke="#6b7076" stroke-width="4"/>
                <circle cx="500" cy="500" r="423" fill="none" stroke="#ffffff" stroke-width="5"/>
                <circle cx="500" cy="500" r="414" fill="none" stroke="#0b1736" stroke-width="4"/>

                <!-- white face -->
                <circle cx="500" cy="500" r="405" fill="url(#face)"/>

                <!-- arc text -->
                <text class="fill-[#07164d] font-[800] text-[76px] tracking-[8px]" style="font-family: Arial, Helvetica, sans-serif;">
                  <textPath href="#topArc" startOffset="50%" text-anchor="middle">GEPRÜFTE</textPath>
                </text>
                <text class="fill-[#07164d] font-[800] text-[72px] tracking-[8px]" style="font-family: Arial, Helvetica, sans-serif;">
                  <textPath href="#bottomArc" startOffset="50%" text-anchor="middle">QUALITÄT</textPath>
                </text>

                <!-- central Q mark -->
                <circle cx="500" cy="500" r="247" fill="url(#qgrad)" filter="url(#seal_innerShadow)"/>
                <circle cx="500" cy="500" r="156" fill="#ffffff"/>

                <!-- navy inner counter so Q is thick -->
                <ellipse cx="500" cy="505" rx="91" ry="126" fill="url(#qgrad)"/>

                <!-- white diagonal Q tail -->
                <g transform="rotate(40 585 640)">
                  <rect x="560" y="565" width="74" height="190" rx="34" fill="#ffffff"/>
                  <path d="M585 700 L675 700 L630 770 Z" fill="#ffffff"/>
                </g>

                <!-- tiny highlight around dark circle -->
                <circle cx="500" cy="500" r="247" fill="none" stroke="#385a83" stroke-width="5" opacity=".25"/>
              </svg>
            </div>
          </div>
          <div class="flex flex-col justify-center flex-1 min-w-0" data-ps="src/components/home/SmokeDetectorQuality.astro:content-0">
            <h3 
              class="text-[16px] xs:text-[17px] sm:text-[20px] md:text-[23px] font-[800] text-[#06254D] mb-1 sm:mb-3 leading-tight break-words hyphens-auto w-full"
              lang="de"
              data-ps="src/components/home/SmokeDetectorQuality.astro:card-title-0"
            >
              Q-Label
            </h3>
            <p 
              class="text-[13.5px] xs:text-[14px] sm:text-[16px] md:text-[17px] text-[#566176] leading-snug sm:leading-relaxed"
              data-ps="src/components/home/SmokeDetectorQuality.astro:card-desc-0"
            >
              Geprüfte Qualitätsmerkmale für langlebige Rauchwarnmelder.
            </p>
          </div>
        </article>

        <!-- Card 2 -->
        <article 
          class="group bg-white rounded-2xl sm:rounded-[20px] border border-[#DCE5EF] p-4 sm:p-6 lg:p-8 shadow-[0_4px_20px_rgba(0,0,0,0.03)] hover:-translate-y-1 hover:border-[#3F789E]/30 hover:shadow-[0_12px_30px_rgba(0,0,0,0.08)] transition-all duration-300 flex flex-row sm:flex-col items-center sm:items-start text-left gap-3.5 sm:gap-0 relative overflow-hidden h-full"
          data-ps="src/components/home/SmokeDetectorQuality.astro:card-1"
        >
          <div class="relative w-24 xs:w-28 sm:w-full h-24 xs:h-28 sm:h-[220px] md:h-[250px] mb-0 sm:mb-6 md:mb-8 shrink-0 flex items-center justify-center bg-transparent rounded-xl sm:rounded-none overflow-visible" data-ps="src/components/home/SmokeDetectorQuality.astro:img-wrap-1">
            <div class="battery-scene w-full h-full flex items-center justify-center relative transition-transform duration-500 group-hover:scale-105" data-ps="src/components/home/SmokeDetectorQuality.astro:img-1">
              <div class="battery-floor" data-ps="src/components/home/SmokeDetectorQuality.astro:dl0th3"></div>
              <div class="battery-wrap" aria-label="10 Jahre Batterie Illustration" data-ps="src/components/home/SmokeDetectorQuality.astro:dl0th4">
                <div class="battery-contact" data-ps="src/components/home/SmokeDetectorQuality.astro:dl0th5"></div>
                <div class="battery-body" data-ps="src/components/home/SmokeDetectorQuality.astro:ncnecv">
                  <div class="battery-terminal" data-ps="src/components/home/SmokeDetectorQuality.astro:ncnecw"></div>
                  <div class="battery-rim" data-ps="src/components/home/SmokeDetectorQuality.astro:ncnecx"></div>
                  <div class="battery-sheen" data-ps="src/components/home/SmokeDetectorQuality.astro:ncnecy"></div>
                  <div class="battery-micro" data-ps="src/components/home/SmokeDetectorQuality.astro:ncnecz"></div>
                  <span class="battery-edge-l" data-ps="src/components/home/SmokeDetectorQuality.astro:4rx3qr"></span>
                  <span class="battery-edge-r" data-ps="src/components/home/SmokeDetectorQuality.astro:4rx3qq"></span>

                  <div class="battery-copy" data-ps="src/components/home/SmokeDetectorQuality.astro:ncned0">
                    <div class="battery-ten" data-ps="src/components/home/SmokeDetectorQuality.astro:ncned1">10</div>
                    <div class="battery-years" data-ps="src/components/home/SmokeDetectorQuality.astro:ncned2">JAHRE</div>
                  </div>

                  <div class="battery-base" data-ps="src/components/home/SmokeDetectorQuality.astro:ncned3"></div>
                  <div class="battery-base-shine" data-ps="src/components/home/SmokeDetectorQuality.astro:ncned4"></div>
                </div>
              </div>
            </div>
          </div>
          <div class="flex flex-col justify-center flex-1 min-w-0" data-ps="src/components/home/SmokeDetectorQuality.astro:content-1">
            <h3 
              class="text-[16px] xs:text-[17px] sm:text-[20px] md:text-[23px] font-[800] text-[#06254D] mb-1 sm:mb-3 leading-tight break-words hyphens-auto w-full"
              lang="de"
              data-ps="src/components/home/SmokeDetectorQuality.astro:card-title-1"
            >
              10-Jahres-Batterie
            </h3>
            <p 
              class="text-[13.5px] xs:text-[14px] sm:text-[16px] md:text-[17px] text-[#566176] leading-snug sm:leading-relaxed"
              data-ps="src/components/home/SmokeDetectorQuality.astro:card-desc-1"
            >
              Langzeitversorgung für planbare Wartungsintervalle.
            </p>
          </div>
        </article>

        <!-- Card 3 -->
        <article 
          class="group bg-white rounded-2xl sm:rounded-[20px] border border-[#DCE5EF] p-4 sm:p-6 lg:p-8 shadow-[0_4px_20px_rgba(0,0,0,0.03)] hover:-translate-y-1 hover:border-[#3F789E]/30 hover:shadow-[0_12px_30px_rgba(0,0,0,0.08)] transition-all duration-300 flex flex-row sm:flex-col items-center sm:items-start text-left gap-3.5 sm:gap-0 relative overflow-hidden h-full"
          data-ps="src/components/home/SmokeDetectorQuality.astro:card-2"
        >
          <div class="relative w-24 xs:w-28 sm:w-full h-24 xs:h-28 sm:h-[220px] md:h-[250px] mb-0 sm:mb-6 md:mb-8 shrink-0 flex items-center justify-center bg-white rounded-xl sm:rounded-none" data-ps="src/components/home/SmokeDetectorQuality.astro:img-wrap-2">
            <div class="w-20 h-20 sm:w-36 sm:h-36 md:w-44 md:h-44 flex items-center justify-center transition-transform duration-500 group-hover:scale-105" data-ps="src/components/home/SmokeDetectorQuality.astro:img-2">
              <svg viewBox="0 0 800 800" class="w-full h-full object-contain drop-shadow-[0_12px_20px_rgba(0,0,0,0.18)]" aria-label="Rauchmelder Illustration">
                <defs>
                  <radialGradient id="rm_bg" cx="50%" cy="39%" r="66%"><stop stop-color="#d6d9de"/><stop offset=".7" stop-color="#c4c8ce"/><stop offset="1" stop-color="#b3b8bf"/></radialGradient>
                  <radialGradient id="rm_a" cx="38%" cy="13%" r="91%"><stop stop-color="#d6d9dd"/><stop offset=".43" stop-color="#c6cad0"/><stop offset=".73" stop-color="#b6bbc3"/><stop offset=".94" stop-color="#a4aab3"/><stop offset="1" stop-color="#9197a1"/></radialGradient>
                  <radialGradient id="rm_b" cx="45%" cy="24%" r="80%"><stop stop-color="#dcdee2"/><stop offset=".52" stop-color="#c7cbd2"/><stop offset=".82" stop-color="#b4b9c1"/><stop offset="1" stop-color="#9ca2ab"/></radialGradient>
                  <radialGradient id="rm_c" cx="43%" cy="22%" r="80%"><stop stop-color="#d4d7dc"/><stop offset=".67" stop-color="#beccd2"/><stop offset="1" stop-color="#a4aab3"/></radialGradient>
                  <linearGradient id="rm_v" x2="0" y2="1"><stop stop-color="#050505"/><stop offset=".5" stop-color="#161616"/><stop offset="1" stop-color="#020202"/></linearGradient>
                  <radialGradient id="rm_l" cx="50%" cy="40%"><stop stop-color="#f7ffaf"/><stop offset=".2" stop-color="#baff32"/><stop offset=".56" stop-color="#59cf00"/><stop offset="1" stop-color="#163f08"/></radialGradient>
                  <filter id="rm_s"><feGaussianBlur stdDeviation="10"/></filter>
                </defs>

                <ellipse cx="400" cy="690" rx="245" ry="30" fill="#000" opacity=".18" filter="url(#rm_s)"/>
                <path d="M82 245C82 141 221 69 400 69s318 72 318 176v171c0 137-145 241-318 241S82 553 82 416z" fill="url(#rm_a)"/>
                <path d="M99 312c59-73 169-113 301-113s242 40 301 113" fill="none" stroke="#5f6770" stroke-width="4" opacity=".55"/>
                <path d="M103 319c63-69 170-104 297-104s234 35 297 104" fill="none" stroke="#e2e5e9" stroke-width="6" opacity=".95"/>
                <ellipse cx="400" cy="466" rx="312" ry="191" fill="url(#rm_b)"/>
                <ellipse cx="400" cy="469" rx="267" ry="145" fill="none" stroke="#8d949e" stroke-width="4" opacity=".45"/>
                <ellipse cx="400" cy="470" rx="250" ry="132" fill="none" stroke="url(#rm_v)" stroke-width="33"/>
                <g fill="#bdc2c8">
                  <path d="M392 329h16l4 89h-24z"/><path d="M203 383l14-10 52 65-18 13z"/><path d="M597 383l-14-10-52 65 18 13z"/><path d="M154 458l3-17 85 20-4 21z"/><path d="M646 458l-3-17-85 20 4 21z"/><path d="M222 552l-12-12 67-49 15 16z"/><path d="M578 552l12-12-67-49-15 16z"/>
                </g>
                <ellipse cx="400" cy="487" rx="215" ry="113" fill="#bec3c9"/>
                <ellipse cx="400" cy="493" rx="169" ry="78" fill="none" stroke="url(#rm_v)" stroke-width="26"/>
                <g fill="#bec3c9"><path d="M394 405h12l3 56h-18z"/><path d="M286 436l11-8 38 40-14 11z"/><path d="M514 436l-11-8-38 40 14 11z"/><path d="M252 493l2-13 55 11-3 16z"/><path d="M548 493l-2-13-55 11 3 16z"/></g>
                <ellipse cx="400" cy="520" rx="147" ry="87" fill="url(#rm_c)" stroke="#cdd2d8" stroke-width="9"/>
                <ellipse cx="400" cy="543" rx="89" ry="54" fill="url(#rm_c)" stroke="#7e8690" stroke-width="2.2"/>
                <ellipse cx="400" cy="541" rx="76" ry="44" fill="none" stroke="#e0e4e8" stroke-width="2" opacity=".85"/>
                <rect x="357" y="323" width="86" height="31" rx="16" fill="#b8bdc3" stroke="#505963" stroke-width="3"/>
                <rect x="363" y="329" width="74" height="19" rx="10" fill="url(#rm_l)"/>
                <ellipse cx="400" cy="333" rx="24" ry="4.3" fill="#fff" opacity=".7"/>
                <path d="M119 409c40-84 142-139 281-139s241 55 281 139" fill="none" stroke="#ffffff" stroke-width="15" opacity=".2"/>
              </svg>
            </div>
          </div>
          <div class="flex flex-col justify-center flex-1 min-w-0" data-ps="src/components/home/SmokeDetectorQuality.astro:content-2">
            <h3 
              class="text-[16px] xs:text-[17px] sm:text-[20px] md:text-[23px] font-[800] text-[#06254D] mb-1 sm:mb-3 leading-tight break-words hyphens-auto w-full"
              lang="de"
              data-ps="src/components/home/SmokeDetectorQuality.astro:card-title-2"
            >
              Schlafzimmertauglich
            </h3>
            <p 
              class="text-[13.5px] xs:text-[14px] sm:text-[16px] md:text-[17px] text-[#566176] leading-snug sm:leading-relaxed"
              data-ps="src/components/home/SmokeDetectorQuality.astro:card-desc-2"
            >
              Geeignete Statusanzeige und ruhiger Betrieb je nach Modell.
            </p>
          </div>
        </article>

        <!-- Card 4 -->
        <article 
          class="group bg-white rounded-2xl sm:rounded-[20px] border border-[#DCE5EF] p-4 sm:p-6 lg:p-8 shadow-[0_4px_20px_rgba(0,0,0,0.03)] hover:-translate-y-1 hover:border-[#3F789E]/30 hover:shadow-[0_12px_30px_rgba(0,0,0,0.08)] transition-all duration-300 flex flex-row sm:flex-col items-center sm:items-start text-left gap-3.5 sm:gap-0 relative overflow-hidden h-full"
          data-ps="src/components/home/SmokeDetectorQuality.astro:card-3"
        >
          <div class="relative w-24 xs:w-28 sm:w-full h-24 xs:h-28 sm:h-[220px] md:h-[250px] mb-0 sm:mb-6 md:mb-8 shrink-0 flex items-center justify-center bg-white rounded-xl sm:rounded-none" data-ps="src/components/home/SmokeDetectorQuality.astro:img-wrap-3">
            <div class="w-20 h-20 sm:w-32 sm:h-32 md:w-36 md:h-36 flex items-center justify-center transition-transform duration-500 group-hover:scale-105" data-ps="src/components/home/SmokeDetectorQuality.astro:img-3">
              <svg class="w-full h-full overflow-visible drop-shadow-[0_1px_2px_rgba(17,54,96,0.16)]" viewBox="0 0 320 320" role="img" aria-label="Cloud WLAN Icon">
                <defs>
                  <linearGradient id="blueGradientQuality" x1="50" y1="35" x2="260" y2="275" gradientUnits="userSpaceOnUse">
                    <stop offset="0" stop-color="#6f9ac0"/>
                    <stop offset="0.48" stop-color="#356d9d"/>
                    <stop offset="1" stop-color="#103f78"/>
                  </linearGradient>
                </defs>

                <!-- Cloud -->
                <path fill="none" stroke="url(#blueGradientQuality)" stroke-width="17" stroke-linecap="round" stroke-linejoin="round" d="
                  M96 210
                  H78
                  C49 210 28 188 28 159
                  C28 128 52 104 82 104
                  C84 104 87 104 90 105
                  C90 65 120 34 160 34
                  C199 34 230 64 230 104
                  C233 104 236 104 239 104
                  C269 104 292 127 292 157
                  C292 187 270 210 240 210
                  H215
                "/>

                <!-- Wi-Fi mit eckigen Enden -->
                <path fill="none" stroke="url(#blueGradientQuality)" stroke-width="16" stroke-linecap="butt" stroke-linejoin="miter" d="M99 157 C132 128 188 128 221 157"/>
                <path fill="none" stroke="url(#blueGradientQuality)" stroke-width="16" stroke-linecap="butt" stroke-linejoin="miter" d="M118 181 C143 159 177 159 202 181"/>
                <path fill="none" stroke="url(#blueGradientQuality)" stroke-width="16" stroke-linecap="butt" stroke-linejoin="miter" d="M137 204 C150 192 170 192 183 204"/>
                <circle fill="url(#blueGradientQuality)" cx="160" cy="231" r="13"/>
              </svg>
            </div>
          </div>
          <div class="flex flex-col justify-center flex-1 min-w-0" data-ps="src/components/home/SmokeDetectorQuality.astro:content-3">
            <h3 
              class="text-[16px] xs:text-[17px] sm:text-[20px] md:text-[23px] font-[800] text-[#06254D] mb-1 sm:mb-3 leading-tight break-words hyphens-auto w-full"
              lang="de"
              data-ps="src/components/home/SmokeDetectorQuality.astro:card-title-3"
            >
              Ferninspektionsfähig
            </h3>
            <p 
              class="text-[13.5px] xs:text-[14px] sm:text-[16px] md:text-[17px] text-[#566176] leading-snug sm:leading-relaxed"
              data-ps="src/components/home/SmokeDetectorQuality.astro:card-desc-3"
            >
              Auf Wunsch für digitale Prüfroutinen geeignet.
            </p>
          </div>
        </article>
      </div>

      {/* Info Bar */}
      <div 
        class="mt-12 md:mt-16 bg-[#F5F8FC] border border-[#DCE5EF] rounded-[16px] p-5 flex items-center gap-4"
        data-ps="src/components/home/SmokeDetectorQuality.astro:info-bar"
      >
        <div class="shrink-0 w-8 h-8 rounded-full bg-[#06254D] flex items-center justify-center" data-ps="src/components/home/SmokeDetectorQuality.astro:info-icon">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="w-4 h-4"><circle cx="12" cy="12" r="10"/><path d="M12 16v-4"/><path d="M12 8h.01"/></svg>
        </div>
        <p class="text-[#394B67] text-[15px] md:text-[16px] font-medium leading-snug" data-ps="src/components/home/SmokeDetectorQuality.astro:info-text">
          Je nach Objekt z. B. geeignete Lösungen von Ei Electronics oder Hekatron.
        </p>
      </div>
    </div>
  </Container>
</section>

<style>
.battery-scene {
  --w: min(78px, 18vw);
  --h: calc(var(--w) * 1.19);
  position: relative;
  isolation: isolate;
}
@media (min-width: 640px) {
  .battery-scene {
    --w: min(120px, 14vw);
  }
}
@media (min-width: 1024px) {
  .battery-scene {
    --w: 125px;
  }
}
.battery-floor {
  position: absolute;
  bottom: 8%;
  width: 58%;
  height: 10%;
  border-radius: 50%;
  background: radial-gradient(ellipse, rgba(0,0,0,.23) 0 18%, rgba(0,0,0,.11) 42%, rgba(0,0,0,.03) 66%, transparent 78%);
  filter: blur(5px);
  transform: scaleX(1.16);
  z-index: -4;
}
.battery-wrap {
  position: relative;
  width: var(--w);
  height: var(--h);
  filter: drop-shadow(0 14px 12px rgba(0,0,0,.14)) drop-shadow(0 4px 3px rgba(0,0,0,.07));
}
.battery-body {
  position: absolute;
