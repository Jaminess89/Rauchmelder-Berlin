---
import Container from '@/components/Container.astro';

const districts = [
  "Mitte",
  "Friedrichshain-Kreuzberg",
  "Pankow",
  "Charlottenburg-Wilmersdorf",
  "Spandau",
  "Steglitz-Zehlendorf",
  "Tempelhof-Schöneberg",
  "Neukölln",
  "Treptow-Köpenick",
  "Marzahn-Hellersdorf",
  "Lichtenberg",
  "Reinickendorf"
];
---

<section id="einsatzgebiet" class="relative py-20 md:py-28 overflow-hidden bg-transparent text-white md:pt-[75px] md:pb-[75px]" data-ps="src/components/home/ServiceArea.astro:section">
  <!-- Background Image with transparent, moody tint so the Berlin photo stays clearly visible -->
  <div class="absolute inset-0 -z-10 select-none pointer-events-none" data-ps="src/components/home/ServiceArea.astro:bg-wrapper">
    <img 
      src="https://pagesmith-cdn.com/2be62e80/images/Berlin-Photo-florian-wehde-1uWanmgkd5g-unsplash-768-768.webp" 
      alt="Berlin Skyline Hintergrund" 
      class="w-full h-full object-cover object-center filter brightness-[0.85] contrast-[1.05]" 
      loading="lazy"
      data-ps="src/components/home/ServiceArea.astro:bg-image"
    />
    <!-- Subtle cinematic overlay to ensure crisp text contrast while keeping photo visible -->
    <div class="absolute inset-0 bg-slate-950/45" data-ps="src/components/home/ServiceArea.astro:bg-overlay-grad"></div>
    <div class="absolute inset-0 bg-gradient-to-b from-slate-950/60 via-transparent to-slate-950/70" data-ps="src/components/home/ServiceArea.astro:bg-radial"></div>
  </div>

  <Container class="max-w-[1440px] relative z-10">
    <div class="text-center mb-12 md:mb-16" data-ps="src/components/home/ServiceArea.astro:r9lrid">
      <h2 class="text-3xl md:text-5xl font-extrabold text-white mb-5 tracking-tight drop-shadow-[0_4px_12px_rgba(0,0,0,0.8)]" data-ps="src/components/home/ServiceArea.astro:title">In ganz Berlin & Brandenburg im Einsatz</h2>
      <p class="text-base md:text-lg text-slate-100 max-w-2xl mx-auto drop-shadow-[0_2px_8px_rgba(0,0,0,0.8)] font-medium" data-ps="src/components/home/ServiceArea.astro:subtitle">Rauchmelder-Service für Vermieter, Eigentümer und Hausverwaltungen zuverlässig in allen 12 Berliner Bezirken.</p>
    </div>

    <!-- District Grid filling the section -->
    <div class="w-full max-w-6xl mx-auto grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-3.5 sm:gap-4.5" data-ps="src/components/home/ServiceArea.astro:r9lri8">
      {districts.map((district, __psIdx) => (
        <a 
          href="#ersteinschaetzung" 
          class="group flex items-center justify-between relative w-full bg-slate-900/65 hover:bg-slate-800/85 backdrop-blur-md border border-white/15 hover:border-[#86efac]/70 rounded-xl text-white font-bold text-[14px] md:text-[15px] shadow-[0_8px_20px_rgba(0,0,0,0.35)] hover:shadow-[0_12px_28px_rgba(0,0,0,0.5),0_0_20px_rgba(134,239,172,0.2)] transition-all duration-200 min-h-[52px] md:min-h-[58px] px-5 hover:-translate-y-1 focus:outline-none focus-visible:ring-2 focus-visible:ring-[#86efac]"
          data-ps={`src/components/home/ServiceArea.astro:3x47yk-${__psIdx}`}>
          <div class="flex items-center gap-3" data-ps={`src/components/home/ServiceArea.astro:r9lri4-${__psIdx}`}>
            <span class="w-2 h-2 rounded-full bg-[#86efac] shadow-[0_0_8px_#86efac] group-hover:scale-125 transition-transform duration-200" data-ps={`src/components/home/ServiceArea.astro:fjuadx-${__psIdx}`}></span>
            <span class="text-left leading-snug break-words" data-ps={`src/components/home/ServiceArea.astro:dist-${__psIdx}`}>{district}</span>
          </div>
          <svg class="w-4 h-4 text-slate-400 group-hover:text-white transition-all duration-200 group-hover:translate-x-1 flex-shrink-0 ml-2" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.2" data-ps={`src/components/home/ServiceArea.astro:chev-${__psIdx}`}>
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
          </svg>
        </a>
      ))}
    </div>
  </Container>
</section>
