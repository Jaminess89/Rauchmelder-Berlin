---
import Container from '@/components/Container.astro';
---

<section id="kosten" class="py-12 md:py-20 relative overflow-hidden bg-white md:pt-[55px] md:pb-[25px]" data-ps="src/components/home/LandlordCosts.astro:1">
  <Container>
    <!-- Header Section -->
    <div class="flex flex-col md:flex-row md:items-center justify-between gap-6 mb-10 w-full" data-ps="src/components/home/LandlordCosts.astro:2">
      <div class="max-w-2xl" data-ps="src/components/home/LandlordCosts.astro:3">
        <div class="inline-flex items-center gap-2 bg-[#E9F3E4] text-[#25b94b] font-bold px-3 py-1.5 rounded-full text-xs sm:text-sm mb-3.5" data-ps="src/components/home/LandlordCosts.astro:4">
          <svg class="w-4 h-4 text-[#25b94b]" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/></svg>
          WICHTIG FÜR VERMIETER
        </div>
        <h2 class="text-2xl sm:text-3xl lg:text-[40px] font-black text-secondary leading-[1.2] mb-3" data-ps="src/components/home/LandlordCosts.astro:5">Kosten auf Mieter übertragbar?</h2>
        <p class="text-base sm:text-lg text-muted-foreground leading-relaxed m-0" data-ps="src/components/home/LandlordCosts.astro:6">Ja, bestimmte Kosten können unter gesetzlichen Voraussetzungen auf Mieter umgelegt werden.</p>
      </div>
      <div class="w-48 sm:w-60 md:w-72 lg:w-80 shrink-0 self-center md:self-center" data-ps="src/components/home/LandlordCosts.astro:7">
        <img 
          src="https://pagesmith-cdn.com/2be62e80/images/Geld-Bildphoto-1604594849809-dfedbc827105-640.webp" 
          alt="Kosten für Vermieter" 
          class="w-full h-auto object-contain max-h-48 sm:max-h-56 md:w-[210px] md:h-[188px] md:max-h-[214px]" 
          loading="lazy" 
          data-ps="src/components/home/LandlordCosts.astro:dajjbl" />
      </div>
    </div>

    <!-- 3 Columns: Gleich hohe Karten -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-8 w-full items-stretch" data-ps="src/components/home/LandlordCosts.astro:8">
      
      <!-- Karte 1 – GRÜN -->
      <div class="bg-white rounded-[20px] border border-border shadow-sm hover:shadow-md transition-shadow p-6 flex flex-col justify-between h-full" data-ps="src/components/home/LandlordCosts.astro:9">
        <div data-ps="src/components/home/LandlordCosts.astro:ouu4uz">
          <!-- Header Card -->
          <div class="flex items-center gap-3 mb-4" data-ps="src/components/home/LandlordCosts.astro:11">
            <div class="w-8 h-8 rounded-full bg-[#25b94b] text-white flex items-center justify-center font-bold text-sm shrink-0" data-ps="src/components/home/LandlordCosts.astro:asaf01">1</div>
            <div data-ps="src/components/home/LandlordCosts.astro:ouu4v0">
              <h3 class="text-xl font-bold text-secondary leading-none mb-1" data-ps="src/components/home/LandlordCosts.astro:z6dmm8">Ersteinbau</h3>
              <p class="text-sm font-bold text-[#25b94b] m-0" data-ps="src/components/home/LandlordCosts.astro:subtitle-green">Mieterhöhung möglich</p>
            </div>
          </div>

          <!-- Illustration -->
          <div class="flex items-center justify-center h-36 my-3" data-ps="src/components/home/LandlordCosts.astro:asaf00">
            <div class="h-full max-h-36 flex items-center justify-center" data-ps="src/components/home/LandlordCosts.astro:dajjbk">
              <svg viewBox="0 0 800 680" xmlns="http://www.w3.org/2000/svg" class="h-full w-auto max-h-36 select-none" aria-label="8% Mieterhöhung Modernisierung Haus">
                <defs>
                  <filter id="cost-house-shadow" x="-10%" y="-10%" width="120%" height="120%">
                    <feDropShadow dx="0" dy="12" stdDeviation="14" flood-color="#28532d" flood-opacity="0.12" />
                  </filter>
                  <filter id="cost-coin-shadow" x="-30%" y="-20%" width="160%" height="160%">
                    <feDropShadow dx="0" dy="10" stdDeviation="7" flood-color="#1f4322" flood-opacity="0.22" />
                  </filter>
                  <linearGradient id="cost-house-bg" x1="0" y1="0" x2="0" y2="1">
                    <stop offset="0%" stop-color="#ffffff" />
                    <stop offset="70%" stop-color="#fdfefd" />
                    <stop offset="100%" stop-color="#f4f8f3" />
                  </linearGradient>
                  <linearGradient id="cost-coin-edge" x1="0" y1="0" x2="0" y2="1">
                    <stop offset="0%" stop-color="#5a9a45" />
                    <stop offset="50%" stop-color="#418338" />
                    <stop offset="100%" stop-color="#2f6f2d" />
                  </linearGradient>
                  <linearGradient id="cost-coin-top" x1="0" y1="0" x2="0" y2="1">
                    <stop offset="0%" stop-color="#c6e4a7" />
                    <stop offset="25%" stop-color="#9bcd7b" />
                    <stop offset="60%" stop-color="#78b75c" />
                    <stop offset="100%" stop-color="#418338" />
                  </linearGradient>
                  <radialGradient id="cost-coin-inner" cx="50%" cy="30%" r="60%">
                    <stop offset="0%" stop-color="#e0f0c8" />
                    <stop offset="55%" stop-color="#b9db98" />
                    <stop offset="100%" stop-color="#98c778" />
                  </radialGradient>
                  <radialGradient id="cost-ground-grad" cx="50%" cy="50%" r="50%">
                    <stop offset="0%" stop-color="#bcc9ba" stop-opacity="0.9" />
                    <stop offset="45%" stop-color="#c8d5c6" stop-opacity="0.4" />
                    <stop offset="85%" stop-color="#d7dfda" stop-opacity="0" />
                  </radialGradient>
                  <g id="cost-green-coin">
                    <path d="M -72 0 v 10 a 72 20 0 0 0 144 0 v -10 Z" fill="url(#cost-coin-edge)" stroke="#2c6329" stroke-width="1.5" />
                    <ellipse cx="0" cy="0" rx="72" ry="20" fill="url(#cost-coin-top)" stroke="#3d7734" stroke-width="2.5" />
                    <ellipse cx="0" cy="-2" rx="60" ry="14" fill="url(#cost-coin-inner)" opacity="0.92" />
                  </g>
                </defs>

                <!-- Ground Shadow -->
                <ellipse cx="400" cy="620" rx="350" ry="26" fill="url(#cost-ground-grad)" />

                <!-- House Card Background & Shape -->
                <g filter="url(#cost-house-shadow)">
                  <!-- Outer white stroke house -->
                  <path d="M89 330 362 73q30-28 59 0l130 114v-80q0-18 18-18h55q18 0 18 18v160l75 67q18 16 9 37t-32 21h-49v181H154V392h-49q-23 0-32-21t9-37z" fill="url(#cost-house-bg)" stroke="#f1f4f1" stroke-width="38" stroke-linecap="round" stroke-linejoin="round" />
                  <!-- Inner outline house -->
                  <path d="M89 330 362 73q30-28 59 0l130 114v-80q0-18 18-18h55q18 0 18 18v160l75 67q18 16 9 37t-32 21h-49v181H154V392h-49q-23 0-32-21t9-37z" fill="url(#cost-house-bg)" stroke="#d7dfda" stroke-width="22" stroke-linecap="round" stroke-linejoin="round" />
                  <!-- Delicate inner highlight line -->
                  <path d="M92 330 365 79q27-25 53 0l139 121v-88q0-11 11-11h55q11 0 11 11v160l78 69" fill="none" stroke="#fbfcfb" stroke-width="8" stroke-linecap="round" stroke-linejoin="round" />
                </g>

                <!-- 8% Big Text -->
                <text x="400" y="300" font-family="Arial, Helvetica, sans-serif" font-weight="900" font-size="160" fill="#2d7c30" text-anchor="middle" letter-spacing="-10" filter="drop-shadow(0 4px 6px rgba(41,110,44,0.18))">8%</text>

                <!-- Stacks of Coins -->
                <!-- Stack 1 (Left - 3 coins) -->
                <g filter="url(#cost-coin-shadow)" transform="translate(200, 570)">
                  <use href="#cost-green-coin" y="0" />
                  <use href="#cost-green-coin" y="-22" />
                  <use href="#cost-green-coin" y="-44" />
                </g>

                <!-- Stack 2 (Center - 5 coins) -->
                <g filter="url(#cost-coin-shadow)" transform="translate(400, 570)">
                  <use href="#cost-green-coin" y="0" />
                  <use href="#cost-green-coin" y="-22" />
                  <use href="#cost-green-coin" y="-44" />
                  <use href="#cost-green-coin" y="-66" />
                  <use href="#cost-green-coin" y="-88" />
                </g>

                <!-- Stack 3 (Right - 7 coins) -->
                <g filter="url(#cost-coin-shadow)" transform="translate(600, 570)">
                  <use href="#cost-green-coin" y="0" />
                  <use href="#cost-green-coin" y="-22" />
                  <use href="#cost-green-coin" y="-44" />
                  <use href="#cost-green-coin" y="-66" />
                  <use href="#cost-green-coin" y="-88" />
                  <use href="#cost-green-coin" y="-110" />
                  <use href="#cost-green-coin" y="-132" />
                </g>
              </svg>
            </div>
          </div>

          <!-- Feine Trennlinie -->
          <div class="h-px bg-slate-100 my-4 w-full" data-ps="src/components/home/LandlordCosts.astro:divider-1"></div>

          <!-- 2 Punkte -->
          <ul class="space-y-3 mb-6" data-ps="src/components/home/LandlordCosts.astro:12">
            <li class="flex items-start gap-2.5" data-ps="src/components/home/LandlordCosts.astro:jqzsxn">
              <svg class="w-5 h-5 text-[#25b94b] shrink-0 mt-0.5" viewBox="0 0 20 20" fill="currentColor">
                <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
              </svg>
              <span class="text-base text-foreground font-normal leading-snug" data-ps="src/components/home/LandlordCosts.astro:g2brah">Kann bei erstmaligem Einbau als Modernisierung gelten</span>
            </li>
            <li class="flex items-start gap-2.5" data-ps="src/components/home/LandlordCosts.astro:jqzsxm">
              <svg class="w-5 h-5 text-[#25b94b] shrink-0 mt-0.5" viewBox="0 0 20 20" fill="currentColor">
                <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
              </svg>
              <span class="text-base text-foreground font-normal leading-snug" data-ps="src/components/home/LandlordCosts.astro:g2brai">Nach § 559 BGB kann die Miete anteilig erhöht werden</span>
            </li>
          </ul>
        </div>

        <!-- Hinweisbox unten -->
        <div class="bg-[#f0f9f1] border border-[#d1ebd4] rounded-xl p-3 mt-auto" data-ps="src/components/home/LandlordCosts.astro:13">
          <p class="text-xs sm:text-sm text-foreground m-0 leading-relaxed" data-ps="src/components/home/LandlordCosts.astro:g2braj">
            <strong class="font-semibold text-secondary">Hinweis:</strong> Reiner Austausch vorhandener Melder zählt in der Regel nicht dazu.
          </p>
        </div>
      </div>

      <!-- Karte 2 – BLAU -->
      <div class="bg-white rounded-[20px] border border-border shadow-sm hover:shadow-md transition-shadow p-6 flex flex-col justify-between h-full" data-ps="src/components/home/LandlordCosts.astro:14">
        <div data-ps="src/components/home/LandlordCosts.astro:ouu4v1">
          <!-- Header Card -->
          <div class="flex items-center gap-3 mb-4" data-ps="src/components/home/LandlordCosts.astro:16">
            <div class="w-8 h-8 rounded-full bg-secondary text-white flex items-center justify-center font-bold text-sm shrink-0" data-ps="src/components/home/LandlordCosts.astro:ouu4ux">2</div>
            <div data-ps="src/components/home/LandlordCosts.astro:ouu4v2">
              <h3 class="text-xl font-bold text-secondary leading-none mb-1" data-ps="src/components/home/LandlordCosts.astro:z6dmm7">Wartung</h3>
              <p class="text-sm font-bold text-secondary m-0" data-ps="src/components/home/LandlordCosts.astro:subtitle-blue">Über Nebenkosten möglich</p>
            </div>
          </div>

          <!-- Illustration -->
          <div class="flex items-center justify-center h-36 my-3" data-ps="src/components/home/LandlordCosts.astro:ouu4uy">
            <div class="nebenkosten-svg-wrapper h-full max-h-36 flex items-center justify-center" data-ps="src/components/home/LandlordCosts.astro:dajjbj">
              <svg viewBox="0 0 520 480" xmlns="http://www.w3.org/2000/svg" class="h-full w-auto max-h-36 select-none" aria-label="Nebenkosten Abrechnung Rauchmelderwartung">
                <defs>
                  <filter id="nk-shadow" x="-20%" y="-20%" width="140%" height="140%">
                    <feDropShadow dx="0" dy="8" stdDeviation="6" flood-color="#243247" flood-opacity="0.18" />
                  </filter>
                  <linearGradient id="nk-board-bg" x1="0" y1="0" x2="1" y2="1">
                    <stop offset="0%" stop-color="#ffffff" />
                    <stop offset="100%" stop-color="#f8f9fb" />
                  </linearGradient>
                  <linearGradient id="nk-clip-grad" x1="0" y1="0" x2="0" y2="1">
                    <stop offset="0%" stop-color="#466187" />
                    <stop offset="72%" stop-color="#263f63" />
                  </linearGradient>
                  <linearGradient id="nk-line-grad" x1="0" y1="0" x2="1" y2="0">
                    <stop offset="0%" stop-color="#d4d7db" />
                    <stop offset="50%" stop-color="#c7cbd0" />
                    <stop offset="100%" stop-color="#d9dce0" />
                  </linearGradient>
                  <linearGradient id="nk-good-bg" x1="0" y1="0" x2="1" y2="0">
                    <stop offset="0%" stop-color="#f4fbee" />
                    <stop offset="100%" stop-color="#edf7e8" />
                  </linearGradient>
                  <radialGradient id="nk-det-bg" cx="35%" cy="24%" r="75%">
                    <stop offset="0%" stop-color="#ffffff" />
                    <stop offset="37%" stop-color="#f9fbfa" />
                    <stop offset="55%" stop-color="#eef2f1" />
                    <stop offset="73%" stop-color="#d9dfde" />
                    <stop offset="100%" stop-color="#c3cbca" />
                  </radialGradient>
                  <linearGradient id="nk-euro-grad" x1="0" y1="0" x2="1" y2="1">
                    <stop offset="0%" stop-color="#3563a9" />
                    <stop offset="100%" stop-color="#183e7a" />
                  </linearGradient>
                  <linearGradient id="nk-ok-grad" x1="0" y1="0" x2="1" y2="1">
                    <stop offset="0%" stop-color="#44a742" />
                    <stop offset="100%" stop-color="#26832a" />
                  </linearGradient>
                </defs>

                <!-- Board Wrapper with Shadow -->
                <g filter="url(#nk-shadow)">
                  <!-- Clipboard Board -->
                  <rect x="40" y="40" width="360" height="380" rx="36" fill="url(#nk-board-bg)" stroke="#203857" stroke-width="12" />
                  <rect x="52" y="52" width="336" height="356" rx="26" fill="none" stroke="#385579" stroke-width="2" opacity="0.6" />

                  <!-- Clipboard Clip -->
                  <path d="M 175 22 h 90 a 10 10 0 0 1 10 10 v 26 a 10 10 0 0 1 -10 10 h -90 a 10 10 0 0 1 -10 -10 v -26 a 10 10 0 0 1 10 -10 z" fill="url(#nk-clip-grad)" stroke="#162b49" stroke-width="3" />
                  <circle cx="220" cy="18" r="16" fill="#466187" stroke="#182d4b" stroke-width="3" />
                  <circle cx="220" cy="18" r="6" fill="#ffffff" stroke="#152844" stroke-width="2.5" />

                  <!-- Heading "NEBENKOSTEN" -->
                  <text x="220" y="98" font-family="Arial, Helvetica, sans-serif" font-weight="900" font-size="28" fill="#10264a" text-anchor="middle" letter-spacing="-0.5">NEBENKOSTEN</text>
                  <!-- Divider Line -->
                  <rect x="70" y="112" width="300" height="4" rx="2" fill="#8b949f" />

                  <!-- Row 1: Regular Cost Line -->
                  <circle cx="95" cy="148" r="18" fill="#e8eaed" stroke="#d7dade" stroke-width="2" />
                  <text x="95" y="156" font-family="Arial, Helvetica, sans-serif" font-weight="700" font-size="22" fill="#8d949c" text-anchor="middle">€</text>
                  <rect x="130" y="140" width="235" height="7" rx="3.5" fill="url(#nk-line-grad)" />
                  <rect x="130" y="152" width="150" height="7" rx="3.5" fill="url(#nk-line-grad)" />

                  <!-- Row 2: Highlighted "Rauchmelderwartung" -->
                  <rect x="62" y="180" width="316" height="54" rx="14" fill="url(#nk-good-bg)" stroke="#c7dbbd" stroke-width="2" />
                  
                  <!-- Detector Icon inside Highlight -->
                  <circle cx="92" cy="207" r="18" fill="url(#nk-det-bg)" stroke="#aeb9b7" stroke-width="1.5" />
                  <circle cx="92" cy="207" r="11" fill="#f7faf8" stroke="#c2cac8" stroke-width="1" />
                  <circle cx="92" cy="207" r="4.5" fill="#3ca444" />

                  <!-- Text -->
                  <text x="122" y="206" font-family="Arial, Helvetica, sans-serif" font-weight="900" font-size="14" fill="#2f7e30">Rauchmelderwartung</text>
                  <rect x="122" y="213" width="130" height="5" rx="2.5" fill="#cfe1c5" />

                  <!-- Green Checkmark Box -->
                  <rect x="330" y="193" width="28" height="28" rx="7" fill="#f8fff6" stroke="#2c7d2d" stroke-width="3" />
                  <path d="M 337 206 l 5 5 l 10 -11" fill="none" stroke="#2c8a31" stroke-width="4" stroke-linecap="round" stroke-linejoin="round" />

                  <!-- Row 3: Regular Cost Line -->
                  <circle cx="95" cy="266" r="18" fill="#e8eaed" stroke="#d7dade" stroke-width="2" />
                  <text x="95" y="274" font-family="Arial, Helvetica, sans-serif" font-weight="700" font-size="22" fill="#8d949c" text-anchor="middle">€</text>
                  <rect x="130" y="258" width="235" height="7" rx="3.5" fill="url(#nk-line-grad)" />
                  <rect x="130" y="270" width="150" height="7" rx="3.5" fill="url(#nk-line-grad)" />

                  <!-- Bottom Total Line -->
                  <rect x="65" y="306" width="310" height="3.5" rx="1.5" fill="#9aa1aa" />
                  <text x="70" y="338" font-family="Arial, Helvetica, sans-serif" font-weight="900" font-size="20" fill="#12284b">GESAMT</text>
                  <text x="375" y="338" font-family="Arial, Helvetica, sans-serif" font-weight="900" font-size="20" fill="#8e949b" letter-spacing="3" text-anchor="end">€€€,-</text>
                </g>

                <!-- Floating Euro Badge Bottom Right -->
                <g filter="url(#nk-shadow)">
                  <circle cx="410" cy="370" r="64" fill="url(#nk-euro-grad)" stroke="#214b88" stroke-width="8" />
                  <circle cx="410" cy="370" r="54" fill="none" stroke="#ffffff" stroke-width="3" opacity="0.9" />
                  <text x="410" y="405" font-family="Arial, Helvetica, sans-serif" font-weight="900" font-size="95" fill="#ffffff" text-anchor="middle">€</text>

                  <!-- Small Floating Checkmark Badge -->
                  <circle cx="350" cy="415" r="28" fill="url(#nk-ok-grad)" stroke="#ffffff" stroke-width="5" />
                  <path d="M 338 415 l 8 8 l 17 -18" fill="none" stroke="#ffffff" stroke-width="5.5" stroke-linecap="round" stroke-linejoin="round" />
                </g>
              </svg>
            </div>
          </div>

          <!-- Feine Trennlinie -->
          <div class="h-px bg-slate-100 my-4 w-full" data-ps="src/components/home/LandlordCosts.astro:divider-2"></div>

          <!-- 2 Punkte -->
          <ul class="space-y-3 mb-6" data-ps="src/components/home/LandlordCosts.astro:17">
            <li class="flex items-start gap-2.5" data-ps="src/components/home/LandlordCosts.astro:jqzsxl">
              <svg class="w-5 h-5 text-secondary shrink-0 mt-0.5" viewBox="0 0 20 20" fill="currentColor">
                <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
              </svg>
              <span class="text-base text-foreground font-normal leading-snug" data-ps="src/components/home/LandlordCosts.astro:g2brb5">Wiederkehrende Prüf- und Wartungskosten können umlagefähig sein</span>
            </li>
            <li class="flex items-start gap-2.5" data-ps="src/components/home/LandlordCosts.astro:point-blue-2">
              <svg class="w-5 h-5 text-secondary shrink-0 mt-0.5" viewBox="0 0 20 20" fill="currentColor">
                <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
              </svg>
              <span class="text-base text-foreground font-normal leading-snug" data-ps="src/components/home/LandlordCosts.astro:point-blue-2-text">Voraussetzung: wirksame Umlage im Mietvertrag</span>
            </li>
          </ul>
        </div>

        <!-- Hinweisbox unten -->
        <div class="bg-[#f0f7fb] border border-[#cce5f4] rounded-xl p-3 mt-auto" data-ps="src/components/home/LandlordCosts.astro:18">
          <p class="text-xs sm:text-sm text-foreground m-0 leading-relaxed" data-ps="src/components/home/LandlordCosts.astro:g2brb6">
            <strong class="font-semibold text-secondary">Hinweis:</strong> Maßgeblich sind Mietvertrag und Einzelfall.
          </p>
        </div>
      </div>

      <!-- Karte 3 – ROT -->
      <div class="bg-white rounded-[20px] border border-border shadow-sm hover:shadow-md transition-shadow p-6 flex flex-col justify-between h-full" data-ps="src/components/home/LandlordCosts.astro:19">
        <div data-ps="src/components/home/LandlordCosts.astro:ouu4v3">
          <!-- Header Card -->
          <div class="flex items-center gap-3 mb-4" data-ps="src/components/home/LandlordCosts.astro:21">
            <div class="w-8 h-8 rounded-full bg-[#dc2626] text-white flex items-center justify-center font-bold text-sm shrink-0" data-ps="src/components/home/LandlordCosts.astro:ouu4v1">3</div>
            <div data-ps="src/components/home/LandlordCosts.astro:ouu4v4">
              <h3 class="text-xl font-bold text-secondary leading-none mb-1" data-ps="src/components/home/LandlordCosts.astro:z6dmm6">Gerätemiete</h3>
              <p class="text-sm font-bold text-[#dc2626] m-0" data-ps="src/components/home/LandlordCosts.astro:subtitle-red">Nicht umlagefähig</p>
            </div>
          </div>

          <!-- Illustration -->
          <div class="flex items-center justify-center h-36 my-3" data-ps="src/components/home/LandlordCosts.astro:ouu4v2">
            <div class="mietvertrag-svg-wrapper h-full max-h-36 flex items-center justify-center" data-ps="src/components/home/LandlordCosts.astro:dajjbi">
