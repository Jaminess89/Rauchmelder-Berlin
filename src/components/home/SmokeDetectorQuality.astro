---
import Container from '@/components/Container.astro';

const list = [
  'Geprüfte Qualität mit Q-Label',
  '10-Jahres-Batterie für langfristigen Schutz',
  'Schlafzimmertaugliche Modelle',
  'Optional ferninspizierbar',
  'Passende Auswahl je nach Objekt und Nutzung',
];

const features = [
  { title: 'Q-Label', sub: 'Qualitätsgeprüft', icon: '<path d="M3.85 8.62a4 4 0 0 1 4.78-4.77 4 4 0 0 1 6.74 0 4 4 0 0 1 4.78 4.78 4 4 0 0 1 0 6.74 4 4 0 0 1-4.77 4.78 4 4 0 0 1-6.75 0 4 4 0 0 1-4.78-4.77 4 4 0 0 1 0-6.76Z"/><path d="m9 12 2 2 4-4"/>' },
  { title: '10-Jahres-Batterie', sub: 'Langlebige Energie', icon: '<rect x="2" y="7" width="16" height="10" rx="2"/><path d="M22 11v2"/><path d="m11 9-2 3h3l-2 3"/>' },
  { title: 'Schlafzimmertauglich', sub: 'Ruhiger Betrieb', icon: '<path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"/>' },
  { title: 'Optional ferninspizierbar', sub: 'Über Funk', icon: '<path d="M4.9 19.1C1 15.2 1 8.8 4.9 4.9"/><path d="M7.8 16.2c-2.3-2.3-2.3-6.1 0-8.5"/><circle cx="12" cy="12" r="2"/><path d="M16.2 7.8c2.3 2.3 2.3 6.1 0 8.5"/><path d="M19.1 4.9C23 8.8 23 15.1 19.1 19"/>' },
  { title: 'Passende Auswahl', sub: 'Je Objekt', icon: '<path d="M3 3v16a2 2 0 0 0 2 2h16"/><rect x="7" y="13" width="3" height="6" rx="1"/><rect x="12" y="9" width="3" height="10" rx="1"/><rect x="17" y="5" width="3" height="14" rx="1"/>' },
];
---

<section class="py-14 md:py-20 bg-white" data-ps="src/components/home/SmokeDetectorQuality.astro:section">
  <Container>
    <h2 class="text-2xl md:text-4xl font-extrabold text-secondary mb-10 md:mb-12 tracking-tight" data-ps="src/components/home/SmokeDetectorQuality.astro:title">Welche Rauchmelder wir einsetzen</h2>

    <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 lg:gap-14 items-center mb-10" data-ps="src/components/home/SmokeDetectorQuality.astro:top-grid">
      <ul class="flex flex-col gap-4" data-ps="src/components/home/SmokeDetectorQuality.astro:list">
        {list.map((item) => (
          <li class="flex items-start gap-3 text-base text-gray-700 font-medium">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="#4B9511" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="w-6 h-6 shrink-0" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg>
            {item}
          </li>
        ))}
      </ul>
      <div class="flex items-center justify-center gap-6" data-ps="src/components/home/SmokeDetectorQuality.astro:img-wrap">
        <img
          src="https://pagesmith-cdn.com/2be62e80/images/10-Jahres-Frist-Bild-Melder-1024.webp"
          alt="Freigestellter Rauchwarnmelder mit 10-Jahres-Batterie"
          class="w-40 h-40 md:w-56 md:h-56 object-contain"
          loading="lazy"
        />
        <img
          src="https://pagesmith-cdn.com/2be62e80/images/Funktionstest-1024.webp"
          alt="Rauchwarnmelder beim Funktionstest"
          class="w-40 h-40 md:w-56 md:h-56 object-cover rounded-2xl hidden sm:block"
          loading="lazy"
        />
      </div>
    </div>

    <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-5 gap-4" data-ps="src/components/home/SmokeDetectorQuality.astro:feature-grid">
      {features.map((f) => (
        <div class="bg-white rounded-2xl border border-gray-100 shadow-sm p-5 flex flex-col items-center text-center gap-2">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="#3F789E" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" class="w-8 h-8" aria-hidden="true" set:html={f.icon} />
          <h3 class="text-sm font-bold text-[#133A6B] leading-snug">{f.title}</h3>
          <p class="text-xs text-gray-500">{f.sub}</p>
        </div>
      ))}
    </div>

    <p class="text-gray-500 text-sm text-center mt-8" data-ps="src/components/home/SmokeDetectorQuality.astro:note">Je nach Objekt setzen wir geeignete Qualitätsgeräte ein. Die konkrete Auswahl erfolgt nach Prüfung des Bedarfs.</p>
  </Container>
</section>
