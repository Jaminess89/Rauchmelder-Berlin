---
import Container from '@/components/Container.astro';

// TODO: Platzhalter – nur durch echte, freigegebene Kundenstimmen ersetzen.
const reviews = [
  { text: 'Kundenstimme ergänzen', author: 'Kundenstimme ergänzen' },
  { text: 'Kundenstimme ergänzen', author: 'Kundenstimme ergänzen' },
  { text: 'Kundenstimme ergänzen', author: 'Kundenstimme ergänzen' },
];

const trust = ['Zuverlässig', 'Pünktlich', 'Kompetent', 'Transparent'];
---

<section id="bewertungen" class="py-2 md:py-4 scroll-mt-24" data-ps="src/components/home/Testimonials.astro:section">
  <Container>
    <h2 class="text-xl md:text-2xl font-extrabold text-center mb-4 md:mb-6 tracking-tight text-[#78D932]" data-ps="src/components/home/Testimonials.astro:title">Das sagen unsere Kunden</h2>

    <div class="grid grid-cols-1 md:grid-cols-4 gap-4 mb-4 md:mb-6" data-ps="src/components/home/Testimonials.astro:grid">
      <!-- Bewertungsübersicht (Platzhalter, bis echte Bewertungsquelle vorhanden ist) -->
      <div class="bg-white rounded-2xl border border-dashed border-gray-300 shadow-sm p-5 flex flex-col items-center justify-center text-center" data-ps="src/components/home/Testimonials.astro:summary">
        {/* TODO: Echte Bewertungszahl aus verifizierter Quelle (z. B. Google-Unternehmensprofil) ergänzen. */}
        <p class="text-4xl md:text-5xl font-black text-[#133A6B] mb-1" data-ps="src/components/home/Testimonials.astro:q9h2r0">–</p>
        <p class="text-[12px] sm:text-[13px] text-gray-400 leading-relaxed" data-ps="src/components/home/Testimonials.astro:q9h2r1">Bewertungsübersicht ergänzen,<br />sobald echte Daten vorliegen</p>
      </div>

      {reviews.map((r, __psIdx) => (
        <div class="bg-white rounded-2xl border border-dashed border-gray-300 shadow-sm p-5 flex flex-col gap-2.5" data-ps={`src/components/home/Testimonials.astro:jqcpxu-${__psIdx}`}>
          <p class="text-sm text-gray-500 leading-relaxed italic flex-1" data-ps={`src/components/home/Testimonials.astro:q9h2r2-${__psIdx}`}>„{r.text}"</p>
          <p class="text-[13px] font-bold text-[#133A6B]" data-ps={`src/components/home/Testimonials.astro:q9h2r3-${__psIdx}`}>— {r.author}</p>
        </div>
      ))}
    </div>


  </Container>
</section>
