---
import Container from '@/components/Container.astro';
---

<section class="relative bg-black text-white overflow-hidden flex items-center min-h-[600px] pt-12 md:pt-16 lg:py-0 md:min-h-[650px] lg:h-[715px]" data-ps="src/components/home/SplitHero.astro:sec">
  
  <div class="absolute inset-0 z-0 pointer-events-none" data-ps="src/components/home/SplitHero.astro:bg-container">
    <div class="absolute inset-x-0 bottom-0 h-[400px] lg:h-full lg:top-0 lg:bottom-0 lg:right-0 lg:left-[40%] w-full lg:w-[60%]" data-ps="src/components/home/SplitHero.astro:lzu0h">
      <img 
        src="https://pagesmith-cdn.com/2be62e80/images/Feuerwehr-Brand-Bild-pexels-michael-noel-3068524-4741691-1536-1536.webp" 
        alt="Feuerwehreinsatz" 
        class="absolute inset-0 w-full h-full object-cover object-center lg:object-right [mask-image:linear-gradient(to_bottom,transparent_0%,black_10%)] lg:[mask-image:linear-gradient(to_right,transparent_0%,black_10%)] [-webkit-mask-image:linear-gradient(to_bottom,transparent_0%,black_10%)] lg:[-webkit-mask-image:linear-gradient(to_right,transparent_0%,black_10%)]"
        data-ps="src/components/home/SplitHero.astro:img"
      />
      <div class="absolute inset-x-0 bottom-0 h-1/4 lg:h-[30%] bg-gradient-to-t from-black to-transparent z-10" data-ps="src/components/home/SplitHero.astro:bottom-fade"></div>
    </div>
  </div>

  <Container class="relative z-20 h-full w-full">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-8 items-center h-full" data-ps="src/components/home/SplitHero.astro:grid">
      <div class="space-y-6 lg:pr-8 relative z-40 pb-[340px] sm:pb-[380px] lg:pb-0 md:mt-2 lg:mt-0" data-ps="src/components/home/SplitHero.astro:content">
        <h2 class="text-[32px] md:text-[42px] font-bold leading-tight text-white tracking-tight pb-[18px]" data-ps="src/components/home/SplitHero.astro:title">
          <span class="relative inline-block" data-ps="src/components/home/SplitHero.astro:3nrl9k">
            <span class="px-3 py-1 relative z-10 font-bold block md:pl-3 md:pr-3 md:w-[572px]" data-ps="src/components/home/SplitHero.astro:3nrl9j">Rauchmelderpflicht. Nachweis vorhanden?</span>
            <svg class="absolute -bottom-[10px] left-0 w-full h-[18px] z-20 text-[#ffe500]" preserveAspectRatio="none" viewBox="0 0 100 12" fill="none" xmlns="http://www.w3.org/2000/svg">
              <path d="M0 6C30 1 70 1 100 3" stroke="currentColor" stroke-width="4" stroke-linecap="round"/>
            </svg>
          </span>
        </h2>
        <p class="text-[17px] text-gray-200 max-w-xl leading-relaxed font-light pb-[18px]" data-ps="src/components/home/SplitHero.astro:desc">Seit 2021 Pflicht in Berlin & Brandenburg (§ 48 BauO Bln/BbgBO). Ohne Dokumentation drohen Bußgelder und Haftungsrisiken.</p>
      </div>
      <div class="hidden lg:block" data-ps="src/components/home/SplitHero.astro:lzu0i"></div>
    </div>
  </Container>
</section>
