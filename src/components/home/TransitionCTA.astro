---
import Container from '@/components/Container.astro';
---

<section class="py-10 md:py-14 bg-white" data-ps="src/components/home/TransitionCTA.astro:section">
  <Container>
    <div class="rounded-3xl bg-gradient-to-r from-[#0B3A64] via-[#133A6B] to-[#146B70] px-6 py-8 md:px-12 md:py-10 flex flex-col md:flex-row md:items-center gap-6 md:gap-10 shadow-lg" data-ps="src/components/home/TransitionCTA.astro:banner">
      <div class="shrink-0 w-14 h-14 rounded-2xl bg-white/10 flex items-center justify-center" data-ps="src/components/home/TransitionCTA.astro:icon-wrap">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="#8CC63F" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-8 h-8" aria-hidden="true">
          <path d="M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z"/>
          <path d="m9 12 2 2 4-4"/>
        </svg>
      </div>
      <div class="flex-1" data-ps="src/components/home/TransitionCTA.astro:text-wrap">
        <h2 class="text-white text-2xl md:text-3xl font-extrabold tracking-tight mb-2" data-ps="src/components/home/TransitionCTA.astro:title">Nächster Schritt: Klarheit für Ihr Objekt</h2>
        <p class="text-white/80 text-base md:text-lg leading-relaxed max-w-xl" data-ps="src/components/home/TransitionCTA.astro:subtitle">Wir prüfen Ihre Situation, dokumentieren den Status und zeigen Ihnen die sinnvollsten nächsten Schritte.</p>
      </div>
      <div class="shrink-0" data-ps="src/components/home/TransitionCTA.astro:cta-wrap">
        <a href="#anfrage" class="inline-flex items-center gap-3 bg-[#81CD35] hover:bg-[#6fb52a] text-white text-base md:text-lg font-bold px-6 py-3.5 rounded-[10px] no-underline transition-all shadow-lg focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white" data-ps="src/components/home/TransitionCTA.astro:cta">
          Jetzt Objekt prüfen lassen
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="w-5 h-5" aria-hidden="true"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
        </a>
      </div>
    </div>
  </Container>
</section>
