    <script is:inline>
      document.addEventListener('DOMContentLoaded', () => {
        const form = document.getElementById('pricing-funnel-form');
        const status = document.getElementById('pricing-form-status');
        const progressHeader = document.getElementById('p-funnel-header-progress');
        const successScreen = document.getElementById('pricing-funnel-success');
        const resetBtn = document.getElementById('pricing-funnel-reset-btn');
        const progressBar = document.getElementById('p-funnel-progress-bar');
        const percentText = document.getElementById('p-funnel-percent-text');
        const stepCurrentEl = document.getElementById('p-funnel-step-current');
        const summaryList = document.getElementById('pricing-summary-list');

        const stepMeta = [
          { sub: '20 % · 4 kurze Schritte', percent: 20 },
          { sub: '40 % · 3 kurze Schritte', percent: 40 },
          { sub: '60 % · 2 kurze Schritte', percent: 60 },
          { sub: '80 % · 1 kurzer Schritt', percent: 80 },
          { sub: '90 % · Fast geschafft', percent: 90 }
        ];

        let currentStep = 1;
        const totalSteps = 5;

        function syncRadioIndicators() {
          document.querySelectorAll('.p-funnel-card').forEach(card => {
            const ind = card.querySelector('.p-radio-indicator span');
            const inp = card.querySelector('input[type="radio"]');
            if (inp && inp.checked) {
              if (ind) ind.classList.remove('opacity-0');
            } else {
              if (ind) ind.classList.add('opacity-0');
            }
          });
        }

        function updateStep(newStep) {
          if (newStep < 1 || newStep > totalSteps) return;
          currentStep = newStep;

          document.querySelectorAll('.p-funnel-step').forEach(stepEl => {
            const stepNum = parseInt(stepEl.getAttribute('data-step') || '1', 10);
            if (stepNum === currentStep) {
              stepEl.classList.remove('hidden');
              stepEl.classList.add('block');
            } else {
              stepEl.classList.add('hidden');
              stepEl.classList.remove('block');
            }
          });

          const meta = stepMeta[currentStep - 1];
          if (progressBar) progressBar.style.width = `${meta.percent}%`;
          if (percentText) percentText.textContent = meta.sub;
          if (stepCurrentEl) stepCurrentEl.textContent = currentStep;
          if (status) status.classList.add('hidden');
          syncRadioIndicators();
        }

        document.querySelectorAll('.p-btn-prev').forEach(btn => {
          btn.addEventListener('click', () => {
            updateStep(currentStep - 1);
          });
        });

        // Single Choice: Click -> visual selected state -> auto advance after ~250ms
        document.querySelectorAll('.p-auto-advance').forEach(radio => {
          radio.addEventListener('change', (e) => {
            syncRadioIndicators();

            setTimeout(() => {
              if (currentStep < totalSteps) {
                updateStep(currentStep + 1);
              }
            }, 250);
          });
        });

        function validateStep5() {
          if (status) status.classList.add('hidden');

          const name = document.getElementById('pf-name');
          const contact = document.getElementById('pf-contact');
          const plz = document.getElementById('pf-plz');
          const datenschutz = document.getElementById('pf-datenschutz');

          if (!name?.value.trim()) {
            showError('Bitte geben Sie Ihren Namen an.');
            name?.focus();
            return false;
          }

          if (!contact?.value.trim()) {
            showError('Bitte geben Sie Ihre Telefonnummer oder E-Mail-Adresse an.');
            contact?.focus();
            return false;
          }

          if (!plz?.value.trim()) {
            showError('Bitte geben Sie die Postleitzahl des Objekts an.');
            plz?.focus();
            return false;
          }

          if (!datenschutz?.checked) {
            showError('Bitte bestätigen Sie die Datenschutzhinweise.');
            datenschutz?.focus();
            return false;
          }

          return true;
        }

        function showError(msg) {
          if (!status) return;
          status.textContent = msg;
          status.className = 'mt-4 rounded-xl px-4 py-3 text-sm font-semibold bg-red-50 text-red-700 border border-red-200 block';
          status.classList.remove('hidden');
        }

        form?.addEventListener('submit', (e) => {
          e.preventDefault();
          if (!validateStep5()) {
            return;
          }

          const wohnungen = document.querySelector('input[name="p_wohnungen"]:checked')?.value || 'Keine Angabe';
          const leistung = document.querySelector('input[name="p_leistung"]:checked')?.value || 'Keine Angabe';
          const besonderheiten = document.querySelector('input[name="p_besonderheiten"]:checked')?.value || 'Keine Angabe';
          const termine = document.querySelector('input[name="p_termine"]:checked')?.value || 'Keine Angabe';
          const name = document.getElementById('pf-name')?.value || '';
          const plz = document.getElementById('pf-plz')?.value || '';

          if (summaryList) {
            summaryList.innerHTML = `
              <li><strong class="text-[#062B4A]">Gewünschte Leistung:</strong> ${leistung}</li>
              <li><strong class="text-[#062B4A]">Bauliche Besonderheiten:</strong> ${besonderheiten}</li>
              <li><strong class="text-[#062B4A]">Terminorganisation:</strong> ${termine}</li>
              <li><strong class="text-[#062B4A]">Objektgröße:</strong> ${wohnungen}</li>
              <li><strong class="text-[#062B4A]">Kontakt:</strong> ${name} (PLZ ${plz})</li>
            `;
          }

          if (progressHeader) progressHeader.classList.add('hidden');
          if (form) form.classList.add('hidden');
          if (successScreen) successScreen.classList.remove('hidden');
        });

        resetBtn?.addEventListener('click', () => {
          if (form) {
            form.reset();
            form.classList.remove('hidden');
          }
          if (progressHeader) progressHeader.classList.remove('hidden');
          if (successScreen) successScreen.classList.add('hidden');
          if (status) status.classList.add('hidden');

          updateStep(1);
        });

        updateStep(1);
      });
    </script>

  </Container>
