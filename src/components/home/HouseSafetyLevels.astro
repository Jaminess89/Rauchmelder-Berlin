---
import Container from '@/components/Container.astro';
---

<section class="py-16 md:py-24 bg-[#FAF9F6] md:pt-[55px] md:pb-[55px]" data-ps="src/components/home/HouseSafetyLevels.astro:root">
  <Container>
    <!-- Heading Area -->
    <div class="text-center mb-9 md:mt-0 md:mb-[31px]" data-ps="src/components/home/HouseSafetyLevels.astro:header">
      <h2 class="text-[34px] sm:text-[38px] md:text-[46px] lg:text-[56px] font-extrabold text-secondary leading-[1.1] tracking-tight mb-4 md:mb-6 max-w-[900px] mx-auto" data-ps="src/components/home/HouseSafetyLevels.astro:title">
        <span class="text-[#DB6840]" data-ps="src/components/home/HouseSafetyLevels.astro:3b708d">Wo</span> sind Rauchmelder <span class="whitespace-nowrap inline-block text-[#DB6840]" data-ps="src/components/home/HouseSafetyLevels.astro:3b708c">Pflicht?</span>
      </h2>
      
      <p class="text-[17px] md:text-[21px] text-foreground font-normal leading-relaxed max-w-[750px] mx-auto" data-ps="src/components/home/HouseSafetyLevels.astro:subtitle">Die folgenden Räume vorgeschrieben sind und wo zusätzlicher Schutz sinnvoll ist.</p>
    </div>

    <div class="flex flex-col lg:flex-row items-center gap-12" data-ps="src/components/home/HouseSafetyLevels.astro:wrapper">
      
      <!-- Left: House Image (Interactive SVG) -->
      <div class="w-full lg:w-1/2 flex justify-center lg:justify-end" data-ps="src/components/home/HouseSafetyLevels.astro:image-box">
        <div class="house-svg-wrapper w-full max-w-[600px]" data-ps="src/components/home/HouseSafetyLevels.astro:house-img">
          <svg viewBox="0 0 1024 797" class="w-full h-auto block drop-shadow-md" aria-label="Haus Querschnitt mit Rauchmelder Pflicht- und Empfehlungsbereichen">
            <defs>
              <radialGradient id="a" cx=".38" cy=".13" r=".91">
                <stop stop-color="#fff"/>
                <stop offset=".43" stop-color="#fafafa"/>
                <stop offset=".73" stop-color="#ededed"/>
                <stop offset=".94" stop-color="#d9d9d9"/>
                <stop offset="1" stop-color="#c8c8c8"/>
              </radialGradient>
              <radialGradient id="b" cx=".45" cy=".24" r=".8">
                <stop stop-color="#fff"/>
                <stop offset=".52" stop-color="#fafafa"/>
                <stop offset=".82" stop-color="#e8e8e8"/>
                <stop offset="1" stop-color="#cecece"/>
              </radialGradient>
              <radialGradient id="c" cx=".43" cy=".22" r=".8">
                <stop stop-color="#fff"/>
                <stop offset=".67" stop-color="#f5f5f5"/>
                <stop offset="1" stop-color="#d7d7d7"/>
              </radialGradient>
              <linearGradient id="v" x2="0" y2="1">
                <stop stop-color="#050505"/>
                <stop offset=".5" stop-color="#161616"/>
                <stop offset="1" stop-color="#020202"/>
              </linearGradient>
              <radialGradient id="q" cx=".5" cy=".4">
                <stop stop-color="#f7ffaf"/>
                <stop offset=".2" stop-color="#baff32"/>
                <stop offset=".56" stop-color="#59cf00"/>
                <stop offset="1" stop-color="#163f08"/>
              </radialGradient>

              <!-- Smoke Detector Symbol -->
              <g id="d" transform="scale(.1) translate(-400 -400)">
                <path d="M82 245C82 141 221 69 400 69s318 72 318 176v171c0 137-145 241-318 241S82 553 82 416z" fill="url(#a)"/>
                <path d="M99 312c59-73 169-113 301-113s242 40 301 113" fill="none" stroke="#888" stroke-width="4" opacity=".42"/>
                <path d="M103 319c63-69 170-104 297-104s234 35 297 104" fill="none" stroke="#fff" stroke-width="6" opacity=".92"/>
                <ellipse cx="400" cy="466" rx="312" ry="191" fill="url(#b)"/>
                <ellipse cx="400" cy="470" rx="250" ry="132" fill="none" stroke="url(#v)" stroke-width="33"/>
                <g fill="#f1f1f1">
                  <path d="M392 329h16l4 89h-24zM203 383l14-10 52 65-18 13zM597 383l-14-10-52 65 18 13zM154 458l3-17 85 20-4 21zM646 458l-3-17-85 20 4 21zM222 552l-12-12 67-49 15 16zM578 552l12-12-67-49-15 16z"/>
                </g>
                <ellipse cx="400" cy="487" rx="215" ry="113" fill="#efefef"/>
                <ellipse cx="400" cy="493" rx="169" ry="78" fill="none" stroke="url(#v)" stroke-width="26"/>
                <g fill="#efefef">
                  <path d="M394 405h12l3 56h-18zM286 436l11-8 38 40-14 11zM514 436l-11-8-38 40 14 11zM252 493l2-13 55 11-3 16zM548 493l-2-13-55 11 3 16z"/>
                </g>
                <ellipse cx="400" cy="520" rx="147" ry="87" fill="url(#c)" stroke="#f8f8f8" stroke-width="9"/>
                <ellipse cx="400" cy="543" rx="89" ry="54" fill="url(#c)" stroke="#aaa" stroke-width="2.2"/>
                <rect x="357" y="323" width="86" height="31" rx="16" fill="#ededed" stroke="#777" stroke-width="3"/>
                <rect x="363" y="329" width="74" height="19" rx="10" fill="url(#q)"/>
                <ellipse cx="400" cy="333" rx="24" ry="4.3" fill="#fff" opacity=".66"/>
              </g>

              <!-- Modern Lamp -->
              <g id="lamp">
                <line x1="0" y1="-30" x2="0" y2="-6" stroke="#222" stroke-width="3"/>
                <path d="M-22 10 L-14 -6 L14 -6 L22 10 Z" fill="#f8fafc" stroke="#334155" stroke-width="3"/>
                <ellipse cx="0" cy="10" rx="22" ry="6" fill="#fef08a" opacity="0.9" stroke="#cbd5e1" stroke-width="1.5"/>
              </g>

              <!-- Modern Bed with colored frame, white sheets & pillows -->
              <g id="bed">
                <!-- Headboard -->
                <rect x="0" y="-22" width="22" height="42" rx="4" fill="#64748b" stroke="#334155" stroke-width="3"/>
                <!-- Bed frame -->
                <rect x="18" y="4" width="160" height="18" rx="2" fill="#94a3b8" stroke="#334155" stroke-width="3"/>
                <!-- Mattress & Blanket -->
                <rect x="22" y="-10" width="150" height="18" rx="4" fill="#f1f5f9" stroke="#cbd5e1" stroke-width="2"/>
                <!-- Duvet / Blanket -->
                <rect x="70" y="-10" width="102" height="18" rx="3" fill="#e2e8f0" stroke="#94a3b8" stroke-width="2"/>
                <!-- Pillows -->
                <rect x="28" y="-16" width="34" height="12" rx="3" fill="#ffffff" stroke="#94a3b8" stroke-width="2"/>
                <!-- Legs -->
                <rect x="6" y="20" width="8" height="10" fill="#334155"/>
                <rect x="166" y="20" width="8" height="10" fill="#334155"/>
              </g>

              <!-- Modern Door -->
              <g id="door">
                <rect x="0" y="0" width="52" height="112" fill="#f1f5f9" stroke="#334155" stroke-width="3.5" rx="2"/>
                <line x1="4" y1="6" x2="48" y2="6" stroke="#e2e8f0" stroke-width="2"/>
                <rect x="8" y="10" width="36" height="42" fill="#ffffff" stroke="#cbd5e1" stroke-width="2" rx="2"/>
                <rect x="8" y="58" width="36" height="44" fill="#ffffff" stroke="#cbd5e1" stroke-width="2" rx="2"/>
                <circle cx="12" cy="56" r="4" fill="#0f172a"/>
              </g>

              <!-- Modern Wardrobe / Schrank (Warm Wood / Brown) -->
              <g id="ward">
                <rect width="88" height="110" fill="#8d5b4c" stroke="#4a2e2b" stroke-width="3.5" rx="3"/>
                <line x1="44" y1="0" x2="44" y2="110" stroke="#4a2e2b" stroke-width="3"/>
                <rect x="8" y="12" width="28" height="86" fill="#a06a59" stroke="#6d4337" stroke-width="1.5" rx="2"/>
                <rect x="52" y="12" width="28" height="86" fill="#a06a59" stroke="#6d4337" stroke-width="1.5" rx="2"/>
                <circle cx="36" cy="58" r="3.5" fill="#fef08a"/>
                <circle cx="52" cy="58" r="3.5" fill="#fef08a"/>
                <rect x="6" y="110" width="10" height="6" fill="#4a2e2b"/>
                <rect x="72" y="110" width="10" height="6" fill="#4a2e2b"/>
              </g>
            </defs>

            <!-- House Structure -->
            <path d="M77 224 512 3 949 224 1013 258V783H11V258L77 224Z" fill="#1e293b"/>
            <!-- Roof / Dachboden -->
            <path d="M77 224 512 3 949 224Z" fill="#96b7b6" stroke="#080808" stroke-width="8"/>
            <!-- 1. OG Rooms -->
            <path d="M15 259 67 233h344v195H15Z" fill="#da6a41"/>
            <rect x="424" y="233" width="176" height="195" fill="#da6a41"/>
            <path d="M613 233h344l52 26v169H613Z" fill="#da6a41"/>
            <!-- Ground Floor Rooms -->
            <rect x="15" y="438" width="396" height="193" fill="#dc6a41"/>
            <rect x="424" y="438" width="176" height="193" fill="#f8fafc"/>
            <rect x="613" y="438" width="396" height="193" fill="#efb041"/>
            <!-- Basement / Keller -->
            <rect x="15" y="642" width="994" height="137" fill="#97b7b5"/>

            <!-- House Outer & Inner Borders -->
            <path d="M11 258 67 229h890l56 29v525H11Z" fill="none" stroke="#080808" stroke-width="8"/>
            <path d="M417 229v405M606 229v405M15 433h994M15 636h994" stroke="#080808" stroke-width="12"/>

            <!-- Smoke Detectors -->
            <use class="s" href="#d" x="512" y="97"/>
            <use class="s" href="#d" x="212" y="279"/>
            <use class="s" href="#d" x="512" y="279"/>
            <use class="s" href="#d" x="810" y="279"/>
            <use class="s" href="#d" x="212" y="486"/>
            <use class="s" href="#d" x="730" y="482"/>
            <use class="s" href="#d" x="512" y="696"/>

            <!-- Furniture Placements: 1st Floor -->
            <!-- Schlafzimmer (Left) -->
            <use href="#lamp" x="85" y="300"/>
            <use href="#bed" x="35" y="401"/>
            <use href="#door" x="352" y="315"/>

            <!-- Kinderzimmer (Right) -->
            <use href="#lamp" x="940" y="300"/>
            <use href="#bed" x="800" y="401"/>
            <use href="#ward" x="625" y="320"/>

            <!-- Furniture Placements: Ground Floor -->
            <!-- Wohnzimmer (Left) -->
            <use href="#lamp" x="85" y="500"/>
            <!-- Sofa & Sessel (Hellbraun) & Couchtisch (Braun) -->
            <g>
              <!-- Sessel / Armchair (Hellbraun / Caramel) -->
              <rect x="30" y="580" width="80" height="42" rx="6" fill="#d4a373" stroke="#8c5836" stroke-width="3"/>
              <rect x="36" y="568" width="68" height="24" rx="4" fill="#faedcd" stroke="#8c5836" stroke-width="2.5"/>
              <rect x="26" y="578" width="16" height="36" rx="4" fill="#c38e5d" stroke="#8c5836" stroke-width="2.5"/>
              <rect x="94" y="578" width="16" height="36" rx="4" fill="#c38e5d" stroke="#8c5836" stroke-width="2.5"/>
              <rect x="38" y="622" width="6" height="6" fill="#4a2e2b"/>
              <rect x="96" y="622" width="6" height="6" fill="#4a2e2b"/>

              <!-- Coffee Table (Braun / Holz) -->
              <rect x="144" y="594" width="74" height="12" rx="3" fill="#8d5b4c" stroke="#4a2e2b" stroke-width="3"/>
              <line x1="154" y1="606" x2="150" y2="626" stroke="#4a2e2b" stroke-width="3.5" stroke-linecap="round"/>
              <line x1="208" y1="606" x2="212" y2="626" stroke="#4a2e2b" stroke-width="3.5" stroke-linecap="round"/>

              <!-- Large Sofa (Hellbraun / Caramel) -->
              <rect x="236" y="580" width="158" height="42" rx="6" fill="#d4a373" stroke="#8c5836" stroke-width="3"/>
              <rect x="246" y="566" width="138" height="26" rx="4" fill="#faedcd" stroke="#8c5836" stroke-width="2.5"/>
              <line x1="315" y1="566" x2="315" y2="622" stroke="#8c5836" stroke-width="2"/>
              <rect x="230" y="578" width="16" height="36" rx="4" fill="#c38e5d" stroke="#8c5836" stroke-width="2.5"/>
              <rect x="384" y="578" width="16" height="36" rx="4" fill="#c38e5d" stroke="#8c5836" stroke-width="2.5"/>
              <rect x="244" y="622" width="6" height="6" fill="#4a2e2b"/>
              <rect x="376" y="622" width="6" height="6" fill="#4a2e2b"/>
            </g>

            <!-- Bad (Center) -->
            <g>
              <!-- Mirror & Cabinet -->
              <rect x="542" y="494" width="46" height="48" rx="4" fill="#ffffff" stroke="#334155" stroke-width="3"/>
              <line x1="550" y1="534" x2="578" y2="502" stroke="#93c5fd" stroke-width="2.5" stroke-linecap="round"/>
              <!-- Elegant Vanity & Washbasin -->
              <rect x="536" y="570" width="58" height="48" rx="4" fill="#f1f5f9" stroke="#334155" stroke-width="3"/>
              <line x1="565" y1="570" x2="565" y2="618" stroke="#cbd5e1" stroke-width="2"/>
              <circle cx="558" cy="592" r="2.5" fill="#334155"/>
              <circle cx="572" cy="592" r="2.5" fill="#334155"/>
              <ellipse cx="565" cy="564" rx="25" ry="10" fill="#ffffff" stroke="#334155" stroke-width="3"/>
              <ellipse cx="565" cy="565" rx="16" ry="6" fill="#e2e8f0" stroke="#cbd5e1" stroke-width="1.5"/>
              <!-- Tap / Armatur -->
              <path d="M565 546 v10" stroke="#64748b" stroke-width="3" stroke-linecap="round"/>
              <path d="M565 546 h-5" stroke="#64748b" stroke-width="3" stroke-linecap="round"/>

              <!-- Modern Toilet with Cistern & Flush Button -->
              <!-- Cistern / Spülkasten -->
              <rect x="438" y="534" width="26" height="54" rx="4" fill="#ffffff" stroke="#334155" stroke-width="3"/>
              <rect x="446" y="540" width="10" height="6" rx="2" fill="#cbd5e1" stroke="#64748b" stroke-width="1.5"/>
              <!-- Toilet Bowl -->
              <path d="M464 570 h28 c6 0 10 6 8 16 l-8 30 c-1 4-4 6-8 6 h-20 z" fill="#ffffff" stroke="#334155" stroke-width="3"/>
              <ellipse cx="480" cy="572" rx="16" ry="6" fill="#f1f5f9" stroke="#cbd5e1" stroke-width="2"/>
              <!-- Toilet Base -->
              <rect x="456" y="618" width="22" height="10" fill="#e2e8f0" stroke="#334155" stroke-width="2" rx="2"/>
            </g>

            <!-- Küche (Right) -->
            <g>
              <use href="#lamp" x="660" y="494"/>
              
              <!-- Stuhl 1 (Links vom Tisch) - Braun -->
              <g>
                <rect x="632" y="556" width="6" height="42" rx="2" fill="#8d5b4c" stroke="#4a2e2b" stroke-width="2"/>
                <rect x="632" y="586" width="24" height="6" rx="2" fill="#a06a59" stroke="#4a2e2b" stroke-width="2"/>
                <line x1="636" y1="592" x2="634" y2="626" stroke="#4a2e2b" stroke-width="2.5" stroke-linecap="round"/>
                <line x1="652" y1="592" x2="650" y2="626" stroke="#4a2e2b" stroke-width="2.5" stroke-linecap="round"/>
              </g>

              <!-- Kitchen Table (Braun) -->
              <rect x="664" y="584" width="84" height="12" rx="3" fill="#8d5b4c" stroke="#4a2e2b" stroke-width="3"/>
              <line x1="674" y1="596" x2="670" y2="626" stroke="#4a2e2b" stroke-width="3.5" stroke-linecap="round"/>
              <line x1="738" y1="596" x2="742" y2="626" stroke="#4a2e2b" stroke-width="3.5" stroke-linecap="round"/>

              <!-- Stuhl 2 (Rechts vom Tisch) - Braun -->
              <g>
                <rect x="756" y="556" width="6" height="42" rx="2" fill="#8d5b4c" stroke="#4a2e2b" stroke-width="2"/>
                <rect x="740" y="586" width="22" height="6" rx="2" fill="#a06a59" stroke="#4a2e2b" stroke-width="2"/>
                <line x1="744" y1="592" x2="746" y2="626" stroke="#4a2e2b" stroke-width="2.5" stroke-linecap="round"/>
                <line x1="758" y1="592" x2="760" y2="626" stroke="#4a2e2b" stroke-width="2.5" stroke-linecap="round"/>
              </g>

              <!-- Kitchen Units / Zeile -->
              <rect x="794" y="555" width="206" height="74" fill="#f8fafc" stroke="#334155" stroke-width="3.5" rx="2"/>
              <line x1="862" y1="555" x2="862" y2="629" stroke="#334155" stroke-width="3"/>
              <line x1="930" y1="555" x2="930" y2="629" stroke="#334155" stroke-width="3"/>
              <line x1="794" y1="575" x2="1000" y2="575" stroke="#e2e8f0" stroke-width="2"/>
              <!-- Oven & Stove -->
              <rect x="870" y="578" width="52" height="42" fill="#334155" rx="2"/>
              <circle cx="878" cy="564" r="4" fill="#334155"/>
              <circle cx="896" cy="564" r="4" fill="#334155"/>
              <circle cx="914" cy="564" r="4" fill="#334155"/>
              <!-- Upper Wall Cabinets -->
              <rect x="814" y="454" width="48" height="52" fill="#ffffff" stroke="#334155" stroke-width="3" rx="2"/>
              <rect x="936" y="454" width="48" height="52" fill="#ffffff" stroke="#334155" stroke-width="3" rx="2"/>
              <rect x="880" y="454" width="38" height="32" fill="#e2e8f0" stroke="#334155" stroke-width="2.5" rx="2"/>
              <!-- Extractor Hood -->
              <path d="M874 486 h50 l10 44 h-70 Z" fill="#94a3b8" stroke="#334155" stroke-width="3"/>
            </g>

            <!-- Room Labels with clear drop contrast -->
            <text x="512" y="190">Dachboden</text>
            <text x="218" y="345">Schlafzimmer</text>
            <text x="512" y="362">Flur</text>
            <text x="806" y="345">Kinderzimmer</text>
            <text x="220" y="540">Wohnzimmer</text>
            <text x="512" y="488" class="text-bad">Bad</text>
            <text x="730" y="545">Küche</text>
            <text x="512" y="765">Keller</text>
          </svg>
        </div>
      </div>

      <!-- Right: Legend List (Infoboxen) -->
      <div class="w-full lg:w-1/2 flex flex-col justify-center" data-ps="src/components/home/HouseSafetyLevels.astro:cards-box">
        <div class="pflicht-cards" data-ps="src/components/home/HouseSafetyLevels.astro:jgs6h1">

          <article class="pflicht-card pflicht" data-ps="src/components/home/HouseSafetyLevels.astro:card1">
            <div class="pflicht-icon" data-ps="src/components/home/HouseSafetyLevels.astro:c1-dot">
              <svg viewBox="0 0 64 64" aria-hidden="true">
                <path d="M32 8 50 16v14c0 12-7 21-18 26C21 51 14 42 14 30V16L32 8Z"/>
                <path d="m24 32 5 5 11-12"/>
              </svg>
            </div>

            <div class="pflicht-content" data-ps="src/components/home/HouseSafetyLevels.astro:c1-content">
              <h3 data-ps="src/components/home/HouseSafetyLevels.astro:c1-title">1. Pflicht</h3>
              <p data-ps="src/components/home/HouseSafetyLevels.astro:c1-body">
                Wohn-, Schlaf- und Kinderzimmer<br>
                sowie Flure als Rettungsweg.
              </p>
            </div>
          </article>


          <article class="pflicht-card zusatz" data-ps="src/components/home/HouseSafetyLevels.astro:card2">
            <div class="pflicht-icon" data-ps="src/components/home/HouseSafetyLevels.astro:c2-dot">
              <svg viewBox="0 0 64 64" aria-hidden="true">
                <path d="M22 18c-5 7 5 9 0 17"/>
                <path d="M32 18c-5 7 5 9 0 17"/>
                <path d="M42 18c-5 7 5 9 0 17"/>
                <path d="M20 43h24"/>
                <path d="M24 48h16"/>
              </svg>
            </div>

            <div class="pflicht-content" data-ps="src/components/home/HouseSafetyLevels.astro:c2-content">
              <h3 data-ps="src/components/home/HouseSafetyLevels.astro:c2-title">2. Zusätzlicher Schutz sinnvoll</h3>
              <p data-ps="src/components/home/HouseSafetyLevels.astro:c2-body">
                <strong>Küche:</strong> je nach Situation kann ein<br>
                geeigneter Wärmemelder sinnvoll sein.
              </p>
            </div>
          </article>


          <article class="pflicht-card keine" data-ps="src/components/home/HouseSafetyLevels.astro:card3">
            <div class="pflicht-icon" data-ps="src/components/home/HouseSafetyLevels.astro:c3-dot">
              <svg viewBox="0 0 64 64" aria-hidden="true">
                <path d="M12 31 32 14l20 17"/>
                <path d="M18 28v22h28V28"/>
                <path d="M27 50V36h10v14"/>
              </svg>
            </div>

            <div class="pflicht-content" data-ps="src/components/home/HouseSafetyLevels.astro:c3-content">
              <h3 data-ps="src/components/home/HouseSafetyLevels.astro:c3-title">3. Keine generelle Pflicht</h3>
              <p data-ps="src/components/home/HouseSafetyLevels.astro:c3-body">
                <strong>Keller und Dachboden,</strong> sofern dort<br>
                keine Aufenthaltsräume vorhanden sind.
              </p>
            </div>
          </article>

        </div>
      </div>
    </div>
  </Container>
</section>

<style>
.house-svg-wrapper svg {
  display: block;
  width: 100%;
  height: auto;
}
.house-svg-wrapper .l {
  fill: none;
  stroke: #0a0a0a;
  stroke-width: 5;
  stroke-linecap: round;
  stroke-linejoin: round;
}
.house-svg-wrapper text {
  font-family: Arial, sans-serif;
  font-weight: 800;
  font-size: 32px;
  fill: #fff;
  stroke: none;
  text-anchor: middle;
}
.house-svg-wrapper text.text-bad {
  fill: #0f172a;
}
.house-svg-wrapper .s {
  transform-box: fill-box;
  transform-origin: center;
  transition: transform .18s ease, filter .18s ease;
  cursor: pointer;
}
.house-svg-wrapper .s:hover {
  transform: scale(1.07);
  filter: brightness(1.04);
}

.pflicht-cards{
  max-width:760px;
  width: 100%;
  margin:0 auto;
  display:flex;
  flex-direction:column;
  gap:20px;
  padding:0;
}

.pflicht-card{
  display:grid;
  grid-template-columns:92px 1fr;
  align-items:center;
  gap:24px;

  min-height:140px;
  padding:24px 28px;

  background:#fff;
  border-radius:22px;

  box-shadow:
    0 10px 30px rgba(8,32,72,.08),
    0 2px 8px rgba(8,32,72,.04);

  border:1px solid rgba(16,43,79,.04);
}

.pflicht-icon{
  width:80px;
  height:80px;

  display:grid;
  place-items:center;

  border-radius:50%;

  color:#fff;

  box-shadow:
    inset 0 0 20px rgba(255,255,255,.15),
    0 8px 20px rgba(0,0,0,.08);
}

.pflicht-icon svg{
  width:44px;
  height:44px;

  fill:none;
  stroke:currentColor;
