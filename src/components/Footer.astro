---
import Container from '@/components/Container.astro';
import { SITE } from '@/config/site';

const year = new Date().getFullYear();

const linkClass = 'text-[14px] text-dark-muted-foreground no-underline hover:text-white transition-colors';
---

<footer class="bg-dark-background text-dark-foreground" data-ps="src/components/Footer.astro:footer">
  <Container class="py-14 md:py-16">
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-10" data-ps="src/components/Footer.astro:grid">
      <!-- Spalte 1: Kurztext -->
      <div class="lg:col-span-1 flex flex-col gap-4" data-ps="src/components/Footer.astro:brand">
        <p class="text-[14px] text-dark-muted-foreground leading-relaxed" data-ps="src/components/Footer.astro:euon">Rauchmelder-Service für Vermieter, Eigentümer und Hausverwaltungen in Berlin und Umland.
<br/>
<br/>Rechtliche Angaben dienen der allgemeinen Information und ersetzen keine Rechtsberatung.</p>
      </div>

      <!-- Spalte 2: Leistungen -->
      <nav aria-label="Leistungen" data-ps="src/components/Footer.astro:col-services">
        <h2 class="text-[15px] font-bold text-white mb-5" data-ps="src/components/Footer.astro:f0091d">Leistungen</h2>
        <ul class="flex flex-col gap-3">
          <li data-ps="src/components/Footer.astro:wyji5o"><a href="/#wartung" class={linkClass} data-ps="src/components/Footer.astro:7gqbzr">Prüfung und Wartung</a></li>
          <li data-ps="src/components/Footer.astro:wyji5p"><a href="/#installation" class={linkClass} data-ps="src/components/Footer.astro:7gqc0d">Installation und Austausch</a></li>
          <li data-ps="src/components/Footer.astro:wyji5q"><a href="/#qualitaet" class={linkClass} data-ps="src/components/Footer.astro:7gqc0e">Ferninspektion</a></li>
          <li data-ps="src/components/Footer.astro:wyji5r"><a href="/#nachweis" class={linkClass} data-ps="src/components/Footer.astro:7gqc0f">Dokumentation</a></li>
          <li data-ps="src/components/Footer.astro:wyji5s"><a href="/#leistungen" class={linkClass} data-ps="src/components/Footer.astro:7gqc0g">Lösungen für Hausverwaltungen</a></li>
        </ul>
      </nav>

      <!-- Spalte 3: Unternehmen -->
      <nav aria-label="Unternehmen" data-ps="src/components/Footer.astro:col-company">
        <h2 class="text-[15px] font-bold text-white mb-5" data-ps="src/components/Footer.astro:f0091c">Unternehmen</h2>
        <ul class="flex flex-col gap-3">
          <li data-ps="src/components/Footer.astro:wyji6e"><a href="/#ansprechpartner" class={linkClass} data-ps="src/components/Footer.astro:7gqc0h">Über uns</a></li>
          <li data-ps="src/components/Footer.astro:wyji6f"><a href="/#ablauf" class={linkClass} data-ps="src/components/Footer.astro:7gqc0i">Ablauf</a></li>
          <li data-ps="src/components/Footer.astro:wyji6g"><a href="/#bewertungen" class={linkClass} data-ps="src/components/Footer.astro:7gqc0j">Bewertungen</a></li>
          <li data-ps="src/components/Footer.astro:wyji6h"><a href="/#faq" class={linkClass} data-ps="src/components/Footer.astro:7gqc0k">FAQ</a></li>
          <li data-ps="src/components/Footer.astro:wyji6i"><a href="/#anfrage" class={linkClass} data-ps="src/components/Footer.astro:7gqc0l">Kontakt</a></li>
        </ul>
      </nav>

      <!-- Spalte 4: Rechtliches -->
      <nav aria-label="Rechtliches" data-ps="src/components/Footer.astro:col-legal">
        <h2 class="text-[15px] font-bold text-white mb-5" data-ps="src/components/Footer.astro:f0091b">Rechtliches</h2>
        <ul class="flex flex-col gap-3">
          <li data-ps="src/components/Footer.astro:wyji6j"><a href="/impressum/" class={linkClass} data-ps="src/components/Footer.astro:hzwfpi">Impressum</a></li>
          <li data-ps="src/components/Footer.astro:wyji6k"><a href="/datenschutzerklaerung/" class={linkClass} data-ps="src/components/Footer.astro:hzwfph">Datenschutz</a></li>
        </ul>
      </nav>

      <!-- Spalte 5: Kontakt -->
      <div data-ps="src/components/Footer.astro:col-contact">
        <h2 class="text-[15px] font-bold text-white mb-5" data-ps="src/components/Footer.astro:f0091a">Kontakt</h2>
        <ul class="flex flex-col gap-3">
          <li data-ps="src/components/Footer.astro:wyji6l"><a href="tel:+493092105026" class={linkClass} data-ps="src/components/Footer.astro:7gqc0m">030 9210 5026</a></li>
          {/* TODO: Geschäftliche E-Mail-Adresse ergänzen, sobald bestätigt. */}
          <li data-ps="src/components/Footer.astro:wyji6m"><span class="text-[14px] text-dark-muted-foreground" data-ps="src/components/Footer.astro:hzwfpg">Berlin und Umland</span></li>
        </ul>
      </div>
    </div>
  </Container>

  <div class="border-t border-dark-border" data-ps="src/components/Footer.astro:bottom">
    <Container class="py-6">
      <p class="text-[13px] text-dark-muted-foreground text-center" data-ps="src/components/Footer.astro:euoo">© {year} MESSKLAR Rauchmelderservice. Alle Rechte vorbehalten.</p>
    </Container>
  </div>
</footer>
