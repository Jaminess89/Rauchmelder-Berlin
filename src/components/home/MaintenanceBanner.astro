---
import Container from '@/components/Container.astro';
---

<section class="pb-12 bg-[#3F789E] md:pb-[55px]" data-ps="src/components/home/MaintenanceBanner.astro:root">
  <Container>
    <!-- CTA Box -->
    <div class="w-full rounded-[22px] border border-[#06264A] bg-gradient-to-r from-[#031526] via-[#061E38] to-[#031526] p-[32px] md:p-[48px] xl:py-[40px] xl:px-[56px] flex flex-col xl:flex-row items-center gap-10 xl:gap-[56px] relative overflow-hidden text-white shadow-2xl md:mt-[-28px]" data-ps="src/components/home/MaintenanceBanner.astro:card">
      
      <!-- Decorative Glows -->
      <div class="absolute inset-0 pointer-events-none rounded-[22px] overflow-hidden" data-ps="src/components/home/MaintenanceBanner.astro:cta-glows">
        <div class="absolute -left-[10%] -top-[30%] w-[50%] h-[160%] bg-[#1878B9] opacity-20 blur-[100px]" data-ps="src/components/home/MaintenanceBanner.astro:lltjuy"></div>
        <div class="absolute -right-[10%] -bottom-[20%] w-[40%] h-[140%] bg-[#36A90B] opacity-10 blur-[90px]" data-ps="src/components/home/MaintenanceBanner.astro:lltjuz"></div>
        <div class="absolute left-[30%] top-[0] w-full h-[1px] bg-gradient-to-r from-transparent via-[#1878B9]/40 to-transparent" data-ps="src/components/home/MaintenanceBanner.astro:lltjv0"></div>
      </div>

      <div class="flex flex-col md:flex-row items-center text-center md:text-left gap-8 xl:gap-[40px] flex-1 relative z-10" data-ps="src/components/home/MaintenanceBanner.astro:cta-content">
        <!-- Giant Custom Icon imitating 3D doc -->
        <div class="w-[140px] h-[140px] md:w-[160px] md:h-[160px] rounded-full bg-gradient-to-b from-[#1878B9]/20 to-transparent flex items-center justify-center shrink-0 border border-[#1878B9]/30 relative shadow-[0_0_40px_rgba(24,120,185,0.25)]" data-ps="src/components/home/MaintenanceBanner.astro:cta-icon-bg">
          <div class="absolute inset-0 bg-[#1878B9] blur-[25px] opacity-25 rounded-full" data-ps="src/components/home/MaintenanceBanner.astro:lltjv1"></div>
          
          <svg class="w-16 h-16 md:w-20 md:h-20 text-[#EEF6FD] relative z-10 drop-shadow-[0_0_15px_rgba(238,246,253,0.5)]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/>
            <path d="M14 2v6h6"/>
            <path d="M16 13H8"/>
            <path d="M16 17H8"/>
            <path d="M10 9H8"/>
          </svg>
          
          <!-- Euro badge overlay -->
          <div class="absolute -bottom-1 -right-1 md:-bottom-2 md:-right-2 w-[60px] h-[60px] md:w-[70px] md:h-[70px] bg-gradient-to-br from-[#1878B9] to-[#083E66] rounded-full flex items-center justify-center border-[3px] border-[#031526] shadow-[0_5px_15px_rgba(0,0,0,0.6)] z-20" data-ps="src/components/home/MaintenanceBanner.astro:lltjv2">
            <svg class="w-7 h-7 md:w-8 md:h-8 text-white drop-shadow-[0_0_8px_rgba(255,255,255,0.6)]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M4 10h12"/><path d="M4 14h9"/><path d="M19 6a7.7 7.7 0 0 0-5.2-2A7.9 7.9 0 0 0 6 12c0 4.4 3.5 8 7.8 8 2 0 3.8-.8 5.2-2"/></svg>
          </div>
        </div>

        <div data-ps="src/components/home/MaintenanceBanner.astro:cta-text">
          <h3 class="text-[26px] md:text-[34px] font-[800] text-white leading-[1.2] mb-4 max-w-[530px] mx-auto md:mx-0" data-ps="src/components/home/MaintenanceBanner.astro:833gj2">
            Ihr Kostenrahmen in kurzer Zeit
          </h3>
          <p class="text-[17px] md:text-[19px] text-[#A6BCD6] leading-[1.6] max-w-[600px] mx-auto md:mx-0 font-medium" data-ps="src/components/home/MaintenanceBanner.astro:g4rgi3">Senden Sie uns die wichtigsten Daten, wir prüfen Ihr Objekt persönlich.</p>
        </div>
      </div>

      <div class="w-full xl:w-[420px] shrink-0 relative z-10 flex flex-col items-center xl:items-end" data-ps="src/components/home/MaintenanceBanner.astro:cta-action">
        <a href="#ersteinschaetzung" class="w-full h-[72px] bg-gradient-to-r from-[#49B90C] to-[#2E9E08] rounded-[18px] flex items-center justify-center gap-3 text-white text-[19px] sm:text-[21px] md:text-[22px] font-[800] shadow-[0_8px_20px_rgba(50,150,10,0.3)] hover:-translate-y-[2px] hover:shadow-[0_12px_25px_rgba(50,150,10,0.4)] transition-all duration-300 ring-offset-2 hover:ring-2 ring-[#49B90C] ring-offset-[#031526] text-center px-4" data-ps="src/components/home/MaintenanceBanner.astro:cta-button">
          Kosten-Check starten &rarr;
        </a>
        <div class="mt-2.5 text-xs text-[#A6BCD6] font-medium text-center xl:text-right" data-ps="src/components/home/MaintenanceBanner.astro:phone-alt">
          <span class="text-white/80" data-ps="src/components/home/MaintenanceBanner.astro:rso1ox">Oder direkt anrufen:</span> <a href="tel:+493092105026" class="text-white hover:text-[#8CC63F] font-bold underline transition-colors" data-ps="src/components/home/MaintenanceBanner.astro:phone-alt-link">030 9210 5026</a>
        </div>
        <div class="flex items-center flex-wrap justify-center xl:justify-end gap-5 mt-4 text-[14px] md:text-[15px] text-[#A6BCD6] font-medium" data-ps="src/components/home/MaintenanceBanner.astro:cta-features">
          <div class="flex items-center gap-1.5" data-ps="src/components/home/MaintenanceBanner.astro:2ywtad">
            <svg class="w-4 h-4 text-white" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><rect width="18" height="11" x="3" y="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
            Unverbindlich
          </div>
          <div class="flex items-center gap-1.5" data-ps="src/components/home/MaintenanceBanner.astro:3g5le">
            <svg class="w-4 h-4 text-white" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><polyline points="16 11 18 13 22 9"/></svg>
            Persönlich geprüft
          </div>
          <div class="flex items-center gap-1.5" data-ps="src/components/home/MaintenanceBanner.astro:3g5lc">
            <svg class="w-4 h-4 text-white" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/></svg>
            Schnelle Rückmeldung
          </div>
        </div>
      </div>

    </div>
  </Container>
</section>
