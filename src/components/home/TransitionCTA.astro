---
import Container from '@/components/Container.astro';
---

<section class="py-10 md:py-14 bg-white md:pb-[55px] md:pt-[35px]" data-ps="src/components/home/TransitionCTA.astro:section">
  <Container>
    <!-- CTA Box -->
    <div class="w-full max-w-5xl mx-auto bg-black rounded-[24px] overflow-hidden flex flex-col md:flex-row items-stretch min-h-[220px] relative shadow-xl" data-ps="src/components/home/TransitionCTA.astro:cta-box">
      
      <!-- Content side -->
      <div class="flex-1 p-8 md:p-10 flex flex-col md:flex-row items-center gap-8 z-10 md:pl-10 md:mt-0 md:mr-[102px]" data-ps="src/components/home/TransitionCTA.astro:content">
        
        <!-- Icon -->
        <div class="shrink-0 md:w-20" data-ps="src/components/home/TransitionCTA.astro:icon-box">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-16 h-16 md:w-20 md:h-20 text-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
            <path d="m9 12 2 2 4-4"/>
          </svg>
        </div>

        <!-- Text -->
        <div class="flex-1 flex flex-col gap-1 text-center md:text-left" data-ps="src/components/home/TransitionCTA.astro:text">
          <h2 class="text-white text-[24px] font-black leading-[1.2] max-w-[450px] md:text-[22px]" data-ps="src/components/home/TransitionCTA.astro:heading">Schließen Sie Ihre Nachweislücke jetzt</h2>
          <p class="text-white/80 text-[16px] md:text-lg" data-ps="src/components/home/TransitionCTA.astro:subhead">
            Jetzt unverbindlich anfragen.
          </p>
          
          <div class="mt-4 flex flex-col items-center md:items-start" data-ps="src/components/home/TransitionCTA.astro:cta">
            <a href="#ersteinschaetzung" class="inline-flex items-center justify-center px-8 py-3 bg-primary hover:bg-primary-hover text-white font-bold rounded-lg transition-colors" data-ps="src/components/home/TransitionCTA.astro:5zd0m2">Kosten-Check starten &rarr;</a>
            <div class="mt-2 text-xs text-white/80 font-medium" data-ps="src/components/home/TransitionCTA.astro:phone-alt">
              <span data-ps="src/components/home/TransitionCTA.astro:3g5l6">Oder direkt anrufen:</span> <a href="tel:+493092105026" class="text-white hover:text-primary font-bold underline transition-colors" data-ps="src/components/home/TransitionCTA.astro:phone-alt-link">030 9210 5026</a>
            </div>
          </div>
        </div>
      </div>

      <!-- Image side (Clipboard) -->
      <div class="relative w-full md:w-[35%] min-h-[200px] md:min-h-full overflow-hidden [mask-image:linear-gradient(to_bottom,transparent,black_15%)] md:[mask-image:linear-gradient(to_right,transparent,black_20%)] md:-ml-[45px]" data-ps="src/components/home/TransitionCTA.astro:image-box">
        <img 
          src="https://pagesmith-cdn.com/2be62e80/images/Protokoll-ubergabe-Bild-640.webp" 
          alt="Wartungsprotokoll Dokumentation" 
          class="absolute inset-0 w-full h-full object-cover object-center md:object-right-top scale-110 md:scale-125 origin-right md:mb-0 md:w-[364px] md:h-[233px] md:ml-20 md:mt-[30px]"
          loading="lazy" data-ps="src/components/home/TransitionCTA.astro:pd4pel" />
        <!-- Gradient overlay to blend with dark side on mobile -->
        <div class="absolute inset-0 bg-gradient-to-t from-black via-transparent to-transparent md:hidden" data-ps="src/components/home/TransitionCTA.astro:overlay"></div>
      </div>

    </div>
  </Container>
</section>
