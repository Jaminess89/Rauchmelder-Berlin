---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Hero from '@/components/home/Hero.astro';
import TrustBanner from '@/components/home/TrustBanner.astro';
import SmokeAlarmServices from '@/components/home/SmokeAlarmServices.astro';
import SplitHero from '@/components/home/SplitHero.astro';
import FineWarning from '@/components/home/FineWarning.astro';
import LegalConsequences from '@/components/home/LegalConsequences.astro';
import SolutionProcess from '@/components/home/SolutionProcess.astro';
import MaintenanceBanner from '@/components/home/MaintenanceBanner.astro';
import LandlordCosts from '@/components/home/LandlordCosts.astro';
import StepProcess from '@/components/home/StepProcess.astro';
import SmokeAlarmLacks from '@/components/home/SmokeAlarmLacks.astro';
import SmokeAlarmChecklist from '@/components/home/SmokeAlarmChecklist.astro';
import TransitionCTA from '@/components/home/TransitionCTA.astro';
import PropertyManagerBenefits from '@/components/home/PropertyManagerBenefits.astro';
import ResidentCoordination from '@/components/home/ResidentCoordination.astro';
import RemoteInspectionComparison from '@/components/home/RemoteInspectionComparison.astro';
import SmokeDetectorQuality from '@/components/home/SmokeDetectorQuality.astro';
import DigitalReportPreview from '@/components/home/DigitalReportPreview.astro';
import TransparentPricing from '@/components/home/TransparentPricing.astro';
import CaseStudy from '@/components/home/CaseStudy.astro';
import Testimonials from '@/components/home/Testimonials.astro';
import ContactPerson from '@/components/home/ContactPerson.astro';
import FAQSection from '@/components/home/FAQSection.astro';
import ObjectInquiryForm from '@/components/home/ObjectInquiryForm.astro';
import ServiceArea from '@/components/home/ServiceArea.astro';
import { SITE } from '@/config/site';

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "LocalBusiness",
  "name": SITE.name,
  "description": SITE.description,
  "url": SITE.url,
  "telephone": "+4915735981964",
  "address": {
    "@type": "PostalAddress",
    "streetAddress": "Musterstraße 1",
    "addressLocality": "Berlin",
    "postalCode": "10115",
    "addressCountry": "DE"
  },
  "openingHours": "Mo-Su 00:00-24:00"
};
---

<BaseLayout 
  title={SITE.title}
  description={SITE.description}
  jsonLd={jsonLd}
>
  <Hero />
  <TrustBanner />
  <section class="py-16 bg-[#3F789E]" data-ps="src/pages/index.astro:fur-wen">
    <div class="max-w-[1200px] mx-auto px-4" data-ps="src/pages/index.astro:2b7xns">
      <h2 class="text-white text-center text-3xl md:text-[40px] font-bold mb-4 tracking-tight" data-ps="src/pages/index.astro:fw-h2">Wem wir helfen:</h2>
      <div class="w-[60px] h-[3px] bg-[#8CC63F] mx-auto mb-12" data-ps="src/pages/index.astro:fw-line"></div>
      
      <div class="grid grid-cols-2 md:grid-cols-5 gap-3 md:gap-4 lg:gap-5" data-ps="src/pages/index.astro:fw-grid">
        <!-- Item 1 -->
        <div class="bg-white rounded-[16px] md:rounded-[20px] shadow-lg p-3 md:p-4 lg:p-5 flex flex-col items-center justify-center aspect-[1/1.1] md:aspect-[4/5] hover:shadow-xl hover:-translate-y-1 transition-all duration-300 w-full" data-ps="src/pages/index.astro:fw-item1">
          <img src="https://pagesmith-cdn.com/2be62e80/images/Vermieter-Top-section-Bild-250-250.webp" alt="Vermieter" class="h-[40%] md:h-[35%] w-auto object-contain mb-3 md:mb-5" data-ps="src/pages/index.astro:fw-icon1" />
          <span class="text-[#133A6B] font-extrabold text-[12px] min-[380px]:text-[14px] sm:text-[15px] md:text-[12px] lg:text-[14px] xl:text-[16px] leading-tight text-center break-words w-full px-1" style="hyphens: auto;" data-ps="src/pages/index.astro:fw-text1">Vermieter</span>
        </div>
        
        <!-- Item 2 -->
        <div class="bg-white rounded-[16px] md:rounded-[20px] shadow-lg p-3 md:p-4 lg:p-5 flex flex-col items-center justify-center aspect-[1/1.1] md:aspect-[4/5] hover:shadow-xl hover:-translate-y-1 transition-all duration-300 w-full" data-ps="src/pages/index.astro:fw-item2">
          <img src="https://pagesmith-cdn.com/2be62e80/images/Eigentumer-Top-section-Bild-276-276.webp" alt="Eigentümer" class="h-[40%] md:h-[35%] w-auto object-contain mb-3 md:mb-5" data-ps="src/pages/index.astro:fw-icon2" />
          <span class="text-[#133A6B] font-extrabold text-[12px] min-[380px]:text-[14px] sm:text-[15px] md:text-[12px] lg:text-[14px] xl:text-[16px] leading-tight text-center break-words w-full px-1" style="hyphens: auto;" data-ps="src/pages/index.astro:fw-text2">Eigentümer</span>
        </div>

        <!-- Item 3 -->
        <div class="bg-white rounded-[16px] md:rounded-[20px] shadow-lg p-3 md:p-4 lg:p-5 flex flex-col items-center justify-center aspect-[1/1.1] md:aspect-[4/5] hover:shadow-xl hover:-translate-y-1 transition-all duration-300 w-full" data-ps="src/pages/index.astro:fw-item3">
          <img src="https://pagesmith-cdn.com/2be62e80/images/HausverwaltungTop-section-Bild-318-318.webp" alt="Hausverwaltungen" class="h-[40%] md:h-[35%] w-auto object-contain mb-3 md:mb-5" data-ps="src/pages/index.astro:fw-icon3" />
          <span class="text-[#133A6B] font-extrabold text-[12px] min-[380px]:text-[14px] sm:text-[15px] md:text-[12px] lg:text-[14px] xl:text-[16px] leading-tight text-center break-words w-full px-1" style="hyphens: auto;" data-ps="src/pages/index.astro:fw-text3">Hausverwaltungen</span>
        </div>

        <!-- Item 4 -->
        <div class="bg-white rounded-[16px] md:rounded-[20px] shadow-lg p-3 md:p-4 lg:p-5 flex flex-col items-center justify-center aspect-[1/1.1] md:aspect-[4/5] hover:shadow-xl hover:-translate-y-1 transition-all duration-300 w-full" data-ps="src/pages/index.astro:fw-item4">
          <img src="https://pagesmith-cdn.com/2be62e80/images/Gewerbe-Top-section-Bild-276-276.webp" alt="Gewerbekunden" class="h-[40%] md:h-[35%] w-auto object-contain mb-3 md:mb-5" data-ps="src/pages/index.astro:fw-icon4" />
          <span class="text-[#133A6B] font-extrabold text-[12px] min-[380px]:text-[14px] sm:text-[15px] md:text-[12px] lg:text-[14px] xl:text-[16px] leading-tight text-center break-words w-full px-1" style="hyphens: auto;" data-ps="src/pages/index.astro:fw-text4">Gewerbekunden</span>
        </div>

        <!-- Item 5 -->
        <div class="col-span-2 md:col-span-1 flex justify-center w-full" data-ps="src/pages/index.astro:2b7xns">
          <div class="bg-white rounded-[16px] md:rounded-[20px] shadow-lg p-3 md:p-4 lg:p-5 flex flex-col items-center justify-center aspect-[1/1.1] md:aspect-[4/5] hover:shadow-xl hover:-translate-y-1 transition-all duration-300 w-[calc(50%-0.375rem)] md:w-full" data-ps="src/pages/index.astro:fw-item5">
            <img src="https://pagesmith-cdn.com/2be62e80/images/Wohnungsunternehmen-Top-section-Bild-320.webp" alt="Wohnungsunternehmen" class="h-[40%] md:h-[35%] w-auto object-contain mb-3 md:mb-5" data-ps="src/pages/index.astro:fw-icon5" />
            <span class="text-[#133A6B] font-extrabold text-[11px] min-[380px]:text-[13px] sm:text-[14px] md:text-[11px] lg:text-[13px] xl:text-[15px] leading-tight text-center break-words w-full px-1" style="hyphens: auto;" data-ps="src/pages/index.astro:fw-text5">Wohnungs&shy;unternehmen</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <div class="bg-[#3F789E] w-full pt-12 pb-4 flex justify-center items-center overflow-hidden md:pb-0 md:pt-[35px]" data-ps="src/pages/index.astro:2b7xns">
    <div class="flex items-center gap-4 md:gap-6" data-ps="src/pages/index.astro:v8j2m1">
      <!-- Green Checkbox Icon -->
      <svg xmlns="http://www.w3.org/2000/svg" class="w-12 h-12 md:w-[72px] md:h-[72px] shrink-0" viewBox="0 0 100 100" fill="none" data-ps="src/pages/index.astro:z4x1r5">
        <defs>
          <linearGradient id="checkGrad" x1="0%" y1="0%" x2="0%" y2="100%">
            <stop offset="0%" stop-color="#97D046" />
            <stop offset="100%" stop-color="#4B9511" />
          </linearGradient>
          <filter id="iconShadow" x="-10%" y="-10%" width="120%" height="120%">
            <feDropShadow dx="0" dy="2" stdDeviation="2" flood-opacity="0.3"/>
          </filter>
        </defs>
        <rect x="15" y="25" width="55" height="55" rx="6" stroke="url(#checkGrad)" stroke-width="8" fill="none" filter="url(#iconShadow)"/>
        <path d="M 28 53 L 45 69 L 92 12" stroke="url(#checkGrad)" stroke-width="11" stroke-linecap="round" stroke-linejoin="round" fill="none" filter="url(#iconShadow)"/>
      </svg>
      
      <!-- Text -->
      <h4 class="text-white font-black m-0 tracking-[-0.02em] leading-none md:h-11 md:pl-0 md:pr-0 md:ml-[-17px] md:text-[px] md:text-[40px] text-[33px]" data-ps="src/pages/index.astro:gpk8hd">
        So helfen wir:
      </h4>
    </div>
  </div>
  <SmokeAlarmServices />
  <SplitHero />
  <FineWarning />
  <LegalConsequences />
  <SolutionProcess />
  <MaintenanceBanner />
  <LandlordCosts />
  <StepProcess />
  <SmokeAlarmLacks />
  <SmokeAlarmChecklist />

  <!-- Einfügepunkt: Neue Normcheck-Sektionen (alles oberhalb bleibt unverändert) -->
  <TransitionCTA />
  <div id="leistungen" class="scroll-mt-24">
    <PropertyManagerBenefits />
  </div>
  <ResidentCoordination />
  <RemoteInspectionComparison />
  <SmokeDetectorQuality />
  <div id="ablauf" class="scroll-mt-24">
    <DigitalReportPreview />
  </div>
  <TransparentPricing />
  <CaseStudy />
  <div id="bewertungen" class="scroll-mt-24">
    <Testimonials />
  </div>
  <div id="ansprechpartner" class="scroll-mt-24">
    <ContactPerson />
  </div>
  <div id="faq" class="scroll-mt-24">
    <FAQSection />
  </div>
  <ObjectInquiryForm />
  <ServiceArea />
</BaseLayout>

