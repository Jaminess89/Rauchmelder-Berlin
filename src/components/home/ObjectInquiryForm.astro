---
import Container from '@/components/Container.astro';

const inputClass = 'w-full rounded-xl border border-gray-300 bg-white px-4 py-3.5 text-[15px] text-gray-800 placeholder:text-gray-400 focus:border-[#25b94b] focus:ring-2 focus:ring-[#8CC63F]/30 focus:outline-none transition-all';
---

<section id="anfrage" class="py-16 md:py-24 bg-[#EDF3F8] scroll-mt-24" data-ps="src/components/home/ObjectInquiryForm.astro:section">
  <Container>
    <!-- Sektions-Kopf -->
    <div class="text-center max-w-2xl mx-auto mb-10 md:mb-12" data-ps="src/components/home/ObjectInquiryForm.astro:header">
      <h2 class="text-2xl sm:text-3xl md:text-4xl lg:text-[40px] font-black text-[#133A6B] tracking-tight mb-3.5 leading-tight" data-ps="src/components/home/ObjectInquiryForm.astro:title">
        Lieber einfach kurz schreiben?
      </h2>
      <p class="text-base sm:text-lg text-[#53627D] leading-relaxed max-w-xl mx-auto" data-ps="src/components/home/ObjectInquiryForm.astro:subtitle">
        Hinterlassen Sie Ihre Kontaktdaten. Wir melden uns persönlich bei Ihnen.
      </p>
    </div>

    <!-- Mittig platzierte Formular-Karte (ca. 760–850px breit) -->
    <div class="max-w-[780px] mx-auto bg-white rounded-3xl p-6 sm:p-8 md:p-10 shadow-[0_10px_35px_rgba(11,38,65,0.08)] border border-[#DDE5EC]" data-ps="src/components/home/ObjectInquiryForm.astro:form-card">
      
      <!-- Formular -->
      <form id="direct-contact-form" novalidate data-ps="src/components/home/ObjectInquiryForm.astro:form" class="flex flex-col gap-5">
        
        <!-- 1. Name -->
        <div data-ps="src/components/home/ObjectInquiryForm.astro:field-name">
          <label for="direct-name" class="block text-sm font-bold text-[#133A6B] mb-1.5" data-ps="src/components/home/ObjectInquiryForm.astro:label-name">
            Name <span class="text-red-500" data-ps="src/components/home/ObjectInquiryForm.astro:req-name">*</span>
          </label>
          <input 
            type="text" 
            id="direct-name" 
            name="name" 
            required 
            autocomplete="name"
            placeholder="z. B. Max Mustermann" 
            class={inputClass}
            data-ps="src/components/home/ObjectInquiryForm.astro:input-name"
          />
        </div>

        <!-- 2. Zwei Spalten: E-Mail & Telefonnummer (optional) -->
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-5" data-ps="src/components/home/ObjectInquiryForm.astro:contact-row">
          <div data-ps="src/components/home/ObjectInquiryForm.astro:field-email">
            <label for="direct-email" class="block text-sm font-bold text-[#133A6B] mb-1.5" data-ps="src/components/home/ObjectInquiryForm.astro:label-email">
              E-Mail <span class="text-red-500" data-ps="src/components/home/ObjectInquiryForm.astro:req-email">*</span>
            </label>
            <input 
              type="email" 
              id="direct-email" 
              name="email" 
              required 
              autocomplete="email"
              placeholder="z. B. name@beispiel.de" 
              class={inputClass}
              data-ps="src/components/home/ObjectInquiryForm.astro:input-email"
            />
          </div>

          <div data-ps="src/components/home/ObjectInquiryForm.astro:field-phone">
            <label for="direct-phone" class="block text-sm font-bold text-[#133A6B] mb-1.5" data-ps="src/components/home/ObjectInquiryForm.astro:label-phone">
              Telefonnummer <span class="text-gray-400 font-normal text-xs" data-ps="src/components/home/ObjectInquiryForm.astro:opt-phone">(optional)</span>
            </label>
            <input 
              type="tel" 
              id="direct-phone" 
              name="phone" 
              autocomplete="tel"
              placeholder="z. B. 0157 12345678" 
              class={inputClass}
              data-ps="src/components/home/ObjectInquiryForm.astro:input-phone"
            />
          </div>
        </div>

        <!-- 3. Nachricht (optional) -->
        <div data-ps="src/components/home/ObjectInquiryForm.astro:field-message">
          <label for="direct-message" class="block text-sm font-bold text-[#133A6B] mb-1.5" data-ps="src/components/home/ObjectInquiryForm.astro:label-message">
            Nachricht <span class="text-gray-400 font-normal text-xs" data-ps="src/components/home/ObjectInquiryForm.astro:opt-message">(optional)</span>
          </label>
          <textarea 
            id="direct-message" 
            name="message" 
            rows="3" 
            placeholder="Ihre Nachricht oder Frage..." 
            class={`${inputClass} resize-none`}
            data-ps="src/components/home/ObjectInquiryForm.astro:input-message"
          ></textarea>
        </div>

        <!-- Fehlermeldung Inline -->
        <p id="direct-form-error" class="hidden text-sm font-semibold text-red-600 bg-red-50 border border-red-200 rounded-xl px-4 py-3" role="alert" data-ps="src/components/home/ObjectInquiryForm.astro:error-msg"></p>

        <!-- Submit Button -->
        <div class="pt-2" data-ps="src/components/home/ObjectInquiryForm.astro:submit-wrap">
          <button 
            type="submit" 
            class="w-full bg-[#25b94b] hover:bg-[#20a340] text-white text-base sm:text-lg font-extrabold px-6 py-4 rounded-xl shadow-lg hover:shadow-xl transition-all flex items-center justify-center gap-2 cursor-pointer active:scale-[0.99]"
            data-ps="src/components/home/ObjectInquiryForm.astro:submit-btn"
          >
            <span data-ps="src/components/home/ObjectInquiryForm.astro:btn-text">Rückmeldung erhalten &rarr;</span>
          </button>
          <p class="text-center text-xs text-gray-500 mt-3 font-medium" data-ps="src/components/home/ObjectInquiryForm.astro:disclaimer">
            Kostenlos & unverbindlich
          </p>
        </div>
      </form>

      <!-- Erfolgszustand nach Absenden -->
      <div id="direct-contact-success" class="hidden text-center py-8 px-2" data-ps="src/components/home/ObjectInquiryForm.astro:success">
        <div class="w-16 h-16 mx-auto rounded-full bg-[#8CC63F]/20 text-[#25b94b] flex items-center justify-center mb-4" data-ps="src/components/home/ObjectInquiryForm.astro:success-icon">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" class="w-8 h-8"><polyline points="20 6 9 17 4 12"/></svg>
        </div>
        <h3 class="text-2xl font-black text-[#133A6B] mb-2" data-ps="src/components/home/ObjectInquiryForm.astro:success-title">Vielen Dank für Ihre Nachricht!</h3>
        <p class="text-gray-600 text-sm sm:text-base max-w-md mx-auto mb-6 leading-relaxed" data-ps="src/components/home/ObjectInquiryForm.astro:success-desc">
          Wir haben Ihre Angaben erhalten und melden uns schnellstmöglich persönlich bei Ihnen.
        </p>
        <button type="button" id="direct-reset-btn" class="inline-flex items-center gap-2 bg-[#133A6B] text-white text-xs sm:text-sm font-bold px-5 py-2.5 rounded-xl hover:bg-[#0B3A64] transition-all" data-ps="src/components/home/ObjectInquiryForm.astro:reset-btn">
          <span data-ps="src/components/home/ObjectInquiryForm.astro:reset-text">Weitere Nachricht senden</span>
        </button>
      </div>

    </div>

    <!-- Separater Direkt-anrufen-Bereich darunter -->
    <div class="mt-8 text-center" data-ps="src/components/home/ObjectInquiryForm.astro:direct-call-box">
      <p class="text-sm font-bold text-[#53627D] mb-1.5" data-ps="src/components/home/ObjectInquiryForm.astro:call-heading">
        Oder lieber direkt anrufen?
      </p>
      <a 
        href="tel:+493092105026" 
        class="inline-flex items-center justify-center gap-2 text-[#25b94b] hover:text-[#20a340] text-xl sm:text-2xl font-black transition-colors no-underline group"
        data-ps="src/components/home/ObjectInquiryForm.astro:call-phone-link"
      >
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="w-5 h-5 sm:w-6 sm:h-6 group-hover:scale-110 transition-transform"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
        <span data-ps="src/components/home/ObjectInquiryForm.astro:call-phone-number">030 9210 5026</span>
      </a>
      <p class="text-xs text-gray-500 mt-1 font-medium" data-ps="src/components/home/ObjectInquiryForm.astro:call-hours">Montag - Freitag von 8.00 - 18.30 Uhr erreichbar</p>
    </div>

  </Container>
</section>

<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    const form = document.getElementById('direct-contact-form');
    const nameInput = document.getElementById('direct-name');
    const emailInput = document.getElementById('direct-email');
    const phoneInput = document.getElementById('direct-phone');
    const errorEl = document.getElementById('direct-form-error');
    const successEl = document.getElementById('direct-contact-success');
    const resetBtn = document.getElementById('direct-reset-btn');

    form?.addEventListener('submit', (e) => {
      e.preventDefault();
      if (errorEl) errorEl.classList.add('hidden');

      const nameVal = nameInput?.value.trim();
      if (!nameVal) {
        showError('Bitte geben Sie Ihren Namen an.');
        nameInput?.focus();
        return;
      }

      const emailVal = emailInput?.value.trim();
      if (!emailVal) {
        showError('Bitte geben Sie Ihre E-Mail-Adresse an.');
        emailInput?.focus();
        return;
      }

      // Success
      if (form) form.classList.add('hidden');
      if (successEl) successEl.classList.remove('hidden');
    });

    function showError(msg) {
      if (!errorEl) return;
      errorEl.textContent = msg;
      errorEl.classList.remove('hidden');
    }

    resetBtn?.addEventListener('click', () => {
      if (form) {
        form.reset();
        form.classList.remove('hidden');
      }
      if (successEl) successEl.classList.add('hidden');
      if (errorEl) errorEl.classList.add('hidden');
    });
  });
</script>
