---
interface Props {
  phoneNumber: string;
  phoneLabel?: string;
  enquiryLabel?: string;
  enquiryTarget?: string;
}

const { 
  phoneNumber, 
  phoneLabel = "Anrufen", 
  enquiryLabel = "Kosten-Check", 
  enquiryTarget = "#ersteinschaetzung" 
} = Astro.props;

// Clean phone number for tel: link
const telLink = phoneNumber.replace(/\s/g, '');
---

<div class="mobile-sticky-cta" data-ps="src/components/MobileStickyCTA.astro:main">
  <a 
    href={`tel:${telLink}`} 
    class="mobile-sticky-cta__button mobile-sticky-cta__button--phone"
    aria-label="Jetzt telefonisch Kontakt aufnehmen"
    data-ps="src/components/MobileStickyCTA.astro:phone-btn"
  >
    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="w-6 h-6" aria-hidden="true">
      <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/>
    </svg>
    <span data-ps="src/components/MobileStickyCTA.astro:kys42c">{phoneLabel}</span>
  </a>
  <a 
    href={enquiryTarget} 
    class="mobile-sticky-cta__button mobile-sticky-cta__button--enquiry"
    aria-label="Zum Kosten-Check"
    data-ps="src/components/MobileStickyCTA.astro:enquiry-btn"
  >
    <span data-ps="src/components/MobileStickyCTA.astro:kys42d">Kosten-Check</span>
    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="w-5 h-5" aria-hidden="true">
      <path d="M5 12h14"/><path d="m12 5 7 7-7 7"/>
    </svg>
  </a>
</div>

<style>
  .mobile-sticky-cta {
    position: fixed;
    inset-inline: 0;
    bottom: 0;
    z-index: 1000;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.5rem;
    padding: 0.5rem 0.75rem calc(0.5rem + env(safe-area-inset-bottom));
    background: rgba(255, 255, 255, 0.98);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    border-top: 1px solid rgba(10, 37, 69, 0.1);
    box-shadow: 0 -4px 20px rgba(7, 24, 45, 0.1);
  }

  .mobile-sticky-cta__button {
    min-width: 0;
    min-height: 50px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    border-radius: 12px;
    color: #fff;
    font-size: clamp(0.95rem, 4vw, 1.15rem);
    font-weight: 750;
    text-decoration: none;
    transition: transform 0.2s ease, opacity 0.2s ease;
  }

  .mobile-sticky-cta__button:active {
    transform: scale(0.97);
    opacity: 0.9;
  }

  .mobile-sticky-cta__button--phone {
    background-color: #1AAAE6; /* Matching existing Nav blue */
  }

  .mobile-sticky-cta__button--enquiry {
    background-color: #81CD35; /* Matching existing Hero/Form green */
  }

  @media (min-width: 769px) {
    .mobile-sticky-cta {
      display: none;
    }
  }
</style>
