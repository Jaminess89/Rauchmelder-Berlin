<script>
  function setupProtocolModal() {
    const openBtn = document.getElementById('open-protocol-modal-btn');
    const modal = document.getElementById('protocol-modal');
    const closeBtn = document.getElementById('close-protocol-modal-btn');
    const closeBtnBottom = document.getElementById('close-protocol-modal-btn-bottom');
    const pageBtns = document.querySelectorAll('.protocol-page-btn');
    const pagesContainer = document.getElementById('protocol-pages-container');

    if (!openBtn || !modal) return;

    function openModal() {
      modal.classList.remove('hidden');
      modal.classList.add('flex');
      setTimeout(() => {
        modal.classList.remove('opacity-0');
      }, 10);
      document.body.style.overflow = 'hidden';
    }

    function closeModal() {
      modal.classList.add('opacity-0');
      setTimeout(() => {
        modal.classList.remove('flex');
        modal.classList.add('hidden');
        document.body.style.overflow = '';
      }, 200);
    }

    openBtn.addEventListener('click', (e) => {
      e.preventDefault();
      openModal();
    });

    if (closeBtn) {
      closeBtn.addEventListener('click', closeModal);
    }
    if (closeBtnBottom) {
      closeBtnBottom.addEventListener('click', closeModal);
    }

    modal.addEventListener('click', (e) => {
      if (e.target === modal) {
        closeModal();
      }
    });

    // Disable context menu on the modal to prevent saving
    modal.addEventListener('contextmenu', (e) => {
      e.preventDefault();
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !modal.classList.contains('hidden')) {
        closeModal();
      }
    });

    // Page navigation buttons
    pageBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        const targetId = btn.getAttribute('data-target');
        const targetEl = document.getElementById(targetId);
        if (targetEl && pagesContainer) {
          pagesContainer.scrollTo({
            top: targetEl.offsetTop - pagesContainer.offsetTop,
            behavior: 'smooth'
          });
        }
        pageBtns.forEach(b => {
          b.classList.remove('bg-[#1AAAE6]', 'text-white');
          b.classList.add('text-slate-300');
        });
        btn.classList.remove('text-slate-300');
        btn.classList.add('bg-[#1AAAE6]', 'text-white');
      });
    });

    // Highlight active button on scroll
    if (pagesContainer) {
      pagesContainer.addEventListener('scroll', () => {
        const containerTop = pagesContainer.scrollTop;
        const pages = ['proto-page-1', 'proto-page-2', 'proto-page-3', 'proto-page-4'];
        
        pages.forEach((pageId, index) => {
          const el = document.getElementById(pageId);
          if (el) {
            const elTop = el.offsetTop - pagesContainer.offsetTop - 50;
            const elBottom = elTop + el.offsetHeight;
            if (containerTop >= elTop && containerTop < elBottom) {
              pageBtns.forEach((b, i) => {
                if (i === index) {
                  b.classList.remove('text-slate-300');
                  b.classList.add('bg-[#1AAAE6]', 'text-white');
                } else {
                  b.classList.remove('bg-[#1AAAE6]', 'text-white');
                  b.classList.add('text-slate-300');
                }
              });
            }
          }
        });
      });
    }
  }

  // Initial and view transition load
  document.addEventListener('DOMContentLoaded', setupProtocolModal);
  setupProtocolModal();
</script>

