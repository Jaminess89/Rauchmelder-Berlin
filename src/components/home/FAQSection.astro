---
import Container from '@/components/Container.astro';

const faqs = [
  {
    q: 'Prüfen Sie auch vorhandene Rauchmelder?',
    a: 'Ja. Vorhandene Geräte werden hinsichtlich Zustand, Position, Alter und erkennbarer Funktionsfähigkeit geprüft.',
  },
  {
    q: 'Müssen wir Bewohnertermine selbst koordinieren?',
    a: 'Auf Wunsch unterstützen wir bei der Abstimmung mit Bewohnern. Der genaue Leistungsumfang wird vorab vereinbart.',
  },
  {
    q: 'Ist Ferninspektion möglich?',
    a: 'Bei geeigneten Geräten und Objekten kann eine Ferninspektion angeboten werden. Vor-Ort-Termine können bei Störungen oder Gerätetausch weiterhin erforderlich sein.',
  },
  {
    q: 'Welche Dokumentation erhalten wir?',
    a: 'Sie erhalten eine übersichtliche Dokumentation der erfassten Geräte, festgestellten Mängel und durchgeführten Maßnahmen.',
  },
  {
    q: 'Arbeiten Sie auch in Altbauten?',
    a: 'Ja. Besondere Deckenhöhen, Stuck, Holzdecken und weitere bauliche Gegebenheiten werden bei der Planung berücksichtigt.',
  },
  {
    q: 'Was passiert bei einem defekten Melder?',
    a: 'Der Mangel wird dokumentiert. Nach Abstimmung kann das Gerät ersetzt oder eine passende Maßnahme empfohlen werden.',
  },
  {
    q: 'Wie oft muss geprüft werden?',
    a: 'Der Prüf- und Austauschzeitpunkt richtet sich unter anderem nach Gerät, Herstellerangaben, Wartungskonzept und den geltenden Anforderungen.',
  },
  {
    q: 'Wo sind Sie im Einsatz?',
    a: 'Wir betreuen Objekte in Berlin und ausgewählten Regionen im Umland.',
  },
];
---

<section class="py-14 md:py-20 bg-white" data-ps="src/components/home/FAQSection.astro:section">
  <Container>
    <h2 class="text-2xl md:text-4xl font-extrabold text-secondary text-center mb-10 md:mb-14 tracking-tight" data-ps="src/components/home/FAQSection.astro:title">Häufige Fragen</h2>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4 max-w-5xl mx-auto" data-ps="src/components/home/FAQSection.astro:grid">
      {faqs.map((f, i) => (
        <div class="faq-item bg-white rounded-xl border border-gray-200 shadow-sm overflow-hidden self-start">
          <button
            type="button"
            class="faq-trigger w-full flex items-center justify-between gap-4 px-5 py-4 text-left cursor-pointer focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#133A6B]"
            aria-expanded="false"
            aria-controls={`faq-panel-${i}`}
            id={`faq-trigger-${i}`}
          >
            <span class="text-[15px] font-bold text-[#133A6B]">{f.q}</span>
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="faq-icon w-5 h-5 shrink-0 text-[#4B9511] transition-transform duration-300" aria-hidden="true"><path d="M12 5v14M5 12h14"/></svg>
          </button>
          <div
            id={`faq-panel-${i}`}
            role="region"
            aria-labelledby={`faq-trigger-${i}`}
            class="faq-panel grid transition-[grid-template-rows] duration-300 ease-out [grid-template-rows:0fr]"
          >
            <div class="overflow-hidden">
              <p class="px-5 pb-5 text-sm text-gray-600 leading-relaxed">{f.a}</p>
            </div>
          </div>
        </div>
      ))}
    </div>
  </Container>
</section>

<script is:inline>
  document.querySelectorAll('.faq-trigger').forEach((trigger) => {
    trigger.addEventListener('click', () => {
      const item = trigger.closest('.faq-item');
      const panel = item?.querySelector('.faq-panel');
      const icon = trigger.querySelector('.faq-icon');
      const isOpen = trigger.getAttribute('aria-expanded') === 'true';

      trigger.setAttribute('aria-expanded', String(!isOpen));
      if (panel) {
        panel.style.gridTemplateRows = isOpen ? '0fr' : '1fr';
      }
      if (icon) {
        icon.style.transform = isOpen ? 'rotate(0deg)' : 'rotate(45deg)';
      }
    });
  });
</script>
