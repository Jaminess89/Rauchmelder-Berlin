---
import Container from '@/components/Container.astro';

const steps = [
  { title: 'Ausgangslage', text: 'Unterschiedliche Gerätestände und keine einheitliche Dokumentation.' },
  { title: 'Durchführung', text: 'Vorhandene Geräte geprüft, erkennbare Mängel erfasst und Maßnahmen dokumentiert.' },
  { title: 'Ergebnis', text: 'Klare Übersicht über bearbeitete Wohnungen, Maßnahmen und offene Punkte.' },
];

const stats = [
  { value: '24', label: 'Wohnungen geprüft' },
  { value: '2', label: 'Mängel behoben' },
  { value: '100 %', label: 'dokumentiert' },
  { value: '✓', label: 'Klare Übersicht' },
];
---

<section class="py-14 md:py-20 bg-white" data-ps="src/components/home/CaseStudy.astro:section">
  <Container>
    <div class="rounded-3xl bg-gradient-to-br from-[#0B3A64] to-[#14557A] px-6 py-10 md:px-12 md:py-14 shadow-lg" data-ps="src/components/home/CaseStudy.astro:block">
      <p class="text-[#8CC63F] font-bold text-xs tracking-widest uppercase mb-2" data-ps="src/components/home/CaseStudy.astro:badge">Beispielhafter Projektablauf</p>
      <h2 class="text-2xl md:text-4xl font-extrabold text-white mb-2 tracking-tight" data-ps="src/components/home/CaseStudy.astro:title">Beispiel aus der Praxis</h2>
      <p class="text-white/75 text-base md:text-lg mb-10" data-ps="src/components/home/CaseStudy.astro:subtitle">24 Wohnungen in Berlin geprüft und dokumentiert</p>

      <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 lg:gap-12 items-center mb-10" data-ps="src/components/home/CaseStudy.astro:grid">
        <div class="flex flex-col gap-5" data-ps="src/components/home/CaseStudy.astro:steps">
          {steps.map((s, i) => (
            <div class="flex items-start gap-4">
              <span class="shrink-0 w-9 h-9 rounded-full bg-[#8CC63F] text-white font-extrabold flex items-center justify-center">{i + 1}</span>
              <div>
                <h3 class="text-white font-bold text-base md:text-lg mb-1">{s.title}</h3>
                <p class="text-white/70 text-sm leading-relaxed">{s.text}</p>
              </div>
            </div>
          ))}
        </div>
        <div class="rounded-2xl overflow-hidden shadow-xl min-h-[220px]" data-ps="src/components/home/CaseStudy.astro:img-wrap">
          <img
            src="https://images.unsplash.com/photo-1560448204-e02f11c3d0e2?w=900&q=80&auto=format&fit=crop"
            alt="Modernes Berliner Mehrfamilienhaus"
            class="w-full h-full object-cover"
            loading="lazy"
          />
        </div>
      </div>

      <div class="grid grid-cols-2 md:grid-cols-4 gap-4" data-ps="src/components/home/CaseStudy.astro:stats">
        {stats.map((s) => (
          <div class="bg-white/10 rounded-xl px-4 py-5 text-center backdrop-blur-sm">
            <p class="text-2xl md:text-3xl font-black text-[#8CC63F] mb-1">{s.value}</p>
            <p class="text-white/80 text-[13px] font-semibold">{s.label}</p>
          </div>
        ))}
      </div>
      {/* TODO: Beispielwerte durch reale, belegbare Projektdaten ersetzen, sobald ein bestätigter Auftrag vorliegt. */}
    </div>
  </Container>
</section>
