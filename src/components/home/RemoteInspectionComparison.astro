---
import Container from '@/components/Container.astro';

const classic = [
  'Mehr Zutrittstermine notwendig',
  'Status nur zum Zeitpunkt der Prüfung',
  'Höherer organisatorischer Aufwand',
  'Weniger Transparenz zwischen Prüfterminen',
];

const remote = [
  'Weniger Zutrittstermine erforderlich',
  'Digitaler Gerätestatus einsehbar',
  'Geeignet für größere Bestände',
  'Übersichtliche Verwaltung',
];
---

<section class="py-14 md:py-20 bg-gradient-to-b from-[#0B3A64] to-[#14557A]" data-ps="src/components/home/RemoteInspectionComparison.astro:section">
  <Container>
    <h2 class="text-2xl md:text-4xl font-extrabold text-white text-center mb-3 tracking-tight" data-ps="src/components/home/RemoteInspectionComparison.astro:title">Ferninspektion: Weniger Vor-Ort-Termine, mehr Übersicht</h2>
    <p class="text-white/75 text-center text-base md:text-lg mb-10 md:mb-12" data-ps="src/components/home/RemoteInspectionComparison.astro:subtitle">Moderner Funkcheck macht die Verwaltung effizienter und planbarer.</p>

    <div class="relative grid grid-cols-1 md:grid-cols-2 gap-6 md:gap-14 max-w-4xl mx-auto" data-ps="src/components/home/RemoteInspectionComparison.astro:grid">
      <!-- VS Badge -->
      <div class="hidden md:flex absolute left-1/2 top-1/2 -translate-x-1/2 -translate-y-1/2 w-14 h-14 rounded-full bg-[#8CC63F] text-white font-black items-center justify-center text-lg z-10 shadow-lg border-4 border-[#0B3A64]" aria-hidden="true">VS.</div>

      <!-- Klassisch -->
      <div class="bg-white rounded-2xl p-6 md:p-8 shadow-lg" data-ps="src/components/home/RemoteInspectionComparison.astro:card-left">
        <h3 class="text-lg md:text-xl font-bold text-[#133A6B] mb-5">Klassische Vor-Ort-Prüfung</h3>
        <ul class="flex flex-col gap-3">
          {classic.map((item) => (
            <li class="flex items-start gap-3 text-sm text-gray-600">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="#9CA3AF" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" class="w-5 h-5 shrink-0 mt-0.5" aria-hidden="true"><path d="M18 6 6 18M6 6l12 12"/></svg>
              {item}
            </li>
          ))}
        </ul>
      </div>

      <!-- Funk -->
      <div class="bg-[#EAF6E2] rounded-2xl p-6 md:p-8 shadow-lg border border-[#8CC63F]/40" data-ps="src/components/home/RemoteInspectionComparison.astro:card-right">
        <h3 class="text-lg md:text-xl font-bold text-[#133A6B] mb-5">Funk-/Ferninspektion <span class="text-xs font-bold text-[#4B9511] uppercase tracking-wider align-middle ml-1">Auf Anfrage</span></h3>
        <ul class="flex flex-col gap-3">
          {remote.map((item) => (
            <li class="flex items-start gap-3 text-sm text-gray-700 font-medium">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="#4B9511" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="w-5 h-5 shrink-0 mt-0.5" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg>
              {item}
            </li>
          ))}
        </ul>
      </div>
    </div>

    <p class="text-white/70 text-center text-sm max-w-2xl mx-auto mt-8" data-ps="src/components/home/RemoteInspectionComparison.astro:note">Bei Störungen, Gerätetausch oder besonderen Auffälligkeiten kann weiterhin ein Vor-Ort-Termin erforderlich sein.</p>
  </Container>
</section>
