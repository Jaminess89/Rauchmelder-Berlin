---
import Container from '@/components/Container.astro';
---

<section class="relative py-10 md:py-14 md:pt-[32px] md:pb-[48px] scroll-mt-4 md:scroll-mt-6 overflow-hidden" id="ersteinschaetzung" data-ps="src/components/home/TransparentPricing.astro:section">
  <!-- Background Image with Light Translucent Tint -->
  <div class="absolute inset-0 z-0 pointer-events-none" data-ps="src/components/home/TransparentPricing.astro:lltjv1">
    <img
      src="https://pagesmith-cdn.com/2be62e80/images/Check-fur-Installation-Wartung-Anzahl-hintergrundclay-banks-FL-ZcDK8tMo-unsplash-640-640.webp"
      srcset="https://pagesmith-cdn.com/2be62e80/images/Check-fur-Installation-Wartung-Anzahl-hintergrundclay-banks-FL-ZcDK8tMo-unsplash-640-320.webp 320w, https://pagesmith-cdn.com/2be62e80/images/Check-fur-Installation-Wartung-Anzahl-hintergrundclay-banks-FL-ZcDK8tMo-unsplash-640-640.webp 640w"
      sizes="100vw"
      alt="Wohnung Innenraum"
      class="w-full h-full object-cover object-center"
      loading="lazy" data-ps="src/components/home/TransparentPricing.astro:89fes8" />
    <!-- Dark Translucent Overlay -->
    <div class="absolute inset-0 bg-[#062B4A]/80 backdrop-blur-[2px]" data-ps="src/components/home/TransparentPricing.astro:lltjv2"></div>
  </div>

  <Container class="relative z-10 max-w-[1740px]">
    <!-- Header -->
    <div class="flex flex-col items-center text-center px-4" data-ps="src/components/home/TransparentPricing.astro:header">
      <p class="text-[#49B90C] font-extrabold text-base sm:text-lg tracking-tight mb-2 md:mb-2.5 md:text-2xl" data-ps="src/components/home/TransparentPricing.astro:eyebrow">KOSTENLOS & UNVERBINDLICH</p>
      <h2 class="text-white font-[850] text-[30px] sm:text-[38px] md:text-[46px] lg:text-[54px] leading-[1.15] mb-2.5 max-w-4xl tracking-tight md:mb-10" data-ps="src/components/home/TransparentPricing.astro:title">
        Kosten-Check für Ihr Objekt
      </h2>
      

    </div>

    <!-- Funnel Container -->
    <div class="max-w-4xl mx-auto mb-12 md:mb-16 bg-white rounded-[24px] border border-[#DDE5EC] shadow-[0_10px_35px_rgba(11,38,65,0.08)] p-5 sm:p-7 md:p-9" data-ps="src/components/home/TransparentPricing.astro:cards-grid">

      <!-- Fortschrittsanzeige -->
      <div id="p-funnel-header-progress" class="mb-6 sm:mb-8" data-ps="src/components/home/TransparentPricing.astro:funnel-header">
        <div class="flex items-center justify-between text-xs sm:text-sm md:text-[15px] mb-2.5" data-ps="src/components/home/TransparentPricing.astro:uiflqh">
          <div class="flex items-center gap-1.5" data-ps="src/components/home/TransparentPricing.astro:uiflqi">
            <span id="p-funnel-step-label" class="font-bold text-[#062B4A]" data-ps="src/components/home/TransparentPricing.astro:l1560b">Schritt <span id="p-funnel-step-current" data-ps="src/components/home/TransparentPricing.astro:l1560a">1</span> von 5</span>
          </div>
          <span id="p-funnel-percent-text" class="font-bold text-[#36A90B] tracking-tight" data-ps="src/components/home/TransparentPricing.astro:l155zm">20 % · 4 kurze Schritte</span>
        </div>

        <!-- Progress Bar Track -->
        <div class="w-full bg-[#E9F0F6] h-[7px] rounded-full overflow-hidden" data-ps="src/components/home/TransparentPricing.astro:uiflr4">
          <div id="p-funnel-progress-bar" class="h-full bg-[#36A90B] rounded-full transition-all duration-300 ease-out" style="width: 20%;" data-ps="src/components/home/TransparentPricing.astro:uiflr5"></div>
        </div>
      </div>

      <!-- Funnel Form -->
      <form id="pricing-funnel-form" novalidate class="relative flex flex-col justify-between">
        
        <!-- SCHRITT 1: Was soll gemacht werden? -->
        <div class="p-funnel-step block" data-step="1" data-ps="src/components/home/TransparentPricing.astro:uiflr7">
          <div class="mb-5" data-ps="src/components/home/TransparentPricing.astro:uiflr8">
            <h3 class="text-xl sm:text-2xl font-black text-[#062B4A] mb-1.5 tracking-tight" data-ps="src/components/home/TransparentPricing.astro:xggzcr">
              Was möchten Sie einschätzen lassen?
            </h3>
            <p class="text-sm text-[#53627D]" data-ps="src/components/home/TransparentPricing.astro:2vutlx">Wählen Sie einfach aus, was am ehesten passt.</p>
          </div>

          <div class="grid grid-cols-1 gap-3 mb-2" data-ps="src/components/home/TransparentPricing.astro:uiflr9">
            <!-- Option 1: Prüfen -->
            <label class="p-funnel-card group relative flex items-center gap-3.5 p-4 sm:p-4.5 rounded-xl border-2 border-gray-200 bg-white hover:border-[#36A90B] hover:bg-[#36A90B]/5 hover:shadow-md cursor-pointer transition-all duration-200 has-checked:border-[#36A90B] has-checked:bg-[#36A90B]/10 has-checked:shadow-sm" data-ps="src/components/home/TransparentPricing.astro:3l8i88">
              <input type="radio" name="p_leistung" value="Vorhandene Rauchmelder prüfen" class="sr-only p-auto-advance" />
              <div class="w-10 h-10 rounded-lg bg-[#EEF6FD] group-hover:bg-[#36A90B]/20 text-[#1878B9] flex items-center justify-center shrink-0 transition-colors" data-ps="src/components/home/TransparentPricing.astro:uiflrc">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-5 h-5"><path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"/></svg>
              </div>
              <div class="flex-1 min-w-0 pr-4" data-ps="src/components/home/TransparentPricing.astro:uiflrd">
                <div class="font-bold text-[15px] sm:text-base text-[#062B4A]" data-ps="src/components/home/TransparentPricing.astro:uiflrz">Vorhandene Rauchmelder prüfen</div>
                <div class="text-xs sm:text-sm text-[#53627D] mt-0.5" data-ps="src/components/home/TransparentPricing.astro:uifls0">Wartung & digitale Dokumentation</div>
              </div>
              <div class="p-radio-indicator w-5 h-5 rounded-full border-2 border-gray-300 flex items-center justify-center shrink-0 transition-all ml-auto" data-ps="src/components/home/TransparentPricing.astro:uiflrf">
                <span class="w-2.5 h-2.5 rounded-full bg-[#36A90B] opacity-0 transition-opacity" data-ps="src/components/home/TransparentPricing.astro:l155za"></span>
              </div>
            </label>

            <!-- Option 2: Montieren oder austauschen -->
            <label class="p-funnel-card group relative flex items-center gap-3.5 p-4 sm:p-4.5 rounded-xl border-2 border-gray-200 bg-white hover:border-[#36A90B] hover:bg-[#36A90B]/5 hover:shadow-md cursor-pointer transition-all duration-200 has-checked:border-[#36A90B] has-checked:bg-[#36A90B]/10 has-checked:shadow-sm" data-ps="src/components/home/TransparentPricing.astro:3l8i89">
              <input type="radio" name="p_leistung" value="Rauchmelder montieren oder austauschen" class="sr-only p-auto-advance" />
              <div class="w-10 h-10 rounded-lg bg-[#EEF6FD] group-hover:bg-[#36A90B]/20 text-[#1878B9] flex items-center justify-center shrink-0 transition-colors" data-ps="src/components/home/TransparentPricing.astro:uifls2">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-5 h-5"><path d="m15 12-8.5 8.5c-.83.83-2.17.83-3 0 0 0 0 0 0 0a2.12 2.12 0 0 1 0-3L12 9"/><path d="M17.64 15 22 10.64"/><path d="m20.91 3.26-2.17-2.17a2.1 2.1 0 0 0-3 0L13.5 3.33a2.1 2.1 0 0 0 0 3l.84.84"/><path d="m4.9 19.1 1.4 1.4"/></svg>
              </div>
              <div class="flex-1 min-w-0 pr-4" data-ps="src/components/home/TransparentPricing.astro:uifls3">
                <div class="font-bold text-[15px] sm:text-base text-[#062B4A]" data-ps="src/components/home/TransparentPricing.astro:uifls4">Rauchmelder montieren oder austauschen</div>
                <div class="text-xs sm:text-sm text-[#53627D] mt-0.5" data-ps="src/components/home/TransparentPricing.astro:uifls5">Fehlende oder alte Geräte</div>
              </div>
              <div class="p-radio-indicator w-5 h-5 rounded-full border-2 border-gray-300 flex items-center justify-center shrink-0 transition-all ml-auto" data-ps="src/components/home/TransparentPricing.astro:uiflrg">
                <span class="w-2.5 h-2.5 rounded-full bg-[#36A90B] opacity-0 transition-opacity" data-ps="src/components/home/TransparentPricing.astro:l155zb"></span>
              </div>
            </label>

            <!-- Option 3: Nicht sicher -->
            <label class="p-funnel-card group relative flex items-center gap-3.5 p-4 sm:p-4.5 rounded-xl border-2 border-gray-200 bg-white hover:border-[#36A90B] hover:bg-[#36A90B]/5 hover:shadow-md cursor-pointer transition-all duration-200 has-checked:border-[#36A90B] has-checked:bg-[#36A90B]/10 has-checked:shadow-sm" data-ps="src/components/home/TransparentPricing.astro:3l8i8b">
              <input type="radio" name="p_leistung" value="Ich bin mir nicht sicher" class="sr-only p-auto-advance" />
              <div class="w-10 h-10 rounded-lg bg-[#EEF6FD] group-hover:bg-[#36A90B]/20 text-[#1878B9] flex items-center justify-center shrink-0 transition-colors" data-ps="src/components/home/TransparentPricing.astro:uiflsx">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-5 h-5"><circle cx="12" cy="12" r="10"/><path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
              </div>
              <div class="flex-1 min-w-0 pr-4" data-ps="src/components/home/TransparentPricing.astro:uiflsy">
                <div class="font-bold text-[15px] sm:text-base text-[#062B4A]" data-ps="src/components/home/TransparentPricing.astro:uiflsz">Ich bin mir nicht sicher</div>
                <div class="text-xs sm:text-sm text-[#53627D] mt-0.5" data-ps="src/components/home/TransparentPricing.astro:uiflt0">Wir prüfen, was bei Ihrem Objekt nötig ist</div>
              </div>
              <div class="p-radio-indicator w-5 h-5 rounded-full border-2 border-gray-300 flex items-center justify-center shrink-0 transition-all ml-auto" data-ps="src/components/home/TransparentPricing.astro:uiflrh">
                <span class="w-2.5 h-2.5 rounded-full bg-[#36A90B] opacity-0 transition-opacity" data-ps="src/components/home/TransparentPricing.astro:l155zc"></span>
              </div>
            </label>
          </div>
        </div>

        <!-- SCHRITT 2: Wohnungen -->
        <div class="p-funnel-step hidden" data-step="2" data-ps="src/components/home/TransparentPricing.astro:uiflt1">
          <div class="mb-5" data-ps="src/components/home/TransparentPricing.astro:uiflt2">
            <h3 class="text-xl sm:text-2xl font-black text-[#062B4A] mb-1.5 tracking-tight" data-ps="src/components/home/TransparentPricing.astro:xggzcs">
              Wie viele Wohnungen umfasst Ihr Objekt?
            </h3>
            <p class="text-sm text-[#53627D]" data-ps="src/components/home/TransparentPricing.astro:2vutly">Eine grobe Angabe reicht völlig aus.</p>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-3.5 mb-5" data-ps="src/components/home/TransparentPricing.astro:uiflt3">
            <label class="p-funnel-card group relative flex items-center gap-3.5 p-4 sm:p-4.5 rounded-xl border-2 border-gray-200 bg-white hover:border-[#36A90B] hover:bg-[#36A90B]/5 hover:shadow-md cursor-pointer transition-all duration-200 has-checked:border-[#36A90B] has-checked:bg-[#36A90B]/10 has-checked:shadow-sm" data-ps="src/components/home/TransparentPricing.astro:3l8i8c">
              <input type="radio" name="p_wohnungen" value="1 Wohnung" class="sr-only p-auto-advance" />
              <div class="w-10 h-10 rounded-lg bg-[#EEF6FD] group-hover:bg-[#36A90B]/20 text-[#1878B9] flex items-center justify-center shrink-0 transition-colors" data-ps="src/components/home/TransparentPricing.astro:uiflt2">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-5 h-5"><path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
              </div>
              <div class="flex-1 min-w-0 pr-4" data-ps="src/components/home/TransparentPricing.astro:uiflt3">
                <div class="font-bold text-[15px] sm:text-base text-[#062B4A]" data-ps="src/components/home/TransparentPricing.astro:uifltp">1 Wohnung</div>
              </div>
              <div class="p-radio-indicator w-5 h-5 rounded-full border-2 border-gray-300 flex items-center justify-center shrink-0 transition-all ml-auto" data-ps="src/components/home/TransparentPricing.astro:uifltq">
                <span class="w-2.5 h-2.5 rounded-full bg-[#36A90B] opacity-0 transition-opacity" data-ps="src/components/home/TransparentPricing.astro:l155zh"></span>
              </div>
            </label>

            <label class="p-funnel-card group relative flex items-center gap-3.5 p-4 sm:p-4.5 rounded-xl border-2 border-gray-200 bg-white hover:border-[#36A90B] hover:bg-[#36A90B]/5 hover:shadow-md cursor-pointer transition-all duration-200 has-checked:border-[#36A90B] has-checked:bg-[#36A90B]/10 has-checked:shadow-sm" data-ps="src/components/home/TransparentPricing.astro:3l8i8d">
              <input type="radio" name="p_wohnungen" value="2 - 10 Wohnungen" class="sr-only p-auto-advance" />
              <div class="w-10 h-10 rounded-lg bg-[#EEF6FD] group-hover:bg-[#36A90B]/20 text-[#1878B9] flex items-center justify-center shrink-0 transition-colors" data-ps="src/components/home/TransparentPricing.astro:uifltr">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-5 h-5"><rect width="16" height="20" x="4" y="2" rx="2" ry="2"/><path d="M9 22v-4h6v4"/><path d="M8 6h.01"/><path d="M16 6h.01"/></svg>
              </div>
              <div class="flex-1 min-w-0 pr-4" data-ps="src/components/home/TransparentPricing.astro:uiflts">
                <div class="font-bold text-[15px] sm:text-base text-[#062B4A]" data-ps="src/components/home/TransparentPricing.astro:uifltt">2 - 10 Wohnungen</div>
              </div>
              <div class="p-radio-indicator w-5 h-5 rounded-full border-2 border-gray-300 flex items-center justify-center shrink-0 transition-all ml-auto" data-ps="src/components/home/TransparentPricing.astro:uifltu">
                <span class="w-2.5 h-2.5 rounded-full bg-[#36A90B] opacity-0 transition-opacity" data-ps="src/components/home/TransparentPricing.astro:l155zg"></span>
              </div>
            </label>

            <label class="p-funnel-card group relative flex items-center gap-3.5 p-4 sm:p-4.5 rounded-xl border-2 border-gray-200 bg-white hover:border-[#36A90B] hover:bg-[#36A90B]/5 hover:shadow-md cursor-pointer transition-all duration-200 has-checked:border-[#36A90B] has-checked:bg-[#36A90B]/10 has-checked:shadow-sm" data-ps="src/components/home/TransparentPricing.astro:3l8i90">
              <input type="radio" name="p_wohnungen" value="Mehr als 10 Wohnungen" class="sr-only p-auto-advance" />
              <div class="w-10 h-10 rounded-lg bg-[#EEF6FD] group-hover:bg-[#36A90B]/20 text-[#1878B9] flex items-center justify-center shrink-0 transition-colors" data-ps="src/components/home/TransparentPricing.astro:uifluk">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-5 h-5"><rect width="20" height="14" x="2" y="7" rx="2" ry="2"/><path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"/></svg>
              </div>
              <div class="flex-1 min-w-0 pr-4" data-ps="src/components/home/TransparentPricing.astro:uiflul">
                <div class="font-bold text-[15px] sm:text-base text-[#062B4A]" data-ps="src/components/home/TransparentPricing.astro:uiflum">Mehr als 10 Wohnungen</div>
              </div>
              <div class="p-radio-indicator w-5 h-5 rounded-full border-2 border-gray-300 flex items-center justify-center shrink-0 transition-all ml-auto" data-ps="src/components/home/TransparentPricing.astro:uiflun">
                <span class="w-2.5 h-2.5 rounded-full bg-[#36A90B] opacity-0 transition-opacity" data-ps="src/components/home/TransparentPricing.astro:2ywthi"></span>
              </div>
            </label>

            <label class="p-funnel-card group relative flex items-center gap-3.5 p-4 sm:p-4.5 rounded-xl border-2 border-gray-200 bg-white hover:border-[#36A90B] hover:bg-[#36A90B]/5 hover:shadow-md cursor-pointer transition-all duration-200 has-checked:border-[#36A90B] has-checked:bg-[#36A90B]/10 has-checked:shadow-sm" data-ps="src/components/home/TransparentPricing.astro:3l8i91">
              <input type="radio" name="p_wohnungen" value="Weiß ich noch nicht genau" class="sr-only p-auto-advance" />
              <div class="w-10 h-10 rounded-lg bg-[#EEF6FD] group-hover:bg-[#36A90B]/20 text-[#1878B9] flex items-center justify-center shrink-0 transition-colors" data-ps="src/components/home/TransparentPricing.astro:uifluo">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-5 h-5"><circle cx="12" cy="12" r="10"/><path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
              </div>
              <div class="flex-1 min-w-0 pr-4" data-ps="src/components/home/TransparentPricing.astro:uiflup">
                <div class="font-bold text-[15px] sm:text-base text-[#062B4A]" data-ps="src/components/home/TransparentPricing.astro:uifluq">Weiß ich noch nicht genau</div>
              </div>
              <div class="p-radio-indicator w-5 h-5 rounded-full border-2 border-gray-300 flex items-center justify-center shrink-0 transition-all ml-auto" data-ps="src/components/home/TransparentPricing.astro:uiflur">
                <span class="w-2.5 h-2.5 rounded-full bg-[#36A90B] opacity-0 transition-opacity" data-ps="src/components/home/TransparentPricing.astro:2ywthh"></span>
              </div>
            </label>
          </div>

          <div class="flex items-center justify-between pt-3 border-t border-gray-100" data-ps="src/components/home/TransparentPricing.astro:step4-actions">
            <button type="button" class="p-btn-prev inline-flex items-center gap-1.5 text-gray-500 hover:text-[#062B4A] font-bold text-sm px-3.5 py-2 rounded-xl border border-gray-200 hover:border-gray-400 transition-all cursor-pointer" data-ps="src/components/home/TransparentPricing.astro:kcudiu-wohnungen">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="w-4 h-4"><path d="m15 18-6-6 6-6"/></svg>
              <span data-ps="src/components/home/TransparentPricing.astro:2ywtha-w">Zurück</span>
            </button>
          </div>
        </div>

        <!-- SCHRITT 3: Bauliche Besonderheiten -->
        <div class="p-funnel-step hidden" data-step="3" data-ps="src/components/home/TransparentPricing.astro:uiflwc">
          <div class="mb-5" data-ps="src/components/home/TransparentPricing.astro:uiflwd">
            <h3 class="text-xl sm:text-2xl font-black text-[#062B4A] mb-1.5 tracking-tight" data-ps="src/components/home/TransparentPricing.astro:xggzcu">
              Gibt es bauliche Besonderheiten?
            </h3>
            <p class="text-sm text-[#53627D]" data-ps="src/components/home/TransparentPricing.astro:2vutm0">Wählen Sie einfach aus, was am ehesten passt.</p>
          </div>

          <div class="grid grid-cols-1 gap-3 mb-5" data-ps="src/components/home/TransparentPricing.astro:uiflwe">
            <label class="p-funnel-card group relative flex items-center gap-3.5 p-4 sm:p-4.5 rounded-xl border-2 border-gray-200 bg-white hover:border-[#36A90B] hover:bg-[#36A90B]/5 hover:shadow-md cursor-pointer transition-all duration-200 has-checked:border-[#36A90B] has-checked:bg-[#36A90B]/10 has-checked:shadow-sm" data-ps="src/components/home/TransparentPricing.astro:3l8i97">
              <input type="radio" name="p_besonderheiten" value="Ja: Altbau, hohe Decken oder Stuck" class="sr-only p-auto-advance" />
              <div class="w-10 h-10 rounded-lg bg-[#EEF6FD] group-hover:bg-[#36A90B]/20 text-[#1878B9] flex items-center justify-center shrink-0 transition-colors" data-ps="src/components/home/TransparentPricing.astro:uiflri">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-5 h-5"><path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
              </div>
              <div class="flex-1 min-w-0 pr-4" data-ps="src/components/home/TransparentPricing.astro:2ywth9">
                <span class="font-bold text-[15px] sm:text-base text-[#062B4A]" data-ps="src/components/home/TransparentPricing.astro:3g5lb">Ja: Altbau, hohe Decken oder Stuck</span>
              </div>
              <div class="p-radio-indicator w-5 h-5 rounded-full border-2 border-gray-300 flex items-center justify-center shrink-0 transition-all ml-auto" data-ps="src/components/home/TransparentPricing.astro:uiflrj">
                <span class="w-2.5 h-2.5 rounded-full bg-[#36A90B] opacity-0 transition-opacity" data-ps="src/components/home/TransparentPricing.astro:l155zd"></span>
              </div>
            </label>

