---
interface Props {
  className?: string;
}

const { className = "" } = Astro.props;


---

<section id="nachweis" class="py-[60px] md:py-[100px] overflow-hidden bg-white md:pt-[45px] md:pb-[65px]" data-ps="src/components/home/DigitalProof.astro:section">
  <div class="w-full mx-auto px-0" data-ps="src/components/home/DigitalProof.astro:container-wrapper">
    <!-- Centered Header -->
    <div class="text-center mb-8 md:mb-12 px-5 md:px-8 max-w-[1500px] mx-auto" data-ps="src/components/home/DigitalProof.astro:header">
      <div class="flex flex-col items-center justify-center mb-4" data-ps="src/components/home/DigitalProof.astro:badge">
        <span class="text-[#4da92a] font-extrabold text-2xl sm:text-3xl md:text-[34px] tracking-tight leading-none mb-2" data-ps="src/components/home/DigitalProof.astro:label">Die Lösung:</span>
        <div class="h-1.5 w-36 sm:w-44 md:w-48 rounded-full bg-gradient-to-r from-[#4da92a] via-[#65ba3a] to-transparent" data-ps="src/components/home/DigitalProof.astro:line1"></div>
      </div>
      <h2 class="text-4xl md:text-[46px] font-extrabold tracking-[-0.04em] text-[#073f57] leading-tight" data-ps="src/components/home/DigitalProof.astro:title">Ihr digitaler Nachweis im Ernstfall</h2>
      <p class="max-w-[680px] mx-auto mt-4 text-[#183d68] text-base md:text-lg leading-relaxed font-normal" data-ps="src/components/home/DigitalProof.astro:2blysj">
        Wir montieren, prüfen und warten nach DIN 14676
        und dokumentieren jeden Schritt digital.
      </p>
    </div>

    <!-- Nebeneinander Layout (Side-by-side) -->
    <div class="flex flex-col lg:flex-row items-center lg:items-stretch justify-center gap-8 lg:gap-10 xl:gap-14 w-full max-w-[1340px] mx-auto px-5 md:px-8" data-ps="src/components/home/DigitalProof.astro:container">

      <!-- Laptopbild links -->
      <div class="w-full lg:flex-1 flex items-center justify-center" data-ps="src/components/home/DigitalProof.astro:image-wrapper">
        <div class="relative w-full max-w-[700px] lg:max-w-none aspect-[1024/633] drop-shadow-xl" data-ps="src/components/home/DigitalProof.astro:mockup-container">
          <!-- Screen content (SVG inside transparent screen) -->
          <div class="absolute left-[12.6%] top-[9.8%] w-[74.8%] h-[77.4%] overflow-hidden bg-white z-0" data-ps="src/components/home/DigitalProof.astro:screen-content">
            <svg viewBox="100 25 824 500" class="w-full h-full block" xmlns="http://www.w3.org/2000/svg">
              <rect x="100" y="25" width="824" height="500" fill="#fff"/>
              <!-- SCREEN UI -->
              <g transform="translate(151 50)">
                <g>
                  <path d="M35 2c8 7 15 8 26 9v20c0 17-11 27-26 34C20 58 10 48 10 31V11c11-1 18-2 25-9Z" fill="none" stroke="#153653" stroke-width="2.5"/>
                  <path d="m22 31 8 8 16-18" fill="none" stroke="#153653" stroke-width="3.2"/>
                  <text x="88" y="30" font-size="29" font-weight="700" fill="#13243a">Prüfprotokoll</text>
                  <text x="88" y="56" font-size="20" fill="#626974">Rauchwarnmelder</text>
                </g>
                <g transform="translate(520 10)">
                  <circle cx="26" cy="26" r="22.5" fill="none" stroke="#11ba20" stroke-width="3"/>
                  <path d="m15 26 8 8 15-18" fill="none" stroke="#11ba20" stroke-width="3"/>
                  <text x="66" y="19" font-size="16" fill="#13243a">Prüfung bestanden</text>
                  <text x="66" y="45" font-size="16" fill="#13243a">01.06.2025</text>
                </g>

                <g transform="translate(1 80)">
                  <rect width="725" height="300" rx="13" fill="#fff" stroke="#dfe2e5"/>
                  <path d="M0 77H725M0 150H725M0 223H725" stroke="#e5e8ea"/>
                  <g transform="translate(20 13)">
                    <rect width="66" height="53" rx="10" fill="#f4fbf5"/>
                    <g transform="translate(15 8)" stroke="#12b921" fill="none" stroke-width="2.1">
                      <path d="M5 34V4h18v30M0 34h33M10 10h4m5 0h-1m-8 7h4m5 0h-1m-8 7h4m5 0h-1m-8 10v-6h8v6M25 14h5v20"/>
                    </g>
                    <text x="96" y="21" font-size="18" font-weight="700" fill="#13243a">Objekt</text>
                    <text x="96" y="46" font-size="17" fill="#626974">Musterstraße 12, 10115 Berlin</text>
                  </g>
                  <g transform="translate(20 86)">
                    <rect width="66" height="53" rx="10" fill="#f4fbf5"/>
                    <g transform="translate(15 8)" stroke="#12b921" fill="none" stroke-width="2.1">
                      <rect x="1" y="5" width="31" height="29" rx="2"/>
                      <path d="M1 13h31M8 1v9m17-9v9M8 19h3m6 0h3m6 0h1m-19 7h3m6 0h3"/>
                    </g>
                    <text x="96" y="21" font-size="18" font-weight="700" fill="#13243a">Prüfdaten</text>
                    <text x="96" y="46" font-size="17" fill="#626974">01.06.2025  ·  Nächste Prüfung: 01.06.2026</text>
                  </g>
                  <g transform="translate(20 159)">
                    <rect width="66" height="53" rx="10" fill="#f4fbf5"/>
                    <g transform="translate(15 7)" stroke="#12b921" fill="none" stroke-width="2.1">
                      <ellipse cx="17" cy="17" rx="15" ry="12"/>
                      <circle cx="17" cy="17" r="5"/>
                      <path d="M8 34h18M11 30h12"/>
                    </g>
                    <text x="96" y="21" font-size="18" font-weight="700" fill="#13243a">Geräte</text>
                    <text x="96" y="46" font-size="17" fill="#626974">34 geprüfte Rauchwarnmelder</text>
                  </g>
                  <g transform="translate(20 232)">
                    <rect width="66" height="53" rx="10" fill="#f4fbf5"/>
                    <g transform="translate(15 8)" stroke="#12b921" fill="none" stroke-width="2.1">
                      <circle cx="17" cy="17" r="15"/>
                      <path d="m10 18 5 5 10-12"/>
                    </g>
                    <text x="96" y="21" font-size="18" font-weight="700" fill="#13243a">Status</text>
                    <text x="96" y="46" font-size="17" fill="#626974">Alle Geräte in Ordnung</text>
                  </g>
                </g>

                <g transform="translate(34 399)">
                  <text x="0" y="21" font-size="17" font-weight="700" fill="#13243a">Geprüft von</text>
                  <text x="0" y="46" font-size="17" fill="#626974">Max Mustermann</text>
                  <path d="M269 32c35-47 53-52 45-23-5 18-25 40-3 20 18-17 32-31 27-13-5 15-19 28-4 17 15-12 29-25 26-11-3 10-11 19-2 14 9-5 15-10 18-6 5 7 18 3 31 2 10 0 24 4 44 1" fill="none" stroke="#07508d" stroke-width="3" stroke-linecap="round"/>
                  <g transform="translate(578 -52) rotate(-7 51 51)">
                    <circle cx="51" cy="51" r="47" fill="#fff" stroke="#29465f" stroke-width="2.5"/>
                    <circle cx="51" cy="51" r="40" fill="none" stroke="#9eabb7" stroke-width="1.1"/>
                    <text x="51" y="24" font-size="10.4" text-anchor="middle" font-weight="800" fill="#29465f" letter-spacing="1.35">GEPRÜFT</text>
                    <path d="M24 31H78" stroke="#c2cad1" stroke-width="1"/>
                    <circle cx="18" cy="51" r="2" fill="#29465f"/>
                    <circle cx="84" cy="51" r="2" fill="#29465f"/>
                    <circle cx="51" cy="51" r="18.5" fill="#f8fafc" stroke="#29465f" stroke-width="1.9"/>
                    <path d="m40.5 51 7.5 7.5 14.5-18" fill="none" stroke="#123f66" stroke-width="5.2" stroke-linecap="round" stroke-linejoin="round"/>
                    <path d="M20 70H82" stroke="#c2cad1" stroke-width="1"/>
                    <text x="51" y="83" font-size="8.2" text-anchor="middle" font-weight="800" fill="#29465f" letter-spacing=".7">FACHBETRIEB</text>
                  </g>
                </g>
              </g>
            </svg>
          </div>
          <!-- Laptop frame overlay -->
          <img 
            src="https://pagesmith-cdn.com/2be62e80/images/Digitales-Prufprotokoll-auf-Laptop-Rahmen-1024.webp"
            sizes="(max-width: 1024px) 100vw, 60vw"
            alt="Digitales Prüfprotokoll auf Laptop" 
            class="absolute inset-0 z-10 w-full h-full object-contain pointer-events-none"
            data-ps="src/components/home/DigitalProof.astro:laptop-image"
            loading="lazy"
          />
        </div>
      </div>

      <!-- Feature Card rechts -->
      <div class="w-full lg:w-[480px] xl:w-[500px] shrink-0 bg-white rounded-[22px] md:rounded-[26px] p-6 sm:p-8 md:p-9 shadow-[0_12px_38px_rgba(7,36,72,0.07)] border border-slate-100 flex flex-col justify-between" data-ps="src/components/home/DigitalProof.astro:content">
        
        <h3 class="text-2xl sm:text-[26px] md:text-[27px] font-extrabold text-[#072448] tracking-tight mb-6" data-ps="src/components/home/DigitalProof.astro:card-title">Enthalten ist:</h3>

        <div class="space-y-5" data-ps="src/components/home/DigitalProof.astro:card-items">
          <!-- Item 1 -->
          <div class="flex items-start gap-3.5 sm:gap-4" data-ps="src/components/home/DigitalProof.astro:item-1">
            <div class="w-7 h-7 sm:w-8 sm:h-8 rounded-full bg-[#ebf7eb] text-[#36b342] flex items-center justify-center shrink-0 mt-0.5" data-ps="src/components/home/DigitalProof.astro:check-1">
              <svg class="w-4 h-4 sm:w-5 sm:h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="20 6 9 17 4 12"></polyline>
              </svg>
            </div>
            <div data-ps="src/components/home/DigitalProof.astro:hv8hpo">
              <h4 class="text-[16px] sm:text-[17px] font-extrabold text-[#072448] leading-tight mb-1" data-ps="src/components/home/DigitalProof.astro:item-1-title">Klare Zuordnung</h4>
              <p class="text-[14px] sm:text-[14.5px] text-[#596980] leading-relaxed font-normal m-0" data-ps="src/components/home/DigitalProof.astro:item-1-desc">Objekt, Wohnung und Geräte sauber erfasst.</p>
            </div>
          </div>

          <!-- Item 2 -->
          <div class="flex items-start gap-3.5 sm:gap-4" data-ps="src/components/home/DigitalProof.astro:item-2">
            <div class="w-7 h-7 sm:w-8 sm:h-8 rounded-full bg-[#ebf7eb] text-[#36b342] flex items-center justify-center shrink-0 mt-0.5" data-ps="src/components/home/DigitalProof.astro:check-2">
              <svg class="w-4 h-4 sm:w-5 sm:h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="20 6 9 17 4 12"></polyline>
              </svg>
            </div>
            <div data-ps="src/components/home/DigitalProof.astro:hv8hpn">
              <h4 class="text-[16px] sm:text-[17px] font-extrabold text-[#072448] leading-tight mb-1" data-ps="src/components/home/DigitalProof.astro:item-2-title">Dokumentierte Ergebnisse</h4>
              <p class="text-[14px] sm:text-[14.5px] text-[#596980] leading-relaxed font-normal m-0" data-ps="src/components/home/DigitalProof.astro:item-2-desc">Mängel und Maßnahmen nachvollziehbar festgehalten.</p>
            </div>
          </div>

          <!-- Item 3 -->
          <div class="flex items-start gap-3.5 sm:gap-4" data-ps="src/components/home/DigitalProof.astro:item-3">
            <div class="w-7 h-7 sm:w-8 sm:h-8 rounded-full bg-[#ebf7eb] text-[#36b342] flex items-center justify-center shrink-0 mt-0.5" data-ps="src/components/home/DigitalProof.astro:check-3">
              <svg class="w-4 h-4 sm:w-5 sm:h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="20 6 9 17 4 12"></polyline>
              </svg>
            </div>
            <div data-ps="src/components/home/DigitalProof.astro:hv8hpm">
              <h4 class="text-[16px] sm:text-[17px] font-extrabold text-[#072448] leading-tight mb-1" data-ps="src/components/home/DigitalProof.astro:item-3-title">Nächste Schritte</h4>
              <p class="text-[14px] sm:text-[14.5px] text-[#596980] leading-relaxed font-normal m-0" data-ps="src/components/home/DigitalProof.astro:item-3-desc">Empfehlungen, Fristen und Austauschzeitpunkte direkt ersichtlich.</p>
            </div>
          </div>
        </div>

        <!-- Note banner -->
        <div class="bg-[#f3faf1] border border-[#d6eed4] rounded-[12px] p-3.5 sm:p-4 flex items-center gap-3 my-6" data-ps="src/components/home/DigitalProof.astro:note-banner">
          <div class="shrink-0 text-[#36b342]" data-ps="src/components/home/DigitalProof.astro:shield-icon">
            <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
              <polyline points="9 12 11 14 15 10"/>
            </svg>
          </div>
          <p class="text-[#20752a] font-semibold text-[13.5px] sm:text-[14px] leading-snug m-0" data-ps="src/components/home/DigitalProof.astro:note-text">
            Im Ernstfall können Sie zeigen, was wann geprüft wurde.
          </p>
        </div>

        <!-- Button -->
        <button 
          type="button"
          id="open-protocol-modal-btn"
          class="w-full bg-[#072448] hover:bg-[#051a34] text-white font-bold text-base sm:text-[16.5px] py-3.5 px-6 rounded-[12px] flex items-center justify-center gap-2.5 transition-all shadow-[0_4px_14px_rgba(7,36,72,0.18)] hover:shadow-[0_6px_20px_rgba(7,36,72,0.25)] hover:-translate-y-0.5 cursor-pointer"
          data-ps="src/components/home/DigitalProof.astro:cta-button"
        >
          <span data-ps="src/components/home/DigitalProof.astro:3wuvgj">Musterprotokoll ansehen</span>
          <span class="text-lg leading-none font-bold" aria-hidden="true" data-ps="src/components/home/DigitalProof.astro:3wuvgl">→</span>
        </button>

      </div>

    </div>

    <!-- 3-Step Process Steps -->
    <div class="proof__steps mt-12 md:mt-16 px-5 md:px-8 max-w-[850px] mx-auto" data-ps="src/components/home/SolutionProcess.astro:wi8a9r">

      <!-- STEP 1 -->
      <div class="step" data-ps="src/components/home/SolutionProcess.astro:wi8a9s">
        <div class="step__number" data-ps="src/components/home/SolutionProcess.astro:wi8a9t">1</div>
        <div class="step__icon smoke-icon" data-ps="src/components/home/SolutionProcess.astro:jdndlz">
          <!-- NEUER RAUCHMELDER -->
          <svg viewBox="0 0 120 120" aria-hidden="true">
            <path
              d="
              M23 53
              C23 41 39 32 60 32
              C81 32 97 41 97 53
              V65
              C97 77 81 86 60 86
              C39 86 23 77 23 65
              Z
              "
            />
            <ellipse cx="60" cy="53" rx="37" ry="21" />
            <ellipse cx="60" cy="62" rx="24" ry="13" />
            <path d="M36 62 V68 C36 76 47 81 60 81 C73 81 84 76 84 68 V62" />
            <path d="M35 49l9 4"/>
            <path d="M76 53l9-4"/>
            <circle class="led" cx="76" cy="55" r="3" />
          </svg>
        </div>
        <h3 data-ps="src/components/home/SolutionProcess.astro:1b26k1">Montage</h3>
        <p data-ps="src/components/home/SolutionProcess.astro:2blysi">Nach DIN 14676</p>
      </div>

      <div class="step-arrow" data-ps="src/components/home/SolutionProcess.astro:jdndm0">→</div>

      <!-- STEP 2 -->
      <div class="step" data-ps="src/components/home/SolutionProcess.astro:jdndm1">
        <div class="step__number" data-ps="src/components/home/SolutionProcess.astro:jdndm2">2</div>
        <div class="step__icon" data-ps="src/components/home/SolutionProcess.astro:jdndm3">
          <svg viewBox="0 0 120 120" aria-hidden="true">
            <rect x="32" y="26" width="56" height="72" rx="6" />
            <rect x="47" y="18" width="26" height="14" rx="4" />
            <path class="green" d="M43 49l6 6 10-13" />
            <path d="M67 51h12"/>
            <path class="green" d="M43 66l6 6 10-13" />
            <path d="M67 68h12"/>
            <path class="green" d="M43 83l6 6 10-13" />
            <path d="M67 85h12"/>
          </svg>
        </div>
        <h3 data-ps="src/components/home/SolutionProcess.astro:1b26k2">Dokumentation</h3>
        <p data-ps="src/components/home/SolutionProcess.astro:2blysh">Digital erfasst</p>
      </div>

      <div class="step-arrow" data-ps="src/components/home/SolutionProcess.astro:jdndm4">→</div>

      <!-- STEP 3 -->
      <div class="step" data-ps="src/components/home/SolutionProcess.astro:jdndm5">
        <div class="step__number" data-ps="src/components/home/SolutionProcess.astro:jdndm6">3</div>
        <div class="step__icon" data-ps="src/components/home/SolutionProcess.astro:jdndm7">
          <svg viewBox="0 0 120 120" aria-hidden="true">
            <path
              d="
              M60 15
              L90 28
              V51
              C90 74 77 91 60 101
              C43 91 30 74 30 51
              V28
              Z
              "
            />
            <path class="green shield-check" d="M45 58l10 10 21-26" />
          </svg>
        </div>
        <h3 data-ps="src/components/home/SolutionProcess.astro:1b26k3">Rechtssicherheit</h3>
        <p data-ps="src/components/home/SolutionProcess.astro:2blysg">Schnell vorzeigbar</p>
      </div>

    </div>

    <div class="proof__note px-5 md:px-8 max-w-[720px] mx-auto text-center mt-6" data-ps="src/components/home/SolutionProcess.astro:jdndm8">
      <small class="text-[#718090] font-normal text-xs md:text-[13px] leading-relaxed">
        Rechtliche Folgen richten sich nach dem jeweiligen Einzelfall.
      </small>
    </div>
  </div>
</section>

<!-- Musterprotokoll Popup Modal (Geschützte Vollansicht aller 4 Seiten) -->
<div 
  id="protocol-modal" 
  class="fixed inset-0 z-[100] bg-black/80 backdrop-blur-sm hidden items-center justify-center p-2 sm:p-4 md:p-6 select-none opacity-0 transition-opacity duration-200"
  role="dialog"
  aria-modal="true"
  aria-labelledby="protocol-modal-title"
 data-ps="src/components/home/DigitalProof.astro:inkfdc">
  <div class="relative bg-slate-900 text-slate-800 rounded-2xl w-full max-w-4xl max-h-[94vh] flex flex-col shadow-2xl overflow-hidden border border-slate-700" data-ps="src/components/home/DigitalProof.astro:inkfdd">
    
    <!-- Modal Header Toolbar -->
    <div class="flex flex-wrap items-center justify-between gap-3 px-4 sm:px-6 py-3.5 bg-slate-800 border-b border-slate-700 text-white shrink-0" data-ps="src/components/home/DigitalProof.astro:inkfde">
      <div class="flex items-center gap-3" data-ps="src/components/home/DigitalProof.astro:inkfdf">
        <div class="w-8 h-8 rounded-lg bg-[#1AAAE6]/20 text-[#1AAAE6] flex items-center justify-center font-bold" data-ps="src/components/home/DigitalProof.astro:inkfdg">
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline><line x1="16" y1="13" x2="8" y2="13"></line><line x1="16" y1="17" x2="8" y2="17"></line><polyline points="10 9 9 9 8 9"></polyline></svg>
        </div>
        <div data-ps="src/components/home/DigitalProof.astro:inkfdh">
          <h3 id="protocol-modal-title" class="text-sm sm:text-base font-bold text-white leading-tight" data-ps="src/components/home/DigitalProof.astro:39zrz4">Muster-Prüfprotokoll</h3>
          <p class="text-[11px] sm:text-xs text-slate-400" data-ps="src/components/home/DigitalProof.astro:skpiel">DIN 14676 · 4 Seiten · Nur Leseansicht</p>
        </div>
      </div>

      <!-- Quick Page Navigation Tabs -->
      <div class="flex items-center gap-1 sm:gap-1.5 bg-slate-900/80 p-1 rounded-lg border border-slate-700/60 text-xs" data-ps="src/components/home/DigitalProof.astro:inkfdi">
        <button type="button" class="protocol-page-btn px-2.5 py-1 rounded font-medium transition-colors bg-[#1AAAE6] text-white" data-target="proto-page-1" data-ps="src/components/home/DigitalProof.astro:5cn3j5">Seite 1</button>
        <button type="button" class="protocol-page-btn px-2.5 py-1 rounded font-medium transition-colors text-slate-300 hover:text-white hover:bg-slate-700/60" data-target="proto-page-2" data-ps="src/components/home/DigitalProof.astro:5cn3j4">Seite 2</button>
        <button type="button" class="protocol-page-btn px-2.5 py-1 rounded font-medium transition-colors text-slate-300 hover:text-white hover:bg-slate-700/60" data-target="proto-page-3" data-ps="src/components/home/DigitalProof.astro:5cn3j3">Seite 3</button>
        <button type="button" class="protocol-page-btn px-2.5 py-1 rounded font-medium transition-colors text-slate-300 hover:text-white hover:bg-slate-700/60" data-target="proto-page-4" data-ps="src/components/home/DigitalProof.astro:5cn3ih">Seite 4</button>
      </div>

      <!-- Close Button -->
      <div class="flex items-center gap-2" data-ps="src/components/home/DigitalProof.astro:inkfdj">
        <button 
          type="button" 
          id="close-protocol-modal-btn"
          class="w-8 h-8 sm:w-9 sm:h-9 rounded-lg bg-slate-700/80 hover:bg-slate-600 text-slate-300 hover:text-white flex items-center justify-center transition-colors cursor-pointer"
          aria-label="Protokoll schließen"
         data-ps="src/components/home/DigitalProof.astro:5cn3ig">
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
        </button>
      </div>
    </div>

    <!-- Scrollable Document View (All 4 Pages) -->
    <div id="protocol-pages-container" class="overflow-y-auto p-3 sm:p-6 md:p-8 space-y-8 bg-slate-950/70 select-none scroll-smooth" data-ps="src/components/home/DigitalProof.astro:inkfe5">
      
      <!-- PAGE 1 -->
